# RISCitry: RV32E soft core (Lucid, Alchitry Cu). Memory map: tools/memmap.py.

config SOC_RISCITRY
	bool
	select RISCV
	select RISCV_ISA_RV32E
	select RISCV_ISA_EXT_ZICSR
	select RISCV_PRIVILEGED
	select INCLUDE_RESET_VECTOR
	help
	  RV32E, machine mode only, no M/A/C extensions, no PLIC.

config SOC
	default "riscitry" if SOC_RISCITRY
