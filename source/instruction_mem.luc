module instruction_mem (
    input pc[32],          // Explicit 32-bit width array input
    output instruction[32] // Explicit 32-bit width array output
  ) {

  sig word_addr[14];       // Explicit 14-bit width array stops truncation flags!

  always {
    // Drop the bottom 2 bits to enforce standard word alignment
    word_addr = pc[15:2]; 

    case (word_addr) {
      // === BOOT: jump straight to the turnaround ===
      14h0000: instruction = 32h07C0006F; // 0x00: jal  x0, +0x7C    (x1 stays 0 until 0x7C)

      // 0x04-0x44 unused (default NOP, never reached)

      // === WALKING RIGHT (7 shifts: LED 7 -> 6 -> 5 -> 4 -> 3 -> 2 -> 1 -> 0) ===
      14h0012: instruction = 32h0010D093; // 0x48: srli x1, x1, 1
      14h0013: instruction = 32h0010D093; // 0x4C: srli x1, x1, 1
      14h0014: instruction = 32h0010D093; // 0x50: srli x1, x1, 1
      14h0015: instruction = 32h0010D093; // 0x54: srli x1, x1, 1
      14h0016: instruction = 32h0010D093; // 0x58: srli x1, x1, 1
      14h0017: instruction = 32h0010D093; // 0x5C: srli x1, x1, 1
      14h0018: instruction = 32h0010D093; // 0x60: srli x1, x1, 1

      // === WALKING LEFT (6 shifts: LED 0 -> 1 -> 2 -> 3 -> 4 -> 5 -> 6) ===
      14h0019: instruction = 32h00109093; // 0x64: slli x1, x1, 1
      14h001A: instruction = 32h00109093; // 0x68: slli x1, x1, 1
      14h001B: instruction = 32h00109093; // 0x6C: slli x1, x1, 1
      14h001C: instruction = 32h00109093; // 0x70: slli x1, x1, 1
      14h001D: instruction = 32h00109093; // 0x74: slli x1, x1, 1
      14h001E: instruction = 32h00109093; // 0x78: slli x1, x1, 1

      // === TURNAROUND: the jump is itself a display step ===
      // jal links x1 = pc + 4 = 0x80, which lights LED 7, then jumps back to 0x48.
      // Each LED position therefore lasts exactly one instruction, with no double beat at either end.
      14h001F: instruction = 32hFCDFF0EF; // 0x7C: jal  x1, -0x34   (x1 = 0x80, pc -> 0x48)

      default: instruction = 32h00000013; // Safe fallback NOP
    }
  }
}
