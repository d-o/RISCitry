// GENERATED by tools/gen_mem_align_tb.py. Do not edit; rerun the script.
// Every load and store width at every byte offset (misaligned offsets use the aligned
// halfword/word, which is mem_align's documented behaviour).
testbench mem_align_tb {
    sig in_f3[3]
    sig in_addr[2]
    sig in_store[32]
    sig in_word[32]

    mem_align dut(.funct3(in_f3), .addr_low(in_addr), .store_data(in_store), .load_word(in_word))

    fun check_load(f3[3], addr[2], word[32], expected[32]) {
        in_f3 = f3
        in_addr = addr
        in_word = word
        $tick()
        if (dut.load_data != expected)
            $print("load f3=%b addr=%d word=%h: got %h want %h", f3, addr, word, dut.load_data, expected)
        $assert(dut.load_data == expected)
    }

    fun check_store(f3[3], addr[2], data[32], wdata[32], enable[4]) {
        in_f3 = f3
        in_addr = addr
        in_store = data
        $tick()
        if (dut.write_data != wdata || dut.byte_enable != enable)
            $print("store f3=%b addr=%d data=%h: got %h/%b want %h/%b", f3, addr, data, dut.write_data, dut.byte_enable, wdata, enable)
        $assert(dut.write_data == wdata)
        $assert(dut.byte_enable == enable)
    }

    test loads {
        in_f3 = 0
        in_addr = 0
        in_store = 0
        in_word = 0
        $check_load(3b000, 2d0, 32h80817F01, 32h00000001) // lb +0
        $check_load(3b000, 2d1, 32h80817F01, 32h0000007F) // lb +1
        $check_load(3b000, 2d2, 32h80817F01, 32hFFFFFF81) // lb +2
        $check_load(3b000, 2d3, 32h80817F01, 32hFFFFFF80) // lb +3
        $check_load(3b000, 2d0, 32h7F80FF00, 32h00000000) // lb +0
        $check_load(3b000, 2d1, 32h7F80FF00, 32hFFFFFFFF) // lb +1
        $check_load(3b000, 2d2, 32h7F80FF00, 32hFFFFFF80) // lb +2
        $check_load(3b000, 2d3, 32h7F80FF00, 32h0000007F) // lb +3
        $check_load(3b000, 2d0, 32h12345678, 32h00000078) // lb +0
        $check_load(3b000, 2d1, 32h12345678, 32h00000056) // lb +1
        $check_load(3b000, 2d2, 32h12345678, 32h00000034) // lb +2
        $check_load(3b000, 2d3, 32h12345678, 32h00000012) // lb +3
        $check_load(3b000, 2d0, 32hFFFFFFFF, 32hFFFFFFFF) // lb +0
        $check_load(3b000, 2d1, 32hFFFFFFFF, 32hFFFFFFFF) // lb +1
        $check_load(3b000, 2d2, 32hFFFFFFFF, 32hFFFFFFFF) // lb +2
        $check_load(3b000, 2d3, 32hFFFFFFFF, 32hFFFFFFFF) // lb +3
        $check_load(3b000, 2d0, 32h00000000, 32h00000000) // lb +0
        $check_load(3b000, 2d1, 32h00000000, 32h00000000) // lb +1
        $check_load(3b000, 2d2, 32h00000000, 32h00000000) // lb +2
        $check_load(3b000, 2d3, 32h00000000, 32h00000000) // lb +3
        $check_load(3b001, 2d0, 32h80817F01, 32h00007F01) // lh +0
        $check_load(3b001, 2d1, 32h80817F01, 32h00007F01) // lh +1
        $check_load(3b001, 2d2, 32h80817F01, 32hFFFF8081) // lh +2
