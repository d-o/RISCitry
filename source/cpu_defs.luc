// Types shared between decoder, control_unit and the datapath.
// tools/gen_decoder_tb.py mirrors the enum values and the control bit layout; change both together.
global Cpu {
    // Which immediate format the instruction uses (imm_gen)
    enum ImmType { I, S, B, U, J }
    const IMM_TYPE_BITS = $width(ImmType)   // for ports: $width(Cpu.ImmType) doesn't resolve in a port list

    // What gets written to rd
    enum WbSel { ALU, MEM, PC4, IMM }

    // Decoder output. $flatten() puts the FIRST field in the LOWEST bits, so fields are
    // listed least-significant first; flattened layout:
    //   [17:14] alu_op  [13] alu_src_a  [12] alu_src_b  [11:9] imm_type  [8:7] wb_sel
    //   [6] reg_write  [5] mem_read  [4] mem_write  [3] branch  [2] jump  [1] jalr  [0] illegal
    struct control {
        illegal,                   // not a valid RV32E instruction; all side effects are forced off
        jalr,                      // JALR: pc = (rs1 + imm) & ~1
        jump,                      // JAL: pc = pc + imm
        branch,                    // conditional branch; condition is funct3
        mem_write,
        mem_read,
        reg_write,
        wb_sel[$width(WbSel)],
        imm_type[$width(ImmType)],
        alu_src_b,                 // 0 = rs2, 1 = immediate
        alu_src_a,                 // 0 = rs1, 1 = pc (AUIPC)
        alu_op[4]                  // alu.luc encoding: {funct7[5], funct3}
    }
}
