module program_counter (
    input clk,                  // Clock signal
    input rst,                  // Reset signal
    input pc_write,             // 1 = update PC, 0 = stall PC
    input pc_src[2],            // 00 = PC+4, 01 = Branch/JAL target, 10 = JALR target
    input target_address[32],   // Address from ALU/Immediate generator
    output pc[32]               // Current PC out to Instruction Memory
  ) {

  // Create a 32-bit D Flip-Flop register clocked by clk and reset by rst
  // It automatically initializes to 0 on reset
  dff pc_reg[32](#INIT(0), .clk(clk), .rst(rst)); 
  
  sig next_pc[32];              // Combinational signal for the mux output

  always {
    // 1. Output the current register value to the Instruction Memory
    pc = pc_reg.q;

    // 2. The Multiplexer logic (using a case statement)
    case (pc_src) {
      2b00: next_pc = pc_reg.q + 4;                             // Normal execution
      2b01: next_pc = target_address;                           // JAL or taken Branch
      2b10: next_pc = target_address & 32hFFFFFFFE;             // JALR (spec requires clearing LSB)
      default: next_pc = pc_reg.q + 4;
    }

    // 3. Register input logic
    if (pc_write) {
      pc_reg.d = next_pc;       // Feed the selected address into the flip-flop
    } else {
      pc_reg.d = pc_reg.q;      // Hold current value (stall)
    }
  }
}
