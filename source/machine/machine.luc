// The computer (cpu + memory) plus the clock and reset sequencer that a front panel drives: run,
// run fast, or stop and single-step, either one whole instruction or one cpu clock at a time.
//
// The cpu still runs on a clock derived from clk (cpu_clk, a flip-flop, so glitch-free), not on clk
// with a clock enable: the core's fmax (37-60 MHz, depending on the program in the ROM) is under
// 100 MHz, so a clock enable would fail timing on every path unless they all had multicycle
// constraints.
//
// cpu_clk changes only when the half-period counter fills: every 2^SLOW_BITS clocks when running,
// every 2^FAST_BITS when running fast, stepping or resetting. Stopping happens only where a rising
// edge would go, so the clock is always low when stopped.
//   Instruction mode: a step, or turning run off, keeps clocking until the cpu is between
//   instructions (state FETCH), so it always leaves whole instructions done.
//   Clock mode (clock_step): a step is one rising edge, and turning run off stops at the next one,
//   wherever the cpu is. A step in instruction mode from mid-instruction finishes that instruction.
//   The cpu state is in the cpu_clk domain; it's sampled half a cpu clock after it last changed.
//   cpu_rst changes only with a falling edge, so it's never racing a rising one.
// After rst the cpu clock runs (fast) with cpu_rst held for two rising edges, so a short reset
// pulse is enough even when stopped.
module machine #(
    PROGRAM_ID = 0,                              // a Programs.Id, passed to computer
    SIM_RAM = 0 : SIM_RAM == 0 || SIM_RAM == 1,  // 1 in testbenches, passed to computer
    SLOW_BITS = 21 : SLOW_BITS > 1,              // run: half period of 2^SLOW_BITS clocks
    FAST_BITS = 4 : FAST_BITS > 0 && FAST_BITS < SLOW_BITS,
    CLK_FREQ = 100_000_000 : CLK_FREQ > 0,       // clk's frequency (the UART's baud comes from it)
    UART_BAUD = 1_000_000 : UART_BAUD > 0 && UART_BAUD <= CLK_FREQ / 2
  ) (
    input clk,
    input rst,
    input run,               // 1: run; 0: stop (see clock_step for where)
    input fast,              // run at the fast rate
    input clock_step,        // 1: step and stop by cpu clock; 0: by whole instruction
    input step,              // one-clock pulse: when stopped, run one instruction (or one cpu clock)
    input switches[8],       // the computer's switch register (synchronised to clk)
    input buttons[4],        // debounced push buttons (the computer's external interrupt source)
    input debug_sel[4],
    output debug_pc[32],
    output debug_reg[32],
    output cpu_state[Cpu.STATE_BITS],   // the cpu's control state (a Cpu.State)
    output cpu_clock,        // the cpu clock itself
    output halted,           // stopped, waiting for run or step
    output busy,             // finishing a step, or the instruction in progress when run went off
    output in_reset,         // the cpu is being held in reset
    output uart_tx           // the computer's serial out
  ) {

  .clk(clk), .rst(rst) {
    dff phase[SLOW_BITS]
    dff half_done                  // the half period just ended (registered: the 21-input AND is slow)
    dff cpu_clk
    dff cpu_rst(#INIT(1))
    dff reset_edges[2](#INIT(2))   // rising edges still to give the cpu with cpu_rst held
    dff active                     // clocking towards a stop point (a step, or the end of a run)
    dff moved                      // ...and has given at least one rising edge
    dff was_stopped                // stopped, one clock late: gates step (stopped straight into
                                   // active's enable missed 100 MHz, 2026-10-16); a step pulse
                                   // can't come twice in two clocks, so the lag is harmless
  }

  sig core_clk
  sig resetting
  sig at_fetch
  sig stopped

  .clk(core_clk) {
    computer comp(#PROGRAM_ID(PROGRAM_ID), #SIM_RAM(SIM_RAM), #UART_CLK_FREQ(CLK_FREQ),
                  #UART_BAUD(UART_BAUD), .rst(cpu_rst.q));
  }

  always {
    core_clk = cpu_clk.q
    comp.io_clk = clk
    comp.io_rst = rst
    uart_tx = comp.uart_tx
    phase.d = phase.q + 1

    resetting = reset_edges.q != 0
    at_fetch = comp.debug_state == Cpu.State.FETCH
    if (fast || resetting || (active.q && !run)) half_done.d = &phase.q[FAST_BITS-1:0]; else half_done.d = &phase.q;

    stopped = !cpu_clk.q && !run && !resetting && !active.q
    was_stopped.d = stopped

    if (half_done.q) {
      if (cpu_clk.q) {
        cpu_clk.d = 0
        if (resetting) {
          reset_edges.d = reset_edges.q - 1
          if (reset_edges.q == 1) cpu_rst.d = 0;
        }
      } else {
        if (run || resetting || (active.q && (!moved.q || (!at_fetch && !clock_step)))) {
          cpu_clk.d = 1
          moved.d = 1
        } else {
          active.d = 0
        }
      }
    }

    // Running counts as a step already under way, so turning run off finishes like a step does.
    if (run) {
      active.d = 1
      moved.d = 1
    }
    if (step && was_stopped.q) {
      active.d = 1
      moved.d = 0
    }

    halted = stopped
    busy = active.q && !run
    in_reset = cpu_rst.q
    cpu_clock = cpu_clk.q
    cpu_state = comp.debug_state
    comp.debug_sel = debug_sel
    comp.switches = switches
    comp.buttons = buttons
    debug_pc = comp.debug_pc
    debug_reg = comp.debug_reg
  }
}
