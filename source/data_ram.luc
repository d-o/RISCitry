// Data memory: single port, synchronous read (Alchitry's simple_ram.v behaviour).
//   read_data = the word at the address presented on the PREVIOUS clock (one-cycle latency)
//   write_enable writes write_data on the clock edge; reading the same address that cycle
//   returns the old value.
//
// Two implementations, fed identical inputs:
//   bram  - simple_ram.v, which Yosys maps to block RAM. Used in hardware.
//   model - the same behaviour written in Lucid. The Alchitry Labs simulator doesn't simulate
//           Verilog components (simple_ram's read_data is always x there), and a Lucid array
//           can't be inferred as block RAM (64x32 becomes 2048 flip-flops), so we need both.
// read_data comes from the model when SIM_MODEL = 1 (testbenches; $is_sim() is 0 in them) or in
// the interactive sim. In hardware the model's output is unused, so synthesis removes it.
module data_ram #(
    ENTRIES = 64 : ENTRIES > 1,
    SIM_MODEL = 0 : SIM_MODEL == 0 || SIM_MODEL == 1
  ) (
    input clk,
    input address[$clog2(ENTRIES)],
    input write_data[32],
    input write_enable,
    output read_data[32]
  ) {

  .clk(clk) {
    simple_ram bram(#WIDTH(32), #ENTRIES(ENTRIES));
    dff model_ram[ENTRIES][32]     // no reset, like block RAM (starts at 0 on the iCE40)
    dff model_read[32]
  }

  always {
    bram.address = address
    bram.write_data = write_data
    bram.write_enable = write_enable

    model_read.d = model_ram.q[address]
    if (write_enable) model_ram.d[address] = write_data;

    if (SIM_MODEL || $is_sim()) read_data = model_read.q; else read_data = bram.read_data;
  }
}
