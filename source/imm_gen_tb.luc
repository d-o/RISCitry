// GENERATED by tools/gen_imm_gen_tb.py from tools/rv32.py. Do not edit; rerun the script.
// Checks imm_gen's sign-extended immediate for I, S, B and J formats.
// Not covered yet: U-type (LUI/AUIPC) and JALR, which imm_gen doesn't implement.
testbench imm_gen_tb {
    sig in_inst[32]
    sig in_op[7]

    imm_gen dut(.instruction(in_inst), .opcode(in_op))

    fun check(inst[32], expected[32]) {
        in_inst = inst
        in_op = inst[6:0]
        $tick()
        if (dut.immediate != expected)
            $print("inst=%h got=%h want=%h", inst, dut.immediate, expected)
        $assert(dut.immediate == expected)
    }

    test i_type {
        in_inst = 0
        in_op = 0
        $check(32h000FFF93, 32h00000000) // op-imm imm=0 fields=1
        $check(32h001FFF93, 32h00000001) // op-imm imm=1 fields=1
        $check(32hFFFFFF93, 32hFFFFFFFF) // op-imm imm=-1 fields=1
        $check(32h7FFFFF93, 32h000007FF) // op-imm imm=2047 fields=1
        $check(32h800FFF93, 32hFFFFF800) // op-imm imm=-2048 fields=1
        $check(32h555FFF93, 32h00000555) // op-imm imm=1365 fields=1
        $check(32hAAAFFF93, 32hFFFFFAAA) // op-imm imm=-1366 fields=1
        $check(32h07CFFF93, 32h0000007C) // op-imm imm=124 fields=1
        $check(32h000FFF83, 32h00000000) // load imm=0 fields=1
        $check(32h001FFF83, 32h00000001) // load imm=1 fields=1
        $check(32hFFFFFF83, 32hFFFFFFFF) // load imm=-1 fields=1
        $check(32h7FFFFF83, 32h000007FF) // load imm=2047 fields=1
        $check(32h800FFF83, 32hFFFFF800) // load imm=-2048 fields=1
        $check(32h555FFF83, 32h00000555) // load imm=1365 fields=1
        $check(32hAAAFFF83, 32hFFFFFAAA) // load imm=-1366 fields=1
        $check(32h07CFFF83, 32h0000007C) // load imm=124 fields=1
        $check(32h00000013, 32h00000000) // op-imm imm=0 fields=0
        $check(32h00100013, 32h00000001) // op-imm imm=1 fields=0
        $check(32hFFF00013, 32hFFFFFFFF) // op-imm imm=-1 fields=0
        $check(32h7FF00013, 32h000007FF) // op-imm imm=2047 fields=0
        $check(32h80000013, 32hFFFFF800) // op-imm imm=-2048 fields=0
        $check(32h55500013, 32h00000555) // op-imm imm=1365 fields=0
        $check(32hAAA00013, 32hFFFFFAAA) // op-imm imm=-1366 fields=0
        $check(32h07C00013, 32h0000007C) // op-imm imm=124 fields=0
        $check(32h00000003, 32h00000000) // load imm=0 fields=0
        $check(32h00100003, 32h00000001) // load imm=1 fields=0
        $check(32hFFF00003, 32hFFFFFFFF) // load imm=-1 fields=0
        $check(32h7FF00003, 32h000007FF) // load imm=2047 fields=0
        $check(32h80000003, 32hFFFFF800) // load imm=-2048 fields=0
        $check(32h55500003, 32h00000555) // load imm=1365 fields=0
        $check(32hAAA00003, 32hFFFFFAAA) // load imm=-1366 fields=0
        $check(32h07C00003, 32h0000007C) // load imm=124 fields=0
    }

    test s_type {
        in_inst = 0
        in_op = 0
        $check(32h01FFF023, 32h00000000) // store imm=0 fields=1
        $check(32h01FFF0A3, 32h00000001) // store imm=1 fields=1
        $check(32hFFFFFFA3, 32hFFFFFFFF) // store imm=-1 fields=1
        $check(32h7FFFFFA3, 32h000007FF) // store imm=2047 fields=1
        $check(32h81FFF023, 32hFFFFF800) // store imm=-2048 fields=1
        $check(32h55FFFAA3, 32h00000555) // store imm=1365 fields=1
        $check(32hABFFF523, 32hFFFFFAAA) // store imm=-1366 fields=1
        $check(32h07FFFE23, 32h0000007C) // store imm=124 fields=1
        $check(32h00000023, 32h00000000) // store imm=0 fields=0
        $check(32h000000A3, 32h00000001) // store imm=1 fields=0
        $check(32hFE000FA3, 32hFFFFFFFF) // store imm=-1 fields=0
        $check(32h7E000FA3, 32h000007FF) // store imm=2047 fields=0
        $check(32h80000023, 32hFFFFF800) // store imm=-2048 fields=0
        $check(32h54000AA3, 32h00000555) // store imm=1365 fields=0
        $check(32hAA000523, 32hFFFFFAAA) // store imm=-1366 fields=0
        $check(32h06000E23, 32h0000007C) // store imm=124 fields=0
    }

    test b_type {
        in_inst = 0
        in_op = 0
        $check(32h01FFF063, 32h00000000) // branch imm=0 fields=1
        $check(32h01FFF163, 32h00000002) // branch imm=2 fields=1
        $check(32hFFFFFFE3, 32hFFFFFFFE) // branch imm=-2 fields=1
        $check(32h7FFFFFE3, 32h00000FFE) // branch imm=4094 fields=1
        $check(32h81FFF063, 32hFFFFF000) // branch imm=-4096 fields=1
        $check(32h01FFF0E3, 32h00000800) // branch imm=2048 fields=1
        $check(32h81FFF0E3, 32hFFFFF800) // branch imm=-2048 fields=1
        $check(32h2BFFF5E3, 32h00000AAA) // branch imm=2730 fields=1
        $check(32hABFFF5E3, 32hFFFFFAAA) // branch imm=-1366 fields=1
        $check(32hFDFFF6E3, 32hFFFFFFCC) // branch imm=-52 fields=1
        $check(32h00000063, 32h00000000) // branch imm=0 fields=0
        $check(32h00000163, 32h00000002) // branch imm=2 fields=0
        $check(32hFE000FE3, 32hFFFFFFFE) // branch imm=-2 fields=0
        $check(32h7E000FE3, 32h00000FFE) // branch imm=4094 fields=0
        $check(32h80000063, 32hFFFFF000) // branch imm=-4096 fields=0
        $check(32h000000E3, 32h00000800) // branch imm=2048 fields=0
        $check(32h800000E3, 32hFFFFF800) // branch imm=-2048 fields=0
        $check(32h2A0005E3, 32h00000AAA) // branch imm=2730 fields=0
        $check(32hAA0005E3, 32hFFFFFAAA) // branch imm=-1366 fields=0
        $check(32hFC0006E3, 32hFFFFFFCC) // branch imm=-52 fields=0
    }

    test j_type {
        in_inst = 0
        in_op = 0
        $check(32h00000FEF, 32h00000000) // jal imm=0 fields=1
        $check(32h00200FEF, 32h00000002) // jal imm=2 fields=1
        $check(32hFFFFFFEF, 32hFFFFFFFE) // jal imm=-2 fields=1
        $check(32h7FFFFFEF, 32h000FFFFE) // jal imm=1048574 fields=1
        $check(32h80000FEF, 32hFFF00000) // jal imm=-1048576 fields=1
        $check(32h00100FEF, 32h00000800) // jal imm=2048 fields=1
        $check(32h55455FEF, 32h00055554) // jal imm=349524 fields=1
        $check(32hD54D5FEF, 32hFFFD5554) // jal imm=-174764 fields=1
        $check(32h07C00FEF, 32h0000007C) // jal imm=124 fields=1
        $check(32hFCDFFFEF, 32hFFFFFFCC) // jal imm=-52 fields=1
        $check(32h0000006F, 32h00000000) // jal imm=0 fields=0
        $check(32h0020006F, 32h00000002) // jal imm=2 fields=0
        $check(32hFFFFF06F, 32hFFFFFFFE) // jal imm=-2 fields=0
        $check(32h7FFFF06F, 32h000FFFFE) // jal imm=1048574 fields=0
        $check(32h8000006F, 32hFFF00000) // jal imm=-1048576 fields=0
        $check(32h0010006F, 32h00000800) // jal imm=2048 fields=0
        $check(32h5545506F, 32h00055554) // jal imm=349524 fields=0
        $check(32hD54D506F, 32hFFFD5554) // jal imm=-174764 fields=0
        $check(32h07C0006F, 32h0000007C) // jal imm=124 fields=0
        $check(32hFCDFF06F, 32hFFFFFFCC) // jal imm=-52 fields=0
    }

    test no_imm {
        in_inst = 0
        in_op = 0
        $check(32h01FF8FB3, 32h00000000) // R-type add has no immediate
        $check(32hFFFFFFB3, 32h00000000) // R-type, all other bits set
    }
}
