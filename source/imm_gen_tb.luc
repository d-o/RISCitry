// GENERATED by tools/gen_imm_gen_tb.py from tools/rv32.py. Do not edit; rerun the script.
// Checks imm_gen's immediate for I, S, B, U and J formats (imm_type driven as the decoder would).
testbench imm_gen_tb {
    sig in_inst[32]
    sig in_type[3]

    imm_gen dut(.instruction(in_inst), .imm_type(in_type))

    fun check(inst[32], imm_type[3], expected[32]) {
        in_inst = inst
        in_type = imm_type
        $tick()
        if (dut.immediate != expected)
            $print("inst=%h got=%h want=%h", inst, dut.immediate, expected)
        $assert(dut.immediate == expected)
    }

    test i_type {
        in_inst = 0
        in_type = 0
        $check(32h000FFF93, 3d0, 32h00000000) // op-imm imm=0 fields=1
        $check(32h001FFF93, 3d0, 32h00000001) // op-imm imm=1 fields=1
        $check(32hFFFFFF93, 3d0, 32hFFFFFFFF) // op-imm imm=-1 fields=1
        $check(32h7FFFFF93, 3d0, 32h000007FF) // op-imm imm=2047 fields=1
        $check(32h800FFF93, 3d0, 32hFFFFF800) // op-imm imm=-2048 fields=1
        $check(32h555FFF93, 3d0, 32h00000555) // op-imm imm=1365 fields=1
        $check(32hAAAFFF93, 3d0, 32hFFFFFAAA) // op-imm imm=-1366 fields=1
        $check(32h07CFFF93, 3d0, 32h0000007C) // op-imm imm=124 fields=1
        $check(32h000FFF83, 3d0, 32h00000000) // load imm=0 fields=1
        $check(32h001FFF83, 3d0, 32h00000001) // load imm=1 fields=1
        $check(32hFFFFFF83, 3d0, 32hFFFFFFFF) // load imm=-1 fields=1
        $check(32h7FFFFF83, 3d0, 32h000007FF) // load imm=2047 fields=1
        $check(32h800FFF83, 3d0, 32hFFFFF800) // load imm=-2048 fields=1
        $check(32h555FFF83, 3d0, 32h00000555) // load imm=1365 fields=1
        $check(32hAAAFFF83, 3d0, 32hFFFFFAAA) // load imm=-1366 fields=1
        $check(32h07CFFF83, 3d0, 32h0000007C) // load imm=124 fields=1
        $check(32h000FFFE7, 3d0, 32h00000000) // jalr imm=0 fields=1
        $check(32h001FFFE7, 3d0, 32h00000001) // jalr imm=1 fields=1
        $check(32hFFFFFFE7, 3d0, 32hFFFFFFFF) // jalr imm=-1 fields=1
        $check(32h7FFFFFE7, 3d0, 32h000007FF) // jalr imm=2047 fields=1
        $check(32h800FFFE7, 3d0, 32hFFFFF800) // jalr imm=-2048 fields=1
        $check(32h555FFFE7, 3d0, 32h00000555) // jalr imm=1365 fields=1
        $check(32hAAAFFFE7, 3d0, 32hFFFFFAAA) // jalr imm=-1366 fields=1
        $check(32h07CFFFE7, 3d0, 32h0000007C) // jalr imm=124 fields=1
        $check(32h00000013, 3d0, 32h00000000) // op-imm imm=0 fields=0
        $check(32h00100013, 3d0, 32h00000001) // op-imm imm=1 fields=0
        $check(32hFFF00013, 3d0, 32hFFFFFFFF) // op-imm imm=-1 fields=0
        $check(32h7FF00013, 3d0, 32h000007FF) // op-imm imm=2047 fields=0
        $check(32h80000013, 3d0, 32hFFFFF800) // op-imm imm=-2048 fields=0
        $check(32h55500013, 3d0, 32h00000555) // op-imm imm=1365 fields=0
        $check(32hAAA00013, 3d0, 32hFFFFFAAA) // op-imm imm=-1366 fields=0
        $check(32h07C00013, 3d0, 32h0000007C) // op-imm imm=124 fields=0
        $check(32h00000003, 3d0, 32h00000000) // load imm=0 fields=0
        $check(32h00100003, 3d0, 32h00000001) // load imm=1 fields=0
        $check(32hFFF00003, 3d0, 32hFFFFFFFF) // load imm=-1 fields=0
        $check(32h7FF00003, 3d0, 32h000007FF) // load imm=2047 fields=0
        $check(32h80000003, 3d0, 32hFFFFF800) // load imm=-2048 fields=0
        $check(32h55500003, 3d0, 32h00000555) // load imm=1365 fields=0
        $check(32hAAA00003, 3d0, 32hFFFFFAAA) // load imm=-1366 fields=0
        $check(32h07C00003, 3d0, 32h0000007C) // load imm=124 fields=0
        $check(32h00000067, 3d0, 32h00000000) // jalr imm=0 fields=0
        $check(32h00100067, 3d0, 32h00000001) // jalr imm=1 fields=0
        $check(32hFFF00067, 3d0, 32hFFFFFFFF) // jalr imm=-1 fields=0
        $check(32h7FF00067, 3d0, 32h000007FF) // jalr imm=2047 fields=0
        $check(32h80000067, 3d0, 32hFFFFF800) // jalr imm=-2048 fields=0
        $check(32h55500067, 3d0, 32h00000555) // jalr imm=1365 fields=0
        $check(32hAAA00067, 3d0, 32hFFFFFAAA) // jalr imm=-1366 fields=0
        $check(32h07C00067, 3d0, 32h0000007C) // jalr imm=124 fields=0
    }

    test s_type {
        in_inst = 0
        in_type = 0
        $check(32h01FFF023, 3d1, 32h00000000) // store imm=0 fields=1
        $check(32h01FFF0A3, 3d1, 32h00000001) // store imm=1 fields=1
        $check(32hFFFFFFA3, 3d1, 32hFFFFFFFF) // store imm=-1 fields=1
        $check(32h7FFFFFA3, 3d1, 32h000007FF) // store imm=2047 fields=1
        $check(32h81FFF023, 3d1, 32hFFFFF800) // store imm=-2048 fields=1
        $check(32h55FFFAA3, 3d1, 32h00000555) // store imm=1365 fields=1
        $check(32hABFFF523, 3d1, 32hFFFFFAAA) // store imm=-1366 fields=1
        $check(32h07FFFE23, 3d1, 32h0000007C) // store imm=124 fields=1
        $check(32h00000023, 3d1, 32h00000000) // store imm=0 fields=0
        $check(32h000000A3, 3d1, 32h00000001) // store imm=1 fields=0
        $check(32hFE000FA3, 3d1, 32hFFFFFFFF) // store imm=-1 fields=0
        $check(32h7E000FA3, 3d1, 32h000007FF) // store imm=2047 fields=0
        $check(32h80000023, 3d1, 32hFFFFF800) // store imm=-2048 fields=0
        $check(32h54000AA3, 3d1, 32h00000555) // store imm=1365 fields=0
        $check(32hAA000523, 3d1, 32hFFFFFAAA) // store imm=-1366 fields=0
        $check(32h06000E23, 3d1, 32h0000007C) // store imm=124 fields=0
    }

    test b_type {
        in_inst = 0
        in_type = 0
        $check(32h01FFF063, 3d2, 32h00000000) // branch imm=0 fields=1
        $check(32h01FFF163, 3d2, 32h00000002) // branch imm=2 fields=1
        $check(32hFFFFFFE3, 3d2, 32hFFFFFFFE) // branch imm=-2 fields=1
        $check(32h7FFFFFE3, 3d2, 32h00000FFE) // branch imm=4094 fields=1
        $check(32h81FFF063, 3d2, 32hFFFFF000) // branch imm=-4096 fields=1
        $check(32h01FFF0E3, 3d2, 32h00000800) // branch imm=2048 fields=1
        $check(32h81FFF0E3, 3d2, 32hFFFFF800) // branch imm=-2048 fields=1
        $check(32h2BFFF5E3, 3d2, 32h00000AAA) // branch imm=2730 fields=1
        $check(32hABFFF5E3, 3d2, 32hFFFFFAAA) // branch imm=-1366 fields=1
        $check(32hFDFFF6E3, 3d2, 32hFFFFFFCC) // branch imm=-52 fields=1
        $check(32h00000063, 3d2, 32h00000000) // branch imm=0 fields=0
        $check(32h00000163, 3d2, 32h00000002) // branch imm=2 fields=0
        $check(32hFE000FE3, 3d2, 32hFFFFFFFE) // branch imm=-2 fields=0
        $check(32h7E000FE3, 3d2, 32h00000FFE) // branch imm=4094 fields=0
        $check(32h80000063, 3d2, 32hFFFFF000) // branch imm=-4096 fields=0
        $check(32h000000E3, 3d2, 32h00000800) // branch imm=2048 fields=0
        $check(32h800000E3, 3d2, 32hFFFFF800) // branch imm=-2048 fields=0
        $check(32h2A0005E3, 3d2, 32h00000AAA) // branch imm=2730 fields=0
        $check(32hAA0005E3, 3d2, 32hFFFFFAAA) // branch imm=-1366 fields=0
        $check(32hFC0006E3, 3d2, 32hFFFFFFCC) // branch imm=-52 fields=0
    }

    test u_type {
        in_inst = 0
        in_type = 0
        $check(32h00000FB7, 3d3, 32h00000000) // lui imm=0x0 fields=1
        $check(32h00001FB7, 3d3, 32h00001000) // lui imm=0x1 fields=1
        $check(32h80000FB7, 3d3, 32h80000000) // lui imm=0x80000 fields=1
        $check(32hFFFFFFB7, 3d3, 32hFFFFF000) // lui imm=0xfffff fields=1
        $check(32h12345FB7, 3d3, 32h12345000) // lui imm=0x12345 fields=1
        $check(32h7FFFFFB7, 3d3, 32h7FFFF000) // lui imm=0x7ffff fields=1
        $check(32h00000F97, 3d3, 32h00000000) // auipc imm=0x0 fields=1
        $check(32h00001F97, 3d3, 32h00001000) // auipc imm=0x1 fields=1
        $check(32h80000F97, 3d3, 32h80000000) // auipc imm=0x80000 fields=1
        $check(32hFFFFFF97, 3d3, 32hFFFFF000) // auipc imm=0xfffff fields=1
        $check(32h12345F97, 3d3, 32h12345000) // auipc imm=0x12345 fields=1
        $check(32h7FFFFF97, 3d3, 32h7FFFF000) // auipc imm=0x7ffff fields=1
        $check(32h00000037, 3d3, 32h00000000) // lui imm=0x0 fields=0
        $check(32h00001037, 3d3, 32h00001000) // lui imm=0x1 fields=0
        $check(32h80000037, 3d3, 32h80000000) // lui imm=0x80000 fields=0
        $check(32hFFFFF037, 3d3, 32hFFFFF000) // lui imm=0xfffff fields=0
        $check(32h12345037, 3d3, 32h12345000) // lui imm=0x12345 fields=0
        $check(32h7FFFF037, 3d3, 32h7FFFF000) // lui imm=0x7ffff fields=0
        $check(32h00000017, 3d3, 32h00000000) // auipc imm=0x0 fields=0
        $check(32h00001017, 3d3, 32h00001000) // auipc imm=0x1 fields=0
        $check(32h80000017, 3d3, 32h80000000) // auipc imm=0x80000 fields=0
        $check(32hFFFFF017, 3d3, 32hFFFFF000) // auipc imm=0xfffff fields=0
        $check(32h12345017, 3d3, 32h12345000) // auipc imm=0x12345 fields=0
        $check(32h7FFFF017, 3d3, 32h7FFFF000) // auipc imm=0x7ffff fields=0
