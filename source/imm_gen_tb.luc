        $check(32h0000006F, 3d4, 32h00000000) // jal imm=0 fields=0
        $check(32h0020006F, 3d4, 32h00000002) // jal imm=2 fields=0
        $check(32hFFFFF06F, 3d4, 32hFFFFFFFE) // jal imm=-2 fields=0
        $check(32h7FFFF06F, 3d4, 32h000FFFFE) // jal imm=1048574 fields=0
        $check(32h8000006F, 3d4, 32hFFF00000) // jal imm=-1048576 fields=0
        $check(32h0010006F, 3d4, 32h00000800) // jal imm=2048 fields=0
        $check(32h5545506F, 3d4, 32h00055554) // jal imm=349524 fields=0
        $check(32hD54D506F, 3d4, 32hFFFD5554) // jal imm=-174764 fields=0
        $check(32h07C0006F, 3d4, 32h0000007C) // jal imm=124 fields=0
