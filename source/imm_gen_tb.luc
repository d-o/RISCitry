    test j_type {
        in_inst = 0
        in_type = 0
        $check(32h00000FEF, 3d4, 32h00000000) // jal imm=0 fields=1
        $check(32h00200FEF, 3d4, 32h00000002) // jal imm=2 fields=1
        $check(32hFFFFFFEF, 3d4, 32hFFFFFFFE) // jal imm=-2 fields=1
        $check(32h7FFFFFEF, 3d4, 32h000FFFFE) // jal imm=1048574 fields=1
        $check(32h80000FEF, 3d4, 32hFFF00000) // jal imm=-1048576 fields=1
        $check(32h00100FEF, 3d4, 32h00000800) // jal imm=2048 fields=1
        $check(32h55455FEF, 3d4, 32h00055554) // jal imm=349524 fields=1
        $check(32hD54D5FEF, 3d4, 32hFFFD5554) // jal imm=-174764 fields=1
        $check(32h07C00FEF, 3d4, 32h0000007C) // jal imm=124 fields=1
