// Instruction decoder: instruction -> control signals. Purely combinational, no state.
// One case entry per RV32I opcode group; individual instructions within a group come from
// funct3/funct7 passing straight through (alu_op = {funct7[5], funct3}), so adding an
// instruction rarely adds a line here.
// The sequencing (which state comes next) lives in control_unit, not here.
module decoder (
    input instruction[32],
    output alu_op[4],          // alu.luc encoding: {funct7[5], funct3}
    output alu_src_a,          // 0 = rs1, 1 = pc (AUIPC)
    output alu_src_b,          // 0 = rs2, 1 = immediate
    output imm_type[3],        // Cpu.IMM_*
    output wb_sel[2],          // Cpu.WB_*
    output reg_write,
    output mem_read,
    output mem_write,
    output branch,             // conditional branch; condition is funct3
    output jump,               // JAL: pc = pc + imm
    output jalr,               // JALR: pc = (rs1 + imm) & ~1
    output illegal             // not a valid RV32E instruction; all side effects are forced off
  ) {

  sig opcode[7]
  sig funct3[3]
  sig funct7[7]
  sig uses_rd
  sig uses_rs1
  sig uses_rs2
  sig bad                    // illegal, readable internally (outputs can't be read in Lucid)

  always {
    opcode = instruction[6:0]
    funct3 = instruction[14:12]
    funct7 = instruction[31:25]

    alu_op = 4b0000
    alu_src_a = 0
    alu_src_b = 0
    imm_type = Cpu.IMM_I
    wb_sel = Cpu.WB_ALU
    reg_write = 0
    mem_read = 0
    mem_write = 0
    branch = 0
    jump = 0
    jalr = 0
    bad = 0
    uses_rd = 0
    uses_rs1 = 0
    uses_rs2 = 0

    case (opcode) {
      7h37: // LUI: rd = imm
        imm_type = Cpu.IMM_U
        wb_sel = Cpu.WB_IMM
        reg_write = 1
        uses_rd = 1

      7h17: // AUIPC: rd = pc + imm
        imm_type = Cpu.IMM_U
        alu_src_a = 1
        alu_src_b = 1
        reg_write = 1
        uses_rd = 1

      7h6F: // JAL: rd = pc + 4, pc = pc + imm
        imm_type = Cpu.IMM_J
        wb_sel = Cpu.WB_PC4
        reg_write = 1
        jump = 1
        uses_rd = 1

      7h67: // JALR: rd = pc + 4, pc = (rs1 + imm) & ~1; target comes from the ALU
        imm_type = Cpu.IMM_I
        alu_src_b = 1
        wb_sel = Cpu.WB_PC4
        reg_write = 1
        jalr = 1
        uses_rd = 1
        uses_rs1 = 1
        if (funct3 != 3b000) bad = 1

      7h63: // BRANCH: BEQ/BNE/BLT/BGE/BLTU/BGEU, condition from funct3
        imm_type = Cpu.IMM_B
        alu_op = 4b1000 // sub, so the ALU zero flag still serves BEQ/BNE until branch_unit exists
        branch = 1
        uses_rs1 = 1
        uses_rs2 = 1
        if (funct3 == 3b010 || funct3 == 3b011) bad = 1

      7h03: // LOAD: LB/LH/LW/LBU/LHU, address = rs1 + imm
        imm_type = Cpu.IMM_I
        alu_src_b = 1
        wb_sel = Cpu.WB_MEM
        reg_write = 1
        mem_read = 1
        uses_rd = 1
        uses_rs1 = 1
        if (funct3 == 3b011 || funct3 == 3b110 || funct3 == 3b111) bad = 1

      7h23: // STORE: SB/SH/SW, address = rs1 + imm
        imm_type = Cpu.IMM_S
        alu_src_b = 1
        mem_write = 1
        uses_rs1 = 1
        uses_rs2 = 1
        if (funct3 > 3b010) bad = 1

      7h13: // OP-IMM: bit 30 is part of the immediate, except for the shifts (SRLI vs SRAI)
        imm_type = Cpu.IMM_I
        alu_src_b = 1
        reg_write = 1
        uses_rd = 1
        uses_rs1 = 1
        if (funct3 == 3b101) alu_op = c{funct7[5], funct3}; else alu_op = c{1b0, funct3};
        if (funct3 == 3b001 && funct7 != 7h00) bad = 1
        if (funct3 == 3b101 && funct7 != 7h00 && funct7 != 7h20) bad = 1

      7h33: // OP: register-register ALU ops; only SUB and SRA may set funct7 = 0x20
        alu_op = c{funct7[5], funct3}
        reg_write = 1
        uses_rd = 1
        uses_rs1 = 1
        uses_rs2 = 1
        if (funct7 != 7h00 && !(funct7 == 7h20 && (funct3 == 3b000 || funct3 == 3b101))) bad = 1

      7h0F: // MISC-MEM: FENCE is a no-op on this in-order, single-memory core
        if (funct3 != 3b000) bad = 1

      7h73: // SYSTEM: ECALL/EBREAK decode as no-ops (no traps yet); CSR instructions are illegal
        if (instruction[31:7] != 25h0 && instruction[31:7] != 25h2000) bad = 1

      default:
        bad = 1
    }

    // RV32E has only x0-x15: a register field with bit 4 set is illegal where that field is used.
    if ((uses_rd && instruction[11]) || (uses_rs1 && instruction[19]) || (uses_rs2 && instruction[24])) bad = 1

    illegal = bad
    if (bad) {
      reg_write = 0
      mem_read = 0
      mem_write = 0
      branch = 0
      jump = 0
      jalr = 0
    }
  }
}
