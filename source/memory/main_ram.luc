// Main memory for the unified (von Neumann) address space: code and data, 32-bit words in four
// byte lanes, preloaded with a program.
//   One read port and one write port with separate addresses, both on the same clock:
//   rdata = the word at raddr on the PREVIOUS clock (synchronous read). be[i] writes lane i of
//   wdata at waddr on the clock edge. Reading the address being written that edge returns the
//   old value (read-before-write).
//   Initial contents: PROGRAM_ID's program (a Programs.Id) from address 0, 0 elsewhere. There is
//   no reset: like the block RAM, contents survive a cpu reset; only reconfiguring reloads them.
//
// Two implementations, fed identical inputs (the data_ram pattern):
//   bram  - main_ram_bram.v (generated), which Yosys maps to initialised block RAM. Hardware.
//   model - the same behaviour in Lucid. The Alchitry simulator doesn't run Verilog, and a Lucid
//           array can't be initialised from a short constant, so the model keeps a written flag
//           per byte and overlays its writes on program_image (the same program, generated).
// rdata comes from the model when SIM_MODEL = 1, which every simulation must set (testbenches
// directly; the board passes $is_sim()). In a build the model's arrays shrink to two words and
// its output is unused, so synthesis removes it. Not $is_sim() in here: the IDE sized the arrays
// as for a build but still read the model, so every address past 1 was out of bounds and every
// fetch returned word 0 (2026-10-15).
module main_ram #(
    WORDS = 2048 : WORDS > 1 && WORDS <= 16384,
    PROGRAM_ID = 0,
    SIM_MODEL = 0 : SIM_MODEL == 0 || SIM_MODEL == 1
  ) (
    input clk,
    input raddr[$clog2(WORDS)],    // word addresses
    output rdata[32],
    input waddr[$clog2(WORDS)],
    input wdata[32],
    input be[4]
  ) {

  // The model's arrays are full size only when it's used; in a build they shrink to two words
  // (synthesis would remove them anyway, but Yosys's check pass spent ~8 minutes on 2048 words).
  const MODEL_WORDS = SIM_MODEL ? WORDS : 2

  .clk(clk) {
    main_ram_bram bram(#PROGRAM_ID(PROGRAM_ID), #WORDS(WORDS));
    dff model_mem[MODEL_WORDS][4][8]
    dff model_written[MODEL_WORDS][4]    // byte has been written: read model_mem, not the image
    dff model_read[4][8]
  }

  program_image read_image(#PROGRAM_ID(PROGRAM_ID));

  always {
    bram.raddr = raddr
    bram.waddr = waddr
    bram.wdata = wdata
    bram.be = be

    read_image.addr = raddr
    repeat(i, 4) {
      if (model_written.q[raddr][i]) model_read.d[i] = model_mem.q[raddr][i]; else model_read.d[i] = read_image.word[i*8+7:i*8];
      if (be[i]) {
        model_mem.d[waddr][i] = wdata[i*8+7:i*8]
        model_written.d[waddr][i] = 1
      }
    }

    if (SIM_MODEL) rdata = $flatten(model_read.q); else rdata = bram.rdata;
  }
}
