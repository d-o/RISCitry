// Data memory: 32-bit words in four byte lanes, single port, synchronous read
// (Alchitry's simple_ram.v behaviour, per lane).
//   read_data = the word at the address presented on the PREVIOUS clock (one-cycle latency)
//   byte_enable[i] writes lane i (bits [8i+7:8i]) of write_data on the clock edge; reading the
//   same address that cycle returns the old value.
//
// Two implementations, fed identical inputs:
//   lanes - four 8-bit simple_ram.v instances, which Yosys maps to block RAM. Used in hardware.
//   model - the same behaviour written in Lucid. The Alchitry Labs simulator doesn't simulate
//           Verilog components (simple_ram's read_data is always x there), and a Lucid array
//           can't be inferred as block RAM (64x32 becomes 2048 flip-flops), so we need both.
// read_data comes from the model when SIM_MODEL = 1 (testbenches; $is_sim() is 0 in them) or in
// the interactive sim. In hardware the model's output is unused, so synthesis removes it.
module data_ram #(
    ENTRIES = 64 : ENTRIES > 1,
    SIM_MODEL = 0 : SIM_MODEL == 0 || SIM_MODEL == 1
  ) (
    input clk,
    input address[$clog2(ENTRIES)],
    input write_data[32],
    input byte_enable[4],
    output read_data[32]
  ) {

  .clk(clk) {
    simple_ram lane0(#WIDTH(8), #ENTRIES(ENTRIES));   // bits [7:0]
    simple_ram lane1(#WIDTH(8), #ENTRIES(ENTRIES));   // bits [15:8]
    simple_ram lane2(#WIDTH(8), #ENTRIES(ENTRIES));   // bits [23:16]
    simple_ram lane3(#WIDTH(8), #ENTRIES(ENTRIES));   // bits [31:24]
    dff model_ram[ENTRIES][4][8]   // no reset, like block RAM (starts at 0 on the iCE40)
    dff model_read[4][8]
  }

  always {
    lane0.address = address
    lane1.address = address
    lane2.address = address
    lane3.address = address
    lane0.write_data = write_data[7:0]
    lane1.write_data = write_data[15:8]
    lane2.write_data = write_data[23:16]
    lane3.write_data = write_data[31:24]
    lane0.write_enable = byte_enable[0]
    lane1.write_enable = byte_enable[1]
    lane2.write_enable = byte_enable[2]
    lane3.write_enable = byte_enable[3]

    repeat(i, 4) {
      if (byte_enable[i]) model_ram.d[address][i] = write_data[i*8+7:i*8];
    }
    model_read.d = model_ram.q[address]

    if (SIM_MODEL || $is_sim()) read_data = $flatten(model_read.q); else read_data = c{lane3.read_data, lane2.read_data, lane1.read_data, lane0.read_data};
  }
}
