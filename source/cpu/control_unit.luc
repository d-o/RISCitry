// Sequencer: decides which state comes next and gates the decoder's side effects by state.
// It never looks at the opcode; everything instruction-specific arrives in ctrl from decoder.luc.
//   FETCH -> EXECUTE -> FETCH                          (ALU ops, jumps, branches, LUI/AUIPC)
//   FETCH -> EXECUTE -> MEM_ACCESS -> FETCH            (stores)
//   FETCH -> EXECUTE -> MEM_ACCESS -> WRITEBACK -> FETCH (loads: the RAM read takes a cycle)
// The cycle that writes pc also fetches: cpu.luc puts the next pc on the read port then, so the
// instruction is there in FETCH. A load's address goes on the read port in MEM_ACCESS (mem_read).
// A trap (trap_unit: illegal, ECALL, EBREAK, misaligned target/access) is taken in EXECUTE instead
// of anything the instruction would do: pc = mtvec (pc_src 11), csr_file records the cause, and
// the next instruction fetched is the handler's first. A trapping load/store never reaches
// MEM_ACCESS, so it neither reads nor writes memory.
// WFI waits in EXECUTE (no side effects, pc held) until wake: an interrupt enabled in mie is
// pending. With MIE set that interrupt is then taken as a trap (cpu.luc makes mepc = pc + 4, the
// instruction after the WFI, as the spec says); with MIE clear the WFI just completes. The timer
// counts real time, so it ticks on while the cpu waits. `sleeping` says so to the machine, which
// then stops giving the cpu clock pulses until wake (the buttons and the timer run on every clock).
module control_unit (
    input clk,
    input rst,
    input ce,                // clock enable: on a clock with ce = 0 nothing here changes
    input ctrl<Cpu.control>,
    input branch_taken,
    input trap,                // trap_unit: this instruction traps
    input wake,                // csr_file: an interrupt enabled in mie is pending (ends a WFI)
    output pc_write,
    output pc_src[2],          // program_counter: 00 = pc + 4, 01 = pc + imm, 10 = JALR target, 11 = vector (mtvec, or mepc for MRET)
    output reg_write,
    output mem_write,
    output mem_read,           // a load's address is on the read port this clock
    output csr_write,          // a CSR instruction writes its CSR on this edge
    output mret,               // MRET takes effect on this edge (pc = mepc, MIE = MPIE)
    output take_trap,          // a trap is taken on this edge (pc = mtvec; csr_file records it)
    output sleeping,           // a WFI is waiting: clock pulses would change nothing (machine.luc stops them)
    output current_state[Cpu.STATE_BITS]   // a Cpu.State; FETCH = between instructions
  ) {

  dff state[Cpu.STATE_BITS](#INIT(Cpu.State.FETCH), .clk(clk), .rst(rst))

  always {
    pc_write = 0
    pc_src = 2b00
    reg_write = 0
    mem_write = 0
    mem_read = 0
    csr_write = 0
    mret = 0
    take_trap = 0
    current_state = state.q
    sleeping = state.q == Cpu.State.EXECUTE && ctrl.wfi && !wake

    case (state.q) {
      Cpu.State.FETCH:
        state.d = Cpu.State.EXECUTE

      Cpu.State.EXECUTE:
        if (trap) {
          take_trap = 1
          pc_write = 1
          pc_src = 2b11
          state.d = Cpu.State.FETCH
        } else if (ctrl.wfi && !wake) {
          state.d = Cpu.State.EXECUTE      // waiting for an interrupt
        } else if (ctrl.mem_read || ctrl.mem_write) {
          state.d = Cpu.State.MEM_ACCESS
        } else {
          reg_write = ctrl.reg_write
          csr_write = ctrl.csr_write
          pc_write = 1
          if (ctrl.jump || (ctrl.branch && branch_taken)) pc_src = 2b01;
          if (ctrl.jalr) pc_src = 2b10;
          if (ctrl.mret) {
            pc_src = 2b11
            mret = 1
          }
          state.d = Cpu.State.FETCH
        }

      Cpu.State.MEM_ACCESS:
        if (ctrl.mem_write) {
          mem_write = 1
          pc_write = 1
          state.d = Cpu.State.FETCH
        } else {
          mem_read = ctrl.mem_read
          state.d = Cpu.State.WRITEBACK
        }

      Cpu.State.WRITEBACK:
        reg_write = ctrl.reg_write
        pc_write = 1
        state.d = Cpu.State.FETCH

      default:
        state.d = Cpu.State.FETCH
    }

    if (!ce) {        // disabled clock: hold everything
      state.d = state.q
    }
  }
}
