// Machine-mode CSRs (Zicsr). The decoder has already rejected unimplemented addresses and writes
// to read-only ones, so this only holds the registers, reads the addressed one and applies a write.
// A CSR instruction reads the old value (for rd) and writes the new one on the same edge, in
// EXECUTE. Write semantics per the spec: write, set (old | src) or clear (old & ~src); bits a
// CSR doesn't implement read 0 and ignore writes (WARL).
module csr_file (
    input clk,
    input rst,
    input ce,                // clock enable: on a clock with ce = 0 nothing here changes
    input addr[12],          // the CSR address, instruction[31:20]
    input op[2],             // funct3[1:0]: 01 write, 10 set, 11 clear
    input src[32],           // rs1's value, or the zero-extended zimm
    input write,             // write the addressed CSR on this edge (gated by control_unit)
    input mret,              // MRET's pc-writing edge: MIE = MPIE, MPIE = 1
    input trap,              // a trap is taken on this edge: record it, MPIE = MIE, MIE = 0
    input trap_pc[32],       // the trapping instruction's address (mepc)
    input trap_cause[4],     // mcause's exception code
    input trap_interrupt,    // ... and its interrupt bit (mcause[31])
    input mtip,              // timer interrupt pending (mip.MTIP, read-only)
    input meip,              // external interrupt pending (mip.MEIP, read-only)
    input trap_value[32],    // mtval
    output read_data[32],    // the addressed CSR
    output mepc[32],         // MRET's return address
    output mtvec[32],        // the trap handler's address
    output irq,              // an enabled interrupt is pending: MIE && (MEIE && MEIP || MTIE && MTIP)
    output irq_cause[4]      // which: external (11) beats timer (7), the spec's priority order
  ) {

  .clk(clk), .rst(rst) {
    dff mstatus_mie          // global interrupt enable; 0 after reset, as the spec requires
    dff mstatus_mpie         // MIE before the last trap
    dff mie_msie             // mie: software, timer, external interrupt enables
    dff mie_mtie
    dff mie_meie
    dff mtvec_base[30]       // mtvec[31:2]; MODE = 0 (direct)
    dff mscratch[32]
    dff mepc_word[30]        // mepc[31:2]
    dff mcause[32]
    dff mtval[32]
  }

  sig value[32]              // the addressed CSR's current value
  sig new_value[32]

  always {
    case (addr) {
      Cpu.CSR_MSTATUS: value = c{19b0, 2b11, 3b0, mstatus_mpie.q, 3b0, mstatus_mie.q, 3b0}
      Cpu.CSR_MISA:    value = Cpu.MISA_VALUE
      Cpu.CSR_MIE:     value = c{20b0, mie_meie.q, 3b0, mie_mtie.q, 3b0, mie_msie.q, 3b0}
      Cpu.CSR_MTVEC:   value = c{mtvec_base.q, 2b00}
      Cpu.CSR_MSCRATCH: value = mscratch.q
      Cpu.CSR_MEPC:    value = c{mepc_word.q, 2b00}
      Cpu.CSR_MCAUSE:  value = mcause.q
      Cpu.CSR_MTVAL:   value = mtval.q
      Cpu.CSR_MIP:     value = c{20b0, meip, 3b0, mtip, 7b0}
      default:         value = 0        // mstatush, the ID registers
    }
    read_data = value
    mepc = c{mepc_word.q, 2b00}
    mtvec = c{mtvec_base.q, 2b00}
    irq = mstatus_mie.q && ((mie_meie.q && meip) || (mie_mtie.q && mtip))
    if (mie_meie.q && meip) irq_cause = Cpu.CAUSE_EXTERNAL_INTERRUPT; else irq_cause = Cpu.CAUSE_TIMER_INTERRUPT;

    case (op) {
      2b10:    new_value = value | src
      2b11:    new_value = value & ~src
      default: new_value = src
    }

    if (write) {
      case (addr) {
        Cpu.CSR_MSTATUS:
          mstatus_mie.d = new_value[3]
          mstatus_mpie.d = new_value[7]
        Cpu.CSR_MIE:
          mie_msie.d = new_value[3]
          mie_mtie.d = new_value[7]
          mie_meie.d = new_value[11]
        Cpu.CSR_MTVEC:    mtvec_base.d = new_value[31:2]
        Cpu.CSR_MSCRATCH: mscratch.d = new_value
        Cpu.CSR_MEPC:     mepc_word.d = new_value[31:2]
        Cpu.CSR_MCAUSE:   mcause.d = new_value
        Cpu.CSR_MTVAL:    mtval.d = new_value
        default:          mscratch.d = mscratch.q   // misa, mstatush, mip: writes ignored
      }
    }

    if (mret) {
      mstatus_mie.d = mstatus_mpie.q
      mstatus_mpie.d = 1
    }

    if (trap) {
      mepc_word.d = trap_pc[31:2]
      mcause.d = c{trap_interrupt, 27b0, trap_cause}
      mtval.d = trap_value
      mstatus_mpie.d = mstatus_mie.q
      mstatus_mie.d = 0
    }

    if (!ce) {        // disabled clock: hold everything
      mstatus_mie.d = mstatus_mie.q
      mstatus_mpie.d = mstatus_mpie.q
      mie_msie.d = mie_msie.q
      mie_mtie.d = mie_mtie.q
      mie_meie.d = mie_meie.q
      mtvec_base.d = mtvec_base.q
      mscratch.d = mscratch.q
      mepc_word.d = mepc_word.q
      mcause.d = mcause.q
      mtval.d = mtval.q
    }
  }
}
