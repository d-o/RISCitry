// The RV32E core. It reaches memory only through its bus: one read port (instructions and load
// data) and one write port (stores); computer.luc decodes the addresses.
//
// Read port: the word at bus_raddr comes back on bus_rdata one clock later (synchronous, like
// block RAM). The cpu chooses what to read each clock:
//   - normally the pc's next value. In an instruction's last cycle (the one that writes pc) that's
//     the next instruction's address, so the instruction is on bus_rdata in FETCH, which latches
//     it into if_id_reg; in every other cycle it's pc itself (a harmless re-read). Reset holds pc
//     at 0, so the first FETCH sees address 0.
//   - a load's address in MEM_ACCESS (bus_load = 1); the data arrives in WRITEBACK.
// A store's last cycle writes on the write port and fetches on the read port on the same edge.
// Instruction-fetch prefetch: the next instruction is read on the edge that ends the current one,
// so a store to the next instruction's address takes effect for the instruction after it.
//
// decoder (what the instruction needs) + control_unit (when, by FSM state) drive the datapath:
//   bus_rdata -> if_id_reg -> decoder/imm_gen; register_file -> alu / branch_unit;
//   byte lanes via mem_align for loads/stores; the write-back mux picks rd's value from ctrl.wb_sel.
module cpu (
    input clk,
    input rst,
    output bus_raddr[32],    // read port: byte address (next pc, or a load's rs1 + imm)
    output bus_load,         // 1 while bus_raddr is a load's address; 0 for instruction fetches
    input bus_rdata[32],     // the word at bus_raddr on the previous clock
    output bus_waddr[32],    // write port: byte address (rs1 + imm)
    output bus_wdata[32],    // store data, copied into every lane it could occupy
    output bus_be[4],        // byte lanes to write this clock; 0 when not storing
    input debug_sel[4],      // which register debug_reg shows
    output debug_pc[32],     // address of the instruction being fetched/executed
    output debug_reg[32],    // register x[debug_sel]
    output debug_state[Cpu.STATE_BITS]   // control_unit's state; FETCH = between instructions
  ) {

  .clk(clk) {
    program_counter pc_unit(.rst(rst));
    register_file reg_file(.rst(rst));
    control_unit control(.rst(rst));
    csr_file csrs(.rst(rst));
    dff if_id_reg[32](.rst(rst));   // instruction latched at the end of FETCH
  }

  decoder dec;
  imm_gen immediate_generator;
  alu alu_unit;
  branch_unit branch;
  trap_unit traps;
  mem_align align;

  sig instruction[32];
  sig pc_plus_4[32];
  sig target[32];            // branch/JAL target (pc + imm) or JALR's rs1 + imm (bit 0 not yet cleared)

  always {
    // --- fetch: the instruction arrives in FETCH; hold it for the rest of the instruction ---
    if (control.current_state == Cpu.State.FETCH) if_id_reg.d = bus_rdata; else if_id_reg.d = if_id_reg.q;
    instruction = if_id_reg.q;

    // --- decode ---
    dec.instruction = instruction;
    control.ctrl = dec.ctrl;
    control.branch_taken = branch.taken;
    control.trap = traps.trap;

    immediate_generator.instruction = instruction;
    immediate_generator.imm_type = dec.ctrl.imm_type;

    reg_file.rs1 = instruction[19:15];
    reg_file.rs2 = instruction[24:20];
    reg_file.rd = instruction[11:7];

    // --- execute ---
    if (dec.ctrl.alu_src_a) alu_unit.a = pc_unit.pc; else alu_unit.a = reg_file.read_data1;
    if (dec.ctrl.alu_src_b) alu_unit.b = immediate_generator.immediate; else alu_unit.b = reg_file.read_data2;
    alu_unit.alu_op = dec.ctrl.alu_op;

    branch.funct3 = instruction[14:12];
    branch.a = reg_file.read_data1;
    branch.b = reg_file.read_data2;

    // --- memory: byte/halfword lanes via mem_align ---
    align.funct3 = instruction[14:12];
    align.addr_low = alu_unit.result[1:0];
    align.store_data = reg_file.read_data2;
    align.load_word = bus_rdata;

    bus_waddr = alu_unit.result;
    bus_wdata = align.write_data;
    if (control.mem_write) bus_be = align.byte_enable; else bus_be = 4b0000;

    // --- read port: a load's address, else the pc's next value (see the header) ---
    bus_load = control.mem_read;
    if (control.mem_read) bus_raddr = alu_unit.result; else bus_raddr = pc_unit.next_pc;

    // --- write back ---
    pc_plus_4 = pc_unit.pc + 4;  // pc is still this instruction's own address until the state machine moves on
    reg_file.reg_write = control.reg_write;
    case (dec.ctrl.wb_sel) {
      Cpu.WbSel.MEM: reg_file.write_data = align.load_data;
      Cpu.WbSel.PC4: reg_file.write_data = pc_plus_4;
      Cpu.WbSel.IMM: reg_file.write_data = immediate_generator.immediate;
      default:       reg_file.write_data = alu_unit.result;
    }
    if (dec.ctrl.csr) reg_file.write_data = csrs.read_data;

    // --- CSRs (Zicsr): the old value goes to rd, the new one is written on the same edge ---
    csrs.addr = instruction[31:20];
    csrs.op = instruction[13:12];
    if (instruction[14]) csrs.src = c{27b0, instruction[19:15]}; else csrs.src = reg_file.read_data1;
    csrs.write = control.csr_write;
    csrs.mret = control.mret;

    // --- next pc ---
    pc_unit.pc_write = control.pc_write;
    pc_unit.pc_src = control.pc_src;
    if (dec.ctrl.jalr) target = alu_unit.result; else target = pc_unit.pc + immediate_generator.immediate;
    pc_unit.target_address = target;
    if (control.mret) pc_unit.vector = csrs.mepc; else pc_unit.vector = csrs.mtvec;

    // --- traps: decided in EXECUTE (trap_unit), recorded by csr_file on the edge control takes it ---
    traps.ctrl = dec.ctrl;
    traps.funct3 = instruction[14:12];
    traps.addr_low = alu_unit.result[1:0];
    traps.target_bit1 = target[1];
    traps.branch_taken = branch.taken;
    csrs.trap = control.take_trap;
    csrs.trap_pc = pc_unit.pc;
    csrs.trap_cause = traps.cause;
    case (traps.tval_sel) {
      Cpu.TvalSel.INSTRUCTION: csrs.trap_value = instruction;
      Cpu.TvalSel.ADDRESS:     csrs.trap_value = alu_unit.result;
      Cpu.TvalSel.TARGET:      csrs.trap_value = c{target[31:1], 1b0};
      default:                 csrs.trap_value = 0;
    }

    debug_pc = pc_unit.pc;
    debug_state = control.current_state;
    reg_file.debug_sel = debug_sel;
    debug_reg = reg_file.debug_reg;
  }
}
