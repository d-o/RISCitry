// Instruction decoder: instruction -> control signals. Purely combinational, no state.
// One case entry per RV32I opcode group; individual instructions within a group come from
// funct3/funct7 passing straight through (alu_op = {funct7[5], funct3}), so adding an
// instruction rarely adds a line here.
// The sequencing (which state comes next) lives in control_unit, not here.
module decoder (
    input instruction[32],
    output ctrl<Cpu.control>   // see cpu_defs.luc for the fields
  ) {

  sig opcode[7]
  sig funct3[3]
  sig funct7[7]
  sig uses_rd
  sig uses_rs1
  sig uses_rs2
  sig bad                    // illegal, readable internally (outputs can't be read in Lucid)
  sig csr_writes             // a CSR instruction that writes its CSR
  sig csr_exists             // instruction[31:20] is a CSR this core implements

  always {
    opcode = instruction[6:0]
    funct3 = instruction[14:12]
    funct7 = instruction[31:25]

    ctrl.alu_op = 4b0000
    ctrl.alu_src_a = 0
    ctrl.alu_src_b = 0
    ctrl.imm_type = Cpu.ImmType.I
    ctrl.wb_sel = Cpu.WbSel.ALU
    ctrl.reg_write = 0
    ctrl.mem_read = 0
    ctrl.mem_write = 0
    ctrl.branch = 0
    ctrl.jump = 0
    ctrl.jalr = 0
    ctrl.csr = 0
    ctrl.csr_write = 0
    ctrl.mret = 0
    ctrl.ecall = 0
    ctrl.ebreak = 0
    ctrl.wfi = 0
    bad = 0
    csr_writes = 0
    uses_rd = 0
    uses_rs1 = 0
    uses_rs2 = 0

    case (instruction[31:20]) {
      Cpu.CSR_MSTATUS:   csr_exists = 1
      Cpu.CSR_MISA:      csr_exists = 1
      Cpu.CSR_MIE:       csr_exists = 1
      Cpu.CSR_MTVEC:     csr_exists = 1
      Cpu.CSR_MSTATUSH:  csr_exists = 1
      Cpu.CSR_MSCRATCH:  csr_exists = 1
      Cpu.CSR_MEPC:      csr_exists = 1
      Cpu.CSR_MCAUSE:    csr_exists = 1
      Cpu.CSR_MTVAL:     csr_exists = 1
      Cpu.CSR_MIP:       csr_exists = 1
      Cpu.CSR_MVENDORID: csr_exists = 1
      Cpu.CSR_MARCHID:   csr_exists = 1
      Cpu.CSR_MIMPID:    csr_exists = 1
      Cpu.CSR_MHARTID:   csr_exists = 1
      default:           csr_exists = 0
    }

    case (opcode) {
      7h37: // LUI: rd = imm
        ctrl.imm_type = Cpu.ImmType.U
        ctrl.wb_sel = Cpu.WbSel.IMM
        ctrl.reg_write = 1
        uses_rd = 1

      7h17: // AUIPC: rd = pc + imm
        ctrl.imm_type = Cpu.ImmType.U
        ctrl.alu_src_a = 1
        ctrl.alu_src_b = 1
        ctrl.reg_write = 1
        uses_rd = 1

      7h6F: // JAL: rd = pc + 4, pc = pc + imm
        ctrl.imm_type = Cpu.ImmType.J
        ctrl.wb_sel = Cpu.WbSel.PC4
        ctrl.reg_write = 1
        ctrl.jump = 1
        uses_rd = 1

      7h67: // JALR: rd = pc + 4, pc = (rs1 + imm) & ~1; target comes from the ALU
        ctrl.imm_type = Cpu.ImmType.I
        ctrl.alu_src_b = 1
        ctrl.wb_sel = Cpu.WbSel.PC4
        ctrl.reg_write = 1
        ctrl.jalr = 1
        uses_rd = 1
        uses_rs1 = 1
        if (funct3 != 3b000) bad = 1

      7h63: // BRANCH: BEQ/BNE/BLT/BGE/BLTU/BGEU, condition from funct3
        ctrl.imm_type = Cpu.ImmType.B
        ctrl.alu_op = 4b1000 // sub; unused (branch_unit decides), kept so the ALU result is rs1 - rs2 in traces
        ctrl.branch = 1
        uses_rs1 = 1
        uses_rs2 = 1
        if (funct3 == 3b010 || funct3 == 3b011) bad = 1

      7h03: // LOAD: LB/LH/LW/LBU/LHU, address = rs1 + imm
        ctrl.imm_type = Cpu.ImmType.I
        ctrl.alu_src_b = 1
        ctrl.wb_sel = Cpu.WbSel.MEM
        ctrl.reg_write = 1
        ctrl.mem_read = 1
        uses_rd = 1
        uses_rs1 = 1
        if (funct3 == 3b011 || funct3 == 3b110 || funct3 == 3b111) bad = 1

      7h23: // STORE: SB/SH/SW, address = rs1 + imm
        ctrl.imm_type = Cpu.ImmType.S
        ctrl.alu_src_b = 1
        ctrl.mem_write = 1
        uses_rs1 = 1
        uses_rs2 = 1
        if (funct3 > 3b010) bad = 1

      7h13: // OP-IMM: bit 30 is part of the immediate, except for the shifts (SRLI vs SRAI)
        ctrl.imm_type = Cpu.ImmType.I
        ctrl.alu_src_b = 1
        ctrl.reg_write = 1
        uses_rd = 1
        uses_rs1 = 1
        if (funct3 == 3b101) ctrl.alu_op = c{funct7[5], funct3}; else ctrl.alu_op = c{1b0, funct3};
        if (funct3 == 3b001 && funct7 != 7h00) bad = 1
        if (funct3 == 3b101 && funct7 != 7h00 && funct7 != 7h20) bad = 1

      7h33: // OP: register-register ALU ops; only SUB and SRA may set funct7 = 0x20
        ctrl.alu_op = c{funct7[5], funct3}
        ctrl.reg_write = 1
        uses_rd = 1
        uses_rs1 = 1
        uses_rs2 = 1
        if (funct7 != 7h00 && !(funct7 == 7h20 && (funct3 == 3b000 || funct3 == 3b101))) bad = 1

      7h0F: // MISC-MEM: FENCE is a no-op on this in-order, single-memory core
        if (funct3 != 3b000) bad = 1

      7h73: // SYSTEM
        if (funct3 == 3b000) {
          // ECALL/EBREAK trap (trap_unit); MRET; WFI (control_unit waits in EXECUTE)
          if (instruction[31:7] == Cpu.MRET_HI) {
            ctrl.mret = 1
          } else if (instruction[31:7] == 25h0) {
            ctrl.ecall = 1
          } else if (instruction[31:7] == 25h2000) {
            ctrl.ebreak = 1
          } else if (instruction[31:7] == Cpu.WFI_HI) {
            ctrl.wfi = 1
          } else {
            bad = 1
          }
        } else if (funct3 == 3b100) {
          bad = 1
        } else {
          // Zicsr: funct3[2] = immediate form (zimm in the rs1 field, not a register);
          // funct3[1:0] = 01 write, 10 set, 11 clear. Set/clear with x0 or zimm 0 only read.
          ctrl.csr = 1
          ctrl.reg_write = 1
          uses_rd = 1
          uses_rs1 = !funct3[2]
          csr_writes = !(funct3[1] && instruction[19:15] == 5b0)
          ctrl.csr_write = csr_writes
          if (!csr_exists) bad = 1
          if (instruction[31:30] == 2b11 && csr_writes) bad = 1    // a read-only CSR
        }

      default:
        bad = 1
    }

    // RV32E has only x0-x15: a register field with bit 4 set is illegal where that field is used.
    if ((uses_rd && instruction[11]) || (uses_rs1 && instruction[19]) || (uses_rs2 && instruction[24])) bad = 1

    ctrl.illegal = bad
    if (bad) {
      ctrl.csr = 0
      ctrl.csr_write = 0
      ctrl.mret = 0
      ctrl.ecall = 0
      ctrl.ebreak = 0
      ctrl.wfi = 0
      ctrl.reg_write = 0
      ctrl.mem_read = 0
      ctrl.mem_write = 0
      ctrl.branch = 0
      ctrl.jump = 0
      ctrl.jalr = 0
    }
  }
}
