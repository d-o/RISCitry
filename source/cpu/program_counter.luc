module program_counter (
    input clk,                  // Clock signal
    input rst,                  // Reset signal
    input ce,                // clock enable: on a clock with ce = 0 nothing here changes
    input pc_write,             // 1 = update PC, 0 = stall PC
    input pc_src[2],            // 00 = PC+4, 01 = Branch/JAL target, 10 = JALR target, 11 = vector
    input target_address[32],   // Address from ALU/Immediate generator
    input vector[32],           // pc_src 11: MRET's return address (mepc)
    output pc[32],              // Current PC
    output next_pc[32]          // The value pc takes on the next clock (fetch address when pc_write)
  ) {

  // Create a 32-bit D Flip-Flop register clocked by clk and reset by rst
  // It automatically initializes to 0 on reset
  dff pc_reg[32](#INIT(0), .clk(clk), .rst(rst)); 
  
  sig selected_pc[32];          // Combinational signal for the mux output
  sig new_pc[32];               // what pc_reg loads: selected_pc, or pc_reg.q when stalled

  always {
    // 1. Output the current register value to the Instruction Memory
    pc = pc_reg.q;

    // 2. The Multiplexer logic (using a case statement)
    case (pc_src) {
      2b00: selected_pc = pc_reg.q + 4;                    // Normal execution
      2b01: selected_pc = target_address;                  // JAL or taken Branch
      2b10: selected_pc = target_address & 32hFFFFFFFE;    // JALR (spec requires clearing LSB)
      2b11: selected_pc = vector;                          // MRET
      default: selected_pc = pc_reg.q + 4;
    }

    // 3. Register input logic
    if (pc_write) {
      new_pc = selected_pc;     // Feed the selected address into the flip-flop
    } else {
      new_pc = pc_reg.q;        // Hold current value (stall)
    }
    pc_reg.d = new_pc;
    next_pc = new_pc;

    if (!ce) {        // disabled clock: hold everything
      pc_reg.d = pc_reg.q
    }
  }
}
