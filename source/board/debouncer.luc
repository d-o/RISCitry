// Button synchroniser + debouncer: out goes high once in has been high for 2^BITS clocks in a row,
// and low as soon as in is low. (Alchitry's button_conditioner does the same, but its pipeline
// component turns into Verilog that Yosys rejects in Alchitry Labs 2.0.57.)
module debouncer #(
    BITS = 21 : BITS > 0     // 2^21 clocks = 21 ms at 100 MHz
  ) (
    input clk,
    input in,                // raw button, active high
    output out
  ) {

  .clk(clk) {
    dff sync0                // two flip-flops: in is asynchronous to clk
    dff sync1
    dff count[BITS+1]        // counts up to 2^BITS and stops: the top bit is out, so neither the
                             // output nor the counter's enable needs a 21-input AND (one straight
                             // into the step logic missed 100 MHz; a registered one still fed
                             // the counter's enable and missed it again, 2026-10-16)
  }

  always {
    sync0.d = in
    sync1.d = sync0.q
    out = count.q[BITS]

    if (!sync1.q) count.d = 0; else if (!count.q[BITS]) count.d = count.q + 1;
  }
}
