// GENERATED by tools/gen_cpu_tb.py from the ROM in instruction_mem.luc, run on tools/rv32sim.py.
// Do not edit; rerun the script after changing the ROM.
// Checks pc and x1 after each of 34 instructions, 2 clocks apart.
testbench cpu_tb {
    sig clk
    sig rst

    cpu dut(.clk(clk), .rst(rst))

    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $tick()
    }

    fun step(pc[32], x1[32]) {
        $tick_clock()
        $tick_clock()
        if (dut.debug_pc != pc || dut.debug_x1 != x1)
            $print("got pc=%h x1=%h, want pc=%h x1=%h", dut.debug_pc, dut.debug_x1, pc, x1)
        $assert(dut.debug_pc == pc)
        $assert(dut.debug_x1 == x1)
    }

    test larson {
        clk = 0
        rst = 1
        $tick_clock()
        $tick_clock()
        rst = 0
        $assert(dut.debug_pc == 0)
        $step(32h0000007C, 32h00000000) // 0x0000: 07C0006F -> led 00000000
        $step(32h00000048, 32h00000080) // 0x007c: FCDFF0EF -> led 10000000
        $step(32h0000004C, 32h00000040) // 0x0048: 0010D093 -> led 01000000
        $step(32h00000050, 32h00000020) // 0x004c: 0010D093 -> led 00100000
        $step(32h00000054, 32h00000010) // 0x0050: 0010D093 -> led 00010000
        $step(32h00000058, 32h00000008) // 0x0054: 0010D093 -> led 00001000
        $step(32h0000005C, 32h00000004) // 0x0058: 0010D093 -> led 00000100
        $step(32h00000060, 32h00000002) // 0x005c: 0010D093 -> led 00000010
        $step(32h00000064, 32h00000001) // 0x0060: 0010D093 -> led 00000001
        $step(32h00000068, 32h00000002) // 0x0064: 00109093 -> led 00000010
        $step(32h0000006C, 32h00000004) // 0x0068: 00109093 -> led 00000100
        $step(32h00000070, 32h00000008) // 0x006c: 00109093 -> led 00001000
        $step(32h00000074, 32h00000010) // 0x0070: 00109093 -> led 00010000
        $step(32h00000078, 32h00000020) // 0x0074: 00109093 -> led 00100000
        $step(32h0000007C, 32h00000040) // 0x0078: 00109093 -> led 01000000
        $step(32h00000048, 32h00000080) // 0x007c: FCDFF0EF -> led 10000000
