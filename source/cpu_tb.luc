testbench cpu_larson_tb {
    sig clk
    sig rst
    sig sel[4]

    cpu dut(#PROGRAM_ID(Programs.Id.LARSON), #SIM_RAM(1), .clk(clk), .rst(rst), .debug_sel(sel))

    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    test run {
        clk = 0
        sel = 0
        rst = 1
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // 0x0000: jal x0, turn
        $tick_clock()
        $tick_clock()
        $expect_pc(32h0000007C)
        $expect_reg(4d0, 32h00000000)
        // 0x007c: jal x1, right
        $tick_clock()
        $tick_clock()
        $expect_pc(32h00000048)
        $expect_reg(4d1, 32h00000080)
        // 0x0048: srli x1, x1, 1
        $tick_clock()
        $tick_clock()
        $expect_pc(32h0000004C)
        $expect_reg(4d1, 32h00000040)
        // 0x004c: srli x1, x1, 1
        $tick_clock()
        $tick_clock()
        $expect_pc(32h00000050)
        $expect_reg(4d1, 32h00000020)
