// Machine timer: mtime and mtimecmp (64 bits each, read and written as 32-bit words) and the
// timer interrupt request MTIP = mtime >= mtimecmp.
//
// mtime counts real time: one tick every TICK_DIV clocks, whether or not the cpu is enabled (ce),
// so it keeps counting while the front panel has the cpu stopped, stepping or running slowly
// (TICK_DIV 25 on the board's 25 MHz clock = 1 us ticks). That's what the spec asks for, and what
// a real WFI needs. STOPTIME = 1 gives the old behaviour (until 2026-10-16): mtime counts only
// enabled clocks, i.e. cpu clocks, and stops when the cpu does (like the debug spec's
// dcsr.stoptime). With ce on every clock and TICK_DIV 1 the two are the same, which is how the
// lockstep tests keep "mtime = clocks" (rv32sim's timer_rate covers ce on one clock in N).
// mtime is 0 after reset; a write replaces the written half on that edge (no increment of that
// edge). Writes are taken only on enabled clocks (a store's bus signals are held through the
// disabled ones). mtimecmp is all ones after reset (no interrupt until software sets it).
//
// MTIP is registered: the comparison of this clock's values is seen on the next one, which keeps
// the 64-bit compare off the cpu's trap path. A store to mtimecmp in an instruction's last cycle
// is therefore seen by the next instruction's EXECUTE.
module timer #(
    TICK_DIV = 1 : TICK_DIV >= 1 && TICK_DIV <= 256,   // clocks per mtime tick
    STOPTIME = 0 : STOPTIME == 0 || STOPTIME == 1      // 1: count only enabled clocks
  ) (
    input clk,
    input rst,
    input ce,                // cpu clock enable: writes only when 1; mtime ignores it unless STOPTIME
    input sel_write,         // a word store to the timer this clock
    input waddr[2],          // word within the timer: 0 mtime, 1 mtimeh, 2 mtimecmp, 3 mtimecmph
    input wdata[32],
    input raddr[2],          // the word a load reads (registered by the computer)
    output rdata[32],
    output mtip              // timer interrupt pending (mip.MTIP)
  ) {

  .clk(clk), .rst(rst) {
    dff mtime[64]
    dff mtimecmp[64](#INIT(64hFFFFFFFFFFFFFFFF))
    dff pending
    dff prescale[8]          // clocks since the last tick
  }

  sig counting               // mtime advances on this clock (if a tick is due)

  always {
    counting = ce || !STOPTIME
    if (counting) {
      if (prescale.q == TICK_DIV - 1) {
        prescale.d = 0
        mtime.d = mtime.q + 1
      } else {
        prescale.d = prescale.q + 1
      }
    }
    if (sel_write && ce) {
      case (waddr) {
        2d0: mtime.d = c{mtime.q[63:32], wdata}
        2d1: mtime.d = c{wdata, mtime.q[31:0]}
        2d2: mtimecmp.d = c{mtimecmp.q[63:32], wdata}
        default: mtimecmp.d = c{wdata, mtimecmp.q[31:0]}
      }
    }
    if (counting) pending.d = mtime.q >= mtimecmp.q;
    mtip = pending.q

    case (raddr) {
      2d0: rdata = mtime.q[31:0]
      2d1: rdata = mtime.q[63:32]
      2d2: rdata = mtimecmp.q[31:0]
      default: rdata = mtimecmp.q[63:32]
    }
  }
}
