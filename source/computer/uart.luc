// Memory-mapped UART: the transmitter's bus side runs on the cpu clock, the serializer on io_clk.
// The cpu clock is slow, stoppable and changes speed, so it can't time a baud rate; io_clk is the
// free-running board clock.
//
// Handshake across the two clocks (a one-byte buffer):
//   cpu side: a write while not busy saves the byte and flips req.
//   io side:  sees req (two-flip-flop synchroniser) differ from ack; when the serializer is idle
//             it sets ack = req and raises new_data for two io clocks (issue), and the
//             serializer takes the byte on the first of those edges it sees.
//   cpu side: busy = req != ack (ack synchronised back). Busy clears when the byte is taken, so
//             the next byte can be written while this one is still being sent.
// data only changes while not busy, i.e. while the io side isn't reading it, so it crosses
// safely: by the time the io side sees req change, data has been stable for two io clocks.
// A write while busy is dropped; programs poll STATUS first.
//
// Why issue and not "new_data = 1 and ack = req when !serializer.busy" (the first version): that
// makes ack and the serializer's state change on the same edge, each decided from the other's
// pre-edge value. Hardware updates them together; the Alchitry simulator (2.0.57) updates one
// instance at a time in a random order, so ack sometimes saw the post-edge busy (byte sent twice)
// or the serializer the post-edge new_data (byte dropped). Now ack depends only on this module's
// state on the edge the serializer accepts, and new_data is high for two edges, so either order
// gives the same result.
//
// Receiver (2026-10-18): always on, like buttons.luc. It is a state machine of its own in this
// module, running on `clk` every clock whatever ce does (clk is the free-running board clock;
// CLK_FREQ is its frequency too), so a byte arriving while the cpu is slow, stopped or asleep in a
// WFI is still caught and raises the interrupt. Not the bundled uart_rx: its one-clock new_data
// pulse would cross between two instances, which the Alchitry simulator orders at random.
// 8N1: a falling edge starts it, the line is checked again half a bit later (a glitch is dropped),
// each bit is sampled mid-bit, and the byte is delivered at the middle of the stop bit if that is
// high (a low stop bit = framing error: the byte is dropped and the line waited high).
// One byte of buffering: rx_byte/rx_valid. Reading RXDATA pops (valid clears on that cpu clock's
// edge, taken with the ce pulse that carried the load). A byte that arrives while one is still
// unread is dropped and the overrun flag set (the old byte is kept, as a 16550 does); STATUS
// reports it and a store of a 1 to STATUS bit 2 clears it. rx_irq = valid (a level).
module uart #(
    CLK_FREQ = 100_000_000 : CLK_FREQ > 0,           // io_clk frequency
    BAUD = 1_000_000 : BAUD > 0 && BAUD <= CLK_FREQ / 2
  ) (
    input clk,               // cpu clock (bus side)
    input rst,               // cpu reset
    input ce,                // cpu clock enable (bus side only; the io side always runs)
    input io_clk,            // free-running clock the baud rate comes from
    input io_rst,
    input write,             // a store to TXDATA wrote byte lane 0 this cpu clock
    input write_data[8],
    output busy,             // STATUS bit 0: a byte is waiting to be taken; a write now is dropped
    output tx,               // serial out, idle high
    input rx,                // serial in, idle high (asynchronous: synchronised here)
    input rx_read,           // a load of RXDATA this clock: pops the byte (on a ce clock)
    input clear_overrun,     // a store of a 1 to STATUS bit 2 this clock (on a ce clock)
    output rx_data[8],       // the received byte
    output rx_valid,         // a byte is waiting: RXDATA bit 8, STATUS bit 1
    output rx_overrun,       // a byte was dropped because the last was unread: STATUS bit 2
    output rx_irq            // the interrupt line: rx_valid
  ) {

  const CLK_PER_BIT = (CLK_FREQ + BAUD) / BAUD - 1    // clocks per bit, as the bundled uart_tx counts
  const CTR_SIZE = $clog2(CLK_PER_BIT)
  enum RxState {IDLE, HALF, DATA, STOP, WAIT_HIGH}

  .clk(clk), .rst(rst) {
    dff req
    dff ack_sync0
    dff ack_sync1
  }
  dff data[8](.clk(clk))

  .clk(clk), .rst(io_rst) {
    dff rx_state[$width(RxState)]
    dff rx_ctr[CTR_SIZE]
    dff rx_bits[3]
    dff rx_shift[8]
  }
  .clk(clk), .rst(rst) {
    dff rx_sync[3]           // three flip-flops: the line is asynchronous (rx_sync.q[2] is the oldest)
    dff rx_byte[8]
    dff rx_full
    dff rx_over
  }

  .clk(io_clk), .rst(io_rst) {
    dff req_sync0
    dff req_sync1
    dff ack
    dff issue[2]           // new_data for this io clock [0] and the next [1]
    uart_tx serializer(#CLK_FREQ(CLK_FREQ), #BAUD(BAUD));
  }

  sig pending
  sig rx_got               // the receiver finished a byte this clock
  sig rx_pop

  always {
    // cpu side
    ack_sync0.d = ack.q
    ack_sync1.d = ack_sync0.q
    pending = req.q != ack_sync1.q
    busy = pending
    if (write && !pending) {
      data.d = write_data
      req.d = ~req.q
    }

    if (!ce) {        // disabled cpu clock: the bus side holds
      ack_sync0.d = ack_sync0.q
      ack_sync1.d = ack_sync1.q
      data.d = data.q
      req.d = req.q
    }

    // io side
    req_sync0.d = req.q
    req_sync1.d = req_sync0.q
    serializer.data = data.q
    serializer.new_data = issue.q[0]
    if (issue.q != 0) {
      issue.d = c{1b0, issue.q[1]}
    } else if (req_sync1.q != ack.q && !serializer.busy) {
      issue.d = 2b11
      ack.d = req_sync1.q
    }
    tx = serializer.tx

    // receiver: every clock, ce or not
    rx_sync.d = c{rx_sync.q[1:0], rx}
    rx_got = 0
    case (rx_state.q) {
      RxState.IDLE:
        rx_ctr.d = 0
        rx_bits.d = 0
        if (!rx_sync.q[2]) rx_state.d = RxState.HALF       // a falling edge: the start bit
      RxState.HALF:
        rx_ctr.d = rx_ctr.q + 1
        if (rx_ctr.q == (CLK_PER_BIT >> 1)) {              // mid start bit
          rx_ctr.d = 0
          if (rx_sync.q[2]) rx_state.d = RxState.IDLE; else rx_state.d = RxState.DATA;
        }
      RxState.DATA:
        rx_ctr.d = rx_ctr.q + 1
        if (rx_ctr.q == CLK_PER_BIT - 1) {                 // mid data bit
          rx_ctr.d = 0
          rx_shift.d = c{rx_sync.q[2], rx_shift.q[7:1]}
          rx_bits.d = rx_bits.q + 1
          if (rx_bits.q == 7) rx_state.d = RxState.STOP;
        }
      RxState.STOP:
        rx_ctr.d = rx_ctr.q + 1
        if (rx_ctr.q == CLK_PER_BIT - 1) {                 // mid stop bit
          rx_ctr.d = 0
          if (rx_sync.q[2]) {
            rx_got = 1
            rx_state.d = RxState.IDLE
          } else {
            rx_state.d = RxState.WAIT_HIGH                 // framing error: drop the byte
          }
        }
      RxState.WAIT_HIGH:
        if (rx_sync.q[2]) rx_state.d = RxState.IDLE;
      default:
        rx_state.d = RxState.IDLE
    }

    // the cpu side of the receiver: pops and clears wait for a ce clock, arrivals don't
    rx_pop = rx_read && ce
    rx_full.d = (rx_full.q && !rx_pop) || rx_got
    if (rx_got && (!rx_full.q || rx_pop)) rx_byte.d = rx_shift.q;
    rx_over.d = (rx_over.q && !(clear_overrun && ce)) || (rx_got && rx_full.q && !rx_pop)
    rx_data = rx_byte.q & 8x{rx_full.q}        // an empty receiver reads 0
    rx_valid = rx_full.q
    rx_overrun = rx_over.q
    rx_irq = rx_full.q
  }
}
