// The computer: the cpu plus everything it reaches by address (main RAM, UART, switches, timer,
// buttons, the 7-segment display).
// The bus side of everything here runs on the cpu clock; machine.luc decides when that ticks.
// The UART's serializer also needs a steady clock for its baud rate: io_clk.
//
// It's a module rather than wiring inside machine so cpu_tb can test the real cpu-to-memory
// wiring: a testbench can only connect an instance to ones declared before it, and the cpu and
// its memories feed each other.
//
// One address space for code and data (von Neumann). The cpu has one read port (instruction
// fetches and loads; bus_load = 1 for a load) and one write port; main_ram has one of each, so a
// store and the next fetch happen on the same edge. Reads come back one clock after the address,
// like the block RAM, so device read data is registered here too.
//
// Decoding follows MemMap (memory_map.luc, generated from tools/memmap.py): full decode, so
// unmapped addresses ignore writes and read 0. Devices answer loads only: a fetch from the UART
// (or anywhere unmapped) reads 0, an illegal instruction, which the cpu treats as a NOP.
module computer #(
    PROGRAM_ID = 0,          // the program main RAM starts with: a Programs.Id
    SIM_RAM = 0 : SIM_RAM == 0 || SIM_RAM == 1,  // 1 in testbenches: main RAM uses its Lucid model
    UART_CLK_FREQ = 100_000_000 : UART_CLK_FREQ > 0,   // io_clk frequency
    UART_BAUD = 1_000_000 : UART_BAUD > 0 && UART_BAUD <= UART_CLK_FREQ / 2
  ) (
    input clk,
    input rst,
    input io_clk,            // free-running clock for the UART's baud rate
    input io_rst,
    output uart_tx,
    input switches[8],       // read-only switch register (already synchronised)
    input buttons[4],        // debounced push buttons: interrupt source (buttons.luc synchronises)
    output display_chars[32],   // the 7-segment display's four characters (lane 0 = leftmost) ...
    output display_owned,    // ... once the program has written them: until then the board shows the pc
    input debug_sel[4],      // which register debug_reg shows
    output debug_pc[32],     // address of the instruction being fetched/executed
    output debug_reg[32],    // register x[debug_sel]
    output debug_state[Cpu.STATE_BITS]   // the cpu's control state; FETCH = between instructions
  ) {

  .clk(clk) {
    cpu core(.rst(rst));
    main_ram ram(#WORDS(MemMap.RAM_WORDS), #PROGRAM_ID(PROGRAM_ID), #SIM_MODEL(SIM_RAM));
    uart uart0(#CLK_FREQ(UART_CLK_FREQ), #BAUD(UART_BAUD), .rst(rst));
    timer timer0(.rst(rst));
    buttons buttons0(.rst(rst));
    display_chars display0(.rst(rst));
    // no reset, like the RAM's own read register: the read on reset's last edge (address 0) is
    // the first instruction, and FETCH must see it come from the RAM
    dff read_ram           // the previous clock's read address was in the RAM
    dff io_read[32](.rst(rst))   // device read data for the previous clock's address
  }

  sig ram_rsel             // the read port's address (fetch or load) is in the RAM
  sig ram_wsel             // the write port's address is in the RAM
  sig uart_rsel
  sig uart_wsel
  sig switches_rsel
  sig timer_rsel
  sig timer_wsel
  sig buttons_rsel
  sig buttons_wsel
  sig display_rsel
  sig display_wsel

  always {
    // --- address decode: reads by the read port, stores by the write port ---
    ram_rsel = (core.bus_raddr >> MemMap.RAM_ADDR_BITS) == (MemMap.RAM_BASE >> MemMap.RAM_ADDR_BITS)
    ram_wsel = (core.bus_waddr >> MemMap.RAM_ADDR_BITS) == (MemMap.RAM_BASE >> MemMap.RAM_ADDR_BITS)
    uart_rsel = core.bus_load && (core.bus_raddr >> MemMap.UART_ADDR_BITS) == (MemMap.UART_BASE >> MemMap.UART_ADDR_BITS)
    uart_wsel = (core.bus_waddr >> MemMap.UART_ADDR_BITS) == (MemMap.UART_BASE >> MemMap.UART_ADDR_BITS)
    switches_rsel = core.bus_load && (core.bus_raddr >> MemMap.SWITCHES_ADDR_BITS) == (MemMap.SWITCHES_BASE >> MemMap.SWITCHES_ADDR_BITS)
    timer_rsel = core.bus_load && (core.bus_raddr >> MemMap.TIMER_ADDR_BITS) == (MemMap.TIMER_BASE >> MemMap.TIMER_ADDR_BITS)
    timer_wsel = (core.bus_waddr >> MemMap.TIMER_ADDR_BITS) == (MemMap.TIMER_BASE >> MemMap.TIMER_ADDR_BITS)

    // --- timer: word stores only (sb/sh to it are ignored) ---
    timer0.sel_write = timer_wsel && core.bus_be == 4b1111
    timer0.waddr = core.bus_waddr[3:2]
    timer0.wdata = core.bus_wdata
    timer0.raddr = core.bus_raddr[3:2]
    core.irq_timer = timer0.mtip

    // --- buttons: external interrupt source ---
    buttons_rsel = core.bus_load && (core.bus_raddr >> MemMap.BUTTONS_ADDR_BITS) == (MemMap.BUTTONS_BASE >> MemMap.BUTTONS_ADDR_BITS)
    buttons_wsel = (core.bus_waddr >> MemMap.BUTTONS_ADDR_BITS) == (MemMap.BUTTONS_BASE >> MemMap.BUTTONS_ADDR_BITS)
    buttons0.level = buttons
    buttons0.clear = buttons_wsel && core.bus_be[0]
    buttons0.clear_mask = core.bus_wdata[7:0]
    core.irq_external = buttons0.irq

    // --- 7-segment display: four characters, one per byte lane ---
    display_rsel = core.bus_load && (core.bus_raddr >> MemMap.DISPLAY_ADDR_BITS) == (MemMap.DISPLAY_BASE >> MemMap.DISPLAY_ADDR_BITS)
    display_wsel = (core.bus_waddr >> MemMap.DISPLAY_ADDR_BITS) == (MemMap.DISPLAY_BASE >> MemMap.DISPLAY_ADDR_BITS)
    display0.write = display_wsel && core.bus_be != 0
    display0.be = core.bus_be
    display0.wdata = core.bus_wdata
    display_chars = display0.chars
    display_owned = display0.owned

    // --- RAM: word addresses ---
    ram.raddr = core.bus_raddr[MemMap.RAM_ADDR_BITS-1:2]
    ram.waddr = core.bus_waddr[MemMap.RAM_ADDR_BITS-1:2]
    ram.wdata = core.bus_wdata
    if (ram_wsel) ram.be = core.bus_be; else ram.be = 4b0000;

    // --- UART: TXDATA at +0 (byte lane 0 sends), STATUS at +4 ---
    uart0.io_clk = io_clk
    uart0.io_rst = io_rst
    uart0.write = uart_wsel && !core.bus_waddr[2] && core.bus_be[0]
    uart0.write_data = core.bus_wdata[7:0]
    uart_tx = uart0.tx

    // --- read data, one clock after the address ---
    read_ram.d = ram_rsel
    io_read.d = 0
    if (uart_rsel && core.bus_raddr[2]) io_read.d = c{31b0, uart0.busy};
    if (switches_rsel) io_read.d = c{24b0, switches};
    if (timer_rsel) io_read.d = timer0.rdata;
    if (buttons_rsel) io_read.d = buttons0.rdata;
    if (display_rsel) io_read.d = display0.chars;
    if (read_ram.q) core.bus_rdata = ram.rdata; else core.bus_rdata = io_read.q;

    core.debug_sel = debug_sel
    debug_pc = core.debug_pc
    debug_reg = core.debug_reg
    debug_state = core.debug_state
  }
}
