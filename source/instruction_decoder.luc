module instruction_decoder (
    input instruction[32],     // The 32-bit raw instruction from memory
    output opcode[7],          // Opcode field
    output rd[5],              // Destination register index (0 to 15 for RV32E)
    output funct3[3],          // Minor opcode field
    output rs1[5],             // Source register 1 index
    output rs2[5],             // Source register 2 index
    output funct7[7]           // Secondary minor opcode field
  ) {

  always {
    // Lucid allows direct, clean combinational slicing of the input bus
    opcode = instruction[6:0];
    rd     = instruction[11:7];
    funct3 = instruction[14:12];
    rs1    = instruction[19:15];
    rs2    = instruction[24:20];
    funct7 = instruction[31:25];
  }
}
