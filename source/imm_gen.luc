module imm_gen (
    input instruction[32],     // V2 style port width array
    input opcode[7],           
    output immediate[32]       
  ) {

  always {
    case (opcode) {
      // 1. I-Type Arithmetic constants (like ADDI)
      7h13:
        immediate = c{ 20x{instruction[31]}, instruction[31:20] };

      // 2. I-Type Memory Loads (like LW)
      7h03:
        immediate = c{ 20x{instruction[31]}, instruction[31:20] };

      // 3. S-Type Memory Stores (like SW)
      7h23:
        immediate = c{ 20x{instruction[31]}, instruction[31:25], instruction[11:7] };

      // 4. B-Type Branches (like BNE/BEQ)
      7h63:
        immediate = c{ 20x{instruction[31]}, instruction[7], instruction[30:25], instruction[11:8], 1b0 };

      // 5. J-Type Unconditional Jumps (like JAL)
      7h6F:
        immediate = c{ 12x{instruction[31]}, instruction[19:12], instruction[20], instruction[30:21], 1b0 };

      // Default fallback
      default:
        immediate = 32h0;
    }
  }
}
