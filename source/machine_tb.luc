// GENERATED by tools/gen_machine_tb.py, checked against tools/rv32sim.py. Do not edit; rerun the script.
// The run/step clock sequencer: single-steps the MEMORY program, then run/stop and reset.
testbench machine_tb {
    sig clk
    sig rst
    sig run
    sig fast
    sig step
    sig sel[4]

    machine dut(#PROGRAM_ID(Programs.Id.MEMORY), #SIM_RAM(1), #SLOW_BITS(3), #FAST_BITS(1),
                .clk(clk), .rst(rst), .run(run), .fast(fast), .step(step), .debug_sel(sel))

    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $tick()
    }

    fun settle() {
        repeat(i, 64) { $tick_clock(); }
    }

    fun expect_stopped_at(pc[32]) {
        if (dut.debug_pc != pc || !dut.halted)
            $print("pc: got %h want %h, halted %b", dut.debug_pc, pc, dut.halted)
        $assert(dut.debug_pc == pc)
        $assert(dut.halted)
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    test step_run_reset {
        clk = 0
        rst = 1
        run = 0
        fast = 0
        step = 0
        sel = 0
        $tick_clock()
        $tick_clock()
        rst = 0
        $settle()
        $expect_stopped_at(32h00000000)
        $settle()
        $expect_stopped_at(32h00000000)   // stays stopped
        // step: 0x0000: addi x2, x0, 64
        step = 1
        $tick_clock()
        step = 0
        $settle()
        $expect_stopped_at(32h00000004)
        $expect_reg(4d2, 32h00000040)
        // step: 0x0004: lui x3, 0xdeadc
        step = 1
        $tick_clock()
        step = 0
        $settle()
        $expect_stopped_at(32h00000008)
        $expect_reg(4d3, 32hDEADC000)
        // step: 0x0008: addi x3, x3, -0x111
        step = 1
        $tick_clock()
        step = 0
        $settle()
        $expect_stopped_at(32h0000000C)
        $expect_reg(4d3, 32hDEADBEEF)
        // step: 0x000c: sw x3, 0(x2)
        step = 1
        $tick_clock()
        step = 0
        $settle()
        $expect_stopped_at(32h00000010)
        // step: 0x0010: sw x2, 4(x2)
        step = 1
        $tick_clock()
        step = 0
        $settle()
        $expect_stopped_at(32h00000014)
        // step: 0x0014: lw x4, 0(x2)
        step = 1
        $tick_clock()
        step = 0
        $settle()
        $expect_stopped_at(32h00000018)
        $expect_reg(4d4, 32hDEADBEEF)
        // step: 0x0018: lw x5, 4(x2)
        step = 1
        $tick_clock()
        step = 0
        $settle()
        $expect_stopped_at(32h0000001C)
        $expect_reg(4d5, 32h00000040)
        // run, with a step pulse that must be ignored, then stop: ends in the halt loop
        run = 1
        $tick_clock()
        step = 1
        $tick_clock()
        step = 0
        repeat(i, 64) {
            $tick_clock()
            $assert(!dut.halted)    // the stopped light stays off while running
        }
        repeat(i, 40) { $settle(); }
        run = 0
        $settle()
        $expect_stopped_at(32h0000003C)
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h00000000)
        $expect_reg(4d2, 32h00000040)
        $expect_reg(4d3, 32hDEADBEEF)
        $expect_reg(4d4, 32hDEADBEEF)
        $expect_reg(4d5, 32h00000040)
        $expect_reg(4d6, 32hDEADBF2F)
        $expect_reg(4d7, 32h00000000)
        $expect_reg(4d8, 32h00000048)
        $expect_reg(4d9, 32hDEADBEEF)
        $expect_reg(4d10, 32hDEADBF2F)
        $expect_reg(4d11, 32h00000000)
        $expect_reg(4d12, 32h00000000)
        $expect_reg(4d13, 32h00000000)
        $expect_reg(4d14, 32h00000000)
        $expect_reg(4d15, 32h00000000)
        // reset while stopped
        rst = 1
        $tick_clock()
        rst = 0
        $settle()
        $expect_stopped_at(32h00000000)
        $expect_reg(4d2, 32h00000000)
        // fast run reaches the halt loop too
        fast = 1
        run = 1
        repeat(i, 10) { $settle(); }
        run = 0
        $settle()
        $expect_stopped_at(32h0000003C)
        $expect_reg(4d10, 32hDEADBF2F)
    }
}
