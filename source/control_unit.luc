// Sequencer: decides which state comes next and gates the decoder's side effects by state.
// It never looks at the opcode; everything instruction-specific arrives in ctrl from decoder.luc.
//   FETCH -> EXECUTE -> FETCH                          (ALU ops, jumps, branches, LUI/AUIPC)
//   FETCH -> EXECUTE -> MEM_ACCESS -> FETCH            (stores)
//   FETCH -> EXECUTE -> MEM_ACCESS -> WRITEBACK -> FETCH (loads: the RAM read takes a cycle)
// Illegal instructions arrive with every side effect already off, so they act as a NOP.
module control_unit (
    input clk,
    input rst,
    input ctrl<Cpu.control>,
    input branch_taken,
    output pc_write,
    output pc_src[2],          // program_counter: 00 = pc + 4, 01 = pc + imm, 10 = JALR target
    output reg_write,
    output mem_write
  ) {

  enum State { FETCH, EXECUTE, MEM_ACCESS, WRITEBACK }

  dff state[$width(State)](#INIT(State.FETCH), .clk(clk), .rst(rst))

  always {
    pc_write = 0
    pc_src = 2b00
    reg_write = 0
    mem_write = 0

    case (state.q) {
      State.FETCH:
        state.d = State.EXECUTE

      State.EXECUTE:
        if (ctrl.mem_read || ctrl.mem_write) {
          state.d = State.MEM_ACCESS
        } else {
          reg_write = ctrl.reg_write
          pc_write = 1
          if (ctrl.jump || (ctrl.branch && branch_taken)) pc_src = 2b01;
          if (ctrl.jalr) pc_src = 2b10;
          state.d = State.FETCH
        }

      State.MEM_ACCESS:
        if (ctrl.mem_write) {
          mem_write = 1
          pc_write = 1
          state.d = State.FETCH
        } else {
          state.d = State.WRITEBACK
        }

      State.WRITEBACK:
        reg_write = ctrl.reg_write
        pc_write = 1
        state.d = State.FETCH

      default:
        state.d = State.FETCH
    }
  }
}
