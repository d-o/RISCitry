// GENERATED by tools/gen_decoder_tb.py from tools/rv32.py. Do not edit; rerun the script.
// Flattens the decoder's ctrl struct (layout in cpu_defs.luc) and compares it with
// the spec table. Illegal encodings only check the illegal flag and that side effects are off.
testbench decoder_tb {
    sig in_inst[32]
    sig got[24]

    decoder dut(.instruction(in_inst))

    fun check(inst[32], expected[24], mask[24]) {
        in_inst = inst
        $tick()
        got = $flatten(dut.ctrl)
        if ((got & mask) != expected)
            $print("inst=%h got=%b want=%b mask=%b", inst, got, expected, mask)
        $assert((got & mask) == expected)
    }

    test upper_and_jumps {
        in_inst = 0
        got = 0
        $check(32h123450B7, 24b000000000000011111000000, 24b111111111111111111111111) // lui rd=x1 rs1=x2 rs2=x3 imm=74565
        $check(32hFFFFF7B7, 24b000000000000011111000000, 24b111111111111111111111111) // lui rd=x15 rs1=x15 rs2=x15 imm=1048575
        $check(32h12345097, 24b000000000011011001000000, 24b111111111111111111111111) // auipc rd=x1 rs1=x2 rs2=x3 imm=74565
        $check(32hFFFFF797, 24b000000000011011001000000, 24b111111111111111111111111) // auipc rd=x15 rs1=x15 rs2=x15 imm=1048575
        $check(32h07C000EF, 24b000000000000100101000100, 24b111111111111111111111111) // jal rd=x1 rs1=x2 rs2=x3 imm=124
        $check(32hFCDFF7EF, 24b000000000000100101000100, 24b111111111111111111111111) // jal rd=x15 rs1=x15 rs2=x15 imm=-52
        $check(32h005100E7, 24b000000000001000101000010, 24b111111111111111111111111) // jalr rd=x1 rs1=x2 rs2=x3 imm=5
        $check(32hFFF787E7, 24b000000000001000101000010, 24b111111111111111111111111) // jalr rd=x15 rs1=x15 rs2=x15 imm=-1
        $check(32h1FFFF0B7, 24b000000000000011111000000, 24b111111111111111111111111) // lui with bits 19 and 24 set (rs1/rs2 positions, unused): legal
        $check(32h7FF7F0EF, 24b000000000000100101000100, 24b111111111111111111111111) // jal with bits 19 and 24 set: legal
    }

    test branches {
        in_inst = 0
        got = 0
        $check(32hFE310EE3, 24b000000100000010000001000, 24b111111111111111111111111) // beq rd=x1 rs1=x2 rs2=x3 imm=-4
        $check(32h06F78E63, 24b000000100000010000001000, 24b111111111111111111111111) // beq rd=x15 rs1=x15 rs2=x15 imm=124
        $check(32hFE311EE3, 24b000000100000010000001000, 24b111111111111111111111111) // bne rd=x1 rs1=x2 rs2=x3 imm=-4
        $check(32h06F79E63, 24b000000100000010000001000, 24b111111111111111111111111) // bne rd=x15 rs1=x15 rs2=x15 imm=124
        $check(32hFE314EE3, 24b000000100000010000001000, 24b111111111111111111111111) // blt rd=x1 rs1=x2 rs2=x3 imm=-4
        $check(32h06F7CE63, 24b000000100000010000001000, 24b111111111111111111111111) // blt rd=x15 rs1=x15 rs2=x15 imm=124
        $check(32hFE315EE3, 24b000000100000010000001000, 24b111111111111111111111111) // bge rd=x1 rs1=x2 rs2=x3 imm=-4
        $check(32h06F7DE63, 24b000000100000010000001000, 24b111111111111111111111111) // bge rd=x15 rs1=x15 rs2=x15 imm=124
        $check(32hFE316EE3, 24b000000100000010000001000, 24b111111111111111111111111) // bltu rd=x1 rs1=x2 rs2=x3 imm=-4
        $check(32h06F7EE63, 24b000000100000010000001000, 24b111111111111111111111111) // bltu rd=x15 rs1=x15 rs2=x15 imm=124
        $check(32hFE317EE3, 24b000000100000010000001000, 24b111111111111111111111111) // bgeu rd=x1 rs1=x2 rs2=x3 imm=-4
        $check(32h06F7FE63, 24b000000100000010000001000, 24b111111111111111111111111) // bgeu rd=x15 rs1=x15 rs2=x15 imm=124
    }

    test loads_stores {
        in_inst = 0
        got = 0
        $check(32h00510083, 24b000000000001000011100000, 24b111111111111111111111111) // lb rd=x1 rs1=x2 rs2=x3 imm=5
        $check(32hFFF78783, 24b000000000001000011100000, 24b111111111111111111111111) // lb rd=x15 rs1=x15 rs2=x15 imm=-1
        $check(32h00511083, 24b000000000001000011100000, 24b111111111111111111111111) // lh rd=x1 rs1=x2 rs2=x3 imm=5
        $check(32hFFF79783, 24b000000000001000011100000, 24b111111111111111111111111) // lh rd=x15 rs1=x15 rs2=x15 imm=-1
        $check(32h00512083, 24b000000000001000011100000, 24b111111111111111111111111) // lw rd=x1 rs1=x2 rs2=x3 imm=5
        $check(32hFFF7A783, 24b000000000001000011100000, 24b111111111111111111111111) // lw rd=x15 rs1=x15 rs2=x15 imm=-1
        $check(32h00514083, 24b000000000001000011100000, 24b111111111111111111111111) // lbu rd=x1 rs1=x2 rs2=x3 imm=5
        $check(32hFFF7C783, 24b000000000001000011100000, 24b111111111111111111111111) // lbu rd=x15 rs1=x15 rs2=x15 imm=-1
        $check(32h00515083, 24b000000000001000011100000, 24b111111111111111111111111) // lhu rd=x1 rs1=x2 rs2=x3 imm=5
        $check(32hFFF7D783, 24b000000000001000011100000, 24b111111111111111111111111) // lhu rd=x15 rs1=x15 rs2=x15 imm=-1
        $check(32h00310423, 24b000000000001001000010000, 24b111111111111111111111111) // sb rd=x1 rs1=x2 rs2=x3 imm=8
        $check(32h80F78023, 24b000000000001001000010000, 24b111111111111111111111111) // sb rd=x15 rs1=x15 rs2=x15 imm=-2048
        $check(32h00311423, 24b000000000001001000010000, 24b111111111111111111111111) // sh rd=x1 rs1=x2 rs2=x3 imm=8
        $check(32h80F79023, 24b000000000001001000010000, 24b111111111111111111111111) // sh rd=x15 rs1=x15 rs2=x15 imm=-2048
        $check(32h00312423, 24b000000000001001000010000, 24b111111111111111111111111) // sw rd=x1 rs1=x2 rs2=x3 imm=8
        $check(32h80F7A023, 24b000000000001001000010000, 24b111111111111111111111111) // sw rd=x15 rs1=x15 rs2=x15 imm=-2048
    }

    test op_imm {
        in_inst = 0
        got = 0
        $check(32h00510093, 24b000000000001000001000000, 24b111111111111111111111111) // addi rd=x1 rs1=x2 rs2=x3 imm=5
        $check(32hFFF78793, 24b000000000001000001000000, 24b111111111111111111111111) // addi rd=x15 rs1=x15 rs2=x15 imm=-1
        $check(32h00512093, 24b000000001001000001000000, 24b111111111111111111111111) // slti rd=x1 rs1=x2 rs2=x3 imm=5
        $check(32hFFF7A793, 24b000000001001000001000000, 24b111111111111111111111111) // slti rd=x15 rs1=x15 rs2=x15 imm=-1
        $check(32h00513093, 24b000000001101000001000000, 24b111111111111111111111111) // sltiu rd=x1 rs1=x2 rs2=x3 imm=5
        $check(32hFFF7B793, 24b000000001101000001000000, 24b111111111111111111111111) // sltiu rd=x15 rs1=x15 rs2=x15 imm=-1
        $check(32h00514093, 24b000000010001000001000000, 24b111111111111111111111111) // xori rd=x1 rs1=x2 rs2=x3 imm=5
        $check(32hFFF7C793, 24b000000010001000001000000, 24b111111111111111111111111) // xori rd=x15 rs1=x15 rs2=x15 imm=-1
        $check(32h00516093, 24b000000011001000001000000, 24b111111111111111111111111) // ori rd=x1 rs1=x2 rs2=x3 imm=5
        $check(32hFFF7E793, 24b000000011001000001000000, 24b111111111111111111111111) // ori rd=x15 rs1=x15 rs2=x15 imm=-1
        $check(32h00517093, 24b000000011101000001000000, 24b111111111111111111111111) // andi rd=x1 rs1=x2 rs2=x3 imm=5
        $check(32hFFF7F793, 24b000000011101000001000000, 24b111111111111111111111111) // andi rd=x15 rs1=x15 rs2=x15 imm=-1
        $check(32h00411093, 24b000000000101000001000000, 24b111111111111111111111111) // slli rd=x1 rs1=x2 rs2=x3 imm=4
        $check(32h01F79793, 24b000000000101000001000000, 24b111111111111111111111111) // slli rd=x15 rs1=x15 rs2=x15 imm=31
        $check(32h00415093, 24b000000010101000001000000, 24b111111111111111111111111) // srli rd=x1 rs1=x2 rs2=x3 imm=4
        $check(32h01F7D793, 24b000000010101000001000000, 24b111111111111111111111111) // srli rd=x15 rs1=x15 rs2=x15 imm=31
        $check(32h40415093, 24b000000110101000001000000, 24b111111111111111111111111) // srai rd=x1 rs1=x2 rs2=x3 imm=4
        $check(32h41F7D793, 24b000000110101000001000000, 24b111111111111111111111111) // srai rd=x15 rs1=x15 rs2=x15 imm=31
        $check(32h01010093, 24b000000000001000001000000, 24b111111111111111111111111) // addi imm=16 sets bit 24 (rs2 position) but rs2 is unused: legal
    }

    test op {
        in_inst = 0
        got = 0
        $check(32h003100B3, 24b000000000000000001000000, 24b111111111111111111111111) // add rd=x1 rs1=x2 rs2=x3 imm=0
        $check(32h00F787B3, 24b000000000000000001000000, 24b111111111111111111111111) // add rd=x15 rs1=x15 rs2=x15 imm=0
        $check(32h403100B3, 24b000000100000000001000000, 24b111111111111111111111111) // sub rd=x1 rs1=x2 rs2=x3 imm=0
        $check(32h40F787B3, 24b000000100000000001000000, 24b111111111111111111111111) // sub rd=x15 rs1=x15 rs2=x15 imm=0
        $check(32h003110B3, 24b000000000100000001000000, 24b111111111111111111111111) // sll rd=x1 rs1=x2 rs2=x3 imm=0
        $check(32h00F797B3, 24b000000000100000001000000, 24b111111111111111111111111) // sll rd=x15 rs1=x15 rs2=x15 imm=0
        $check(32h003120B3, 24b000000001000000001000000, 24b111111111111111111111111) // slt rd=x1 rs1=x2 rs2=x3 imm=0
        $check(32h00F7A7B3, 24b000000001000000001000000, 24b111111111111111111111111) // slt rd=x15 rs1=x15 rs2=x15 imm=0
        $check(32h003130B3, 24b000000001100000001000000, 24b111111111111111111111111) // sltu rd=x1 rs1=x2 rs2=x3 imm=0
        $check(32h00F7B7B3, 24b000000001100000001000000, 24b111111111111111111111111) // sltu rd=x15 rs1=x15 rs2=x15 imm=0
        $check(32h003140B3, 24b000000010000000001000000, 24b111111111111111111111111) // xor rd=x1 rs1=x2 rs2=x3 imm=0
        $check(32h00F7C7B3, 24b000000010000000001000000, 24b111111111111111111111111) // xor rd=x15 rs1=x15 rs2=x15 imm=0
        $check(32h003150B3, 24b000000010100000001000000, 24b111111111111111111111111) // srl rd=x1 rs1=x2 rs2=x3 imm=0
        $check(32h00F7D7B3, 24b000000010100000001000000, 24b111111111111111111111111) // srl rd=x15 rs1=x15 rs2=x15 imm=0
        $check(32h403150B3, 24b000000110100000001000000, 24b111111111111111111111111) // sra rd=x1 rs1=x2 rs2=x3 imm=0
        $check(32h40F7D7B3, 24b000000110100000001000000, 24b111111111111111111111111) // sra rd=x15 rs1=x15 rs2=x15 imm=0
        $check(32h003160B3, 24b000000011000000001000000, 24b111111111111111111111111) // or rd=x1 rs1=x2 rs2=x3 imm=0
        $check(32h00F7E7B3, 24b000000011000000001000000, 24b111111111111111111111111) // or rd=x15 rs1=x15 rs2=x15 imm=0
        $check(32h003170B3, 24b000000011100000001000000, 24b111111111111111111111111) // and rd=x1 rs1=x2 rs2=x3 imm=0
        $check(32h00F7F7B3, 24b000000011100000001000000, 24b111111111111111111111111) // and rd=x15 rs1=x15 rs2=x15 imm=0
    }

    test system {
        in_inst = 0
        got = 0
        $check(32h0000000F, 24b000000000000000000000000, 24b111111111111111111111111) // fence rd=x0 rs1=x0 rs2=x0 imm=0
        $check(32h00000073, 24b001000000000000000000000, 24b111111111111111111111111) // ecall rd=x0 rs1=x0 rs2=x0 imm=0
        $check(32h00100073, 24b010000000000000000000000, 24b111111111111111111111111) // ebreak rd=x0 rs1=x0 rs2=x0 imm=0
        $check(32h10500073, 24b100000000000000000000000, 24b111111111111111111111111) // wfi rd=x0 rs1=x0 rs2=x0 imm=0
        $check(32h30200073, 24b000100000000000000000000, 24b111111111111111111111111) // mret rd=x0 rs1=x0 rs2=x0 imm=0
    }

    test csr {
        in_inst = 0
        got = 0
        $check(32h340110F3, 24b000011000000000001000000, 24b111111111111111111111111) // csrrw rd=x1 rs1=x2 rs2=x0 imm=832
        $check(32h305797F3, 24b000011000000000001000000, 24b111111111111111111111111) // csrrw rd=x15 rs1=x15 rs2=x0 imm=773
        $check(32h340120F3, 24b000011000000000001000000, 24b111111111111111111111111) // csrrs rd=x1 rs1=x2 rs2=x0 imm=832
        $check(32h3057A7F3, 24b000011000000000001000000, 24b111111111111111111111111) // csrrs rd=x15 rs1=x15 rs2=x0 imm=773
        $check(32h340130F3, 24b000011000000000001000000, 24b111111111111111111111111) // csrrc rd=x1 rs1=x2 rs2=x0 imm=832
        $check(32h3057B7F3, 24b000011000000000001000000, 24b111111111111111111111111) // csrrc rd=x15 rs1=x15 rs2=x0 imm=773
        $check(32h340150F3, 24b000011000000000001000000, 24b111111111111111111111111) // csrrwi rd=x1 rs1=x2 rs2=x0 imm=832
        $check(32h3057D7F3, 24b000011000000000001000000, 24b111111111111111111111111) // csrrwi rd=x15 rs1=x15 rs2=x0 imm=773
        $check(32h340160F3, 24b000011000000000001000000, 24b111111111111111111111111) // csrrsi rd=x1 rs1=x2 rs2=x0 imm=832
        $check(32h3057E7F3, 24b000011000000000001000000, 24b111111111111111111111111) // csrrsi rd=x15 rs1=x15 rs2=x0 imm=773
        $check(32h340170F3, 24b000011000000000001000000, 24b111111111111111111111111) // csrrci rd=x1 rs1=x2 rs2=x0 imm=832
        $check(32h3057F7F3, 24b000011000000000001000000, 24b111111111111111111111111) // csrrci rd=x15 rs1=x15 rs2=x0 imm=773
        $check(32hF14020F3, 24b000001000000000001000000, 24b111111111111111111111111) // csrr x1, mhartid (csrrs with x0: read-only CSR, no write): legal
        $check(32h301070F3, 24b000001000000000001000000, 24b111111111111111111111111) // csrrci x1, misa, 0: no write
        $check(32h341FE173, 24b000011000000000001000000, 24b111111111111111111111111) // csrrsi zimm=31: the rs1 field isn't a register, so not an RV32E violation
    }

    test illegal {
        in_inst = 0
        got = 0
        $check(32h00000000, 24b000000000000000000000001, 24b011111000000000001111111) // all-zero word
        $check(32hFFFFFFFF, 24b000000000000000000000001, 24b011111000000000001111111) // all-ones word
        $check(32h0020A463, 24b000000000000000000000001, 24b011111000000000001111111) // branch funct3=010
        $check(32h0020B463, 24b000000000000000000000001, 24b011111000000000001111111) // branch funct3=011
        $check(32h00013083, 24b000000000000000000000001, 24b011111000000000001111111) // load funct3=011 (ld is RV64)
        $check(32h00016083, 24b000000000000000000000001, 24b011111000000000001111111) // load funct3=110 (lwu is RV64)
        $check(32h00017083, 24b000000000000000000000001, 24b011111000000000001111111) // load funct3=111
        $check(32h0020B023, 24b000000000000000000000001, 24b011111000000000001111111) // store funct3=011 (sd is RV64)
        $check(32h000110E7, 24b000000000000000000000001, 24b011111000000000001111111) // jalr funct3=001
        $check(32h40311093, 24b000000000000000000000001, 24b011111000000000001111111) // slli with funct7=0x20
        $check(32h02315093, 24b000000000000000000000001, 24b011111000000000001111111) // srli with funct7=0x01
        $check(32h023100B3, 24b000000000000000000000001, 24b011111000000000001111111) // mul (M extension, the old SUB-decode bug)
        $check(32h403110B3, 24b000000000000000000000001, 24b011111000000000001111111) // sll with funct7=0x20
        $check(32h403140B3, 24b000000000000000000000001, 24b011111000000000001111111) // xor with funct7=0x20
        $check(32hC00110F3, 24b000000000000000000000001, 24b011111000000000001111111) // csrrw cycle (not implemented)
        $check(32h7C0020F3, 24b000000000000000000000001, 24b011111000000000001111111) // csrr of a custom CSR (not implemented)
        $check(32hF1111073, 24b000000000000000000000001, 24b011111000000000001111111) // csrw mvendorid (read-only)
        $check(32hF140E073, 24b000000000000000000000001, 24b011111000000000001111111) // csrsi mhartid, 1 (read-only, writes)
        $check(32h300140F3, 24b000000000000000000000001, 24b011111000000000001111111) // SYSTEM funct3=100
        $check(32h34011873, 24b000000000000000000000001, 24b011111000000000001111111) // RV32E: csrrw rd=x16
        $check(32h3408A0F3, 24b000000000000000000000001, 24b011111000000000001111111) // RV32E: csrrs rs1=x17
        $check(32h10200073, 24b000000000000000000000001, 24b011111000000000001111111) // sret (no S mode)
        $check(32h302000F3, 24b000000000000000000000001, 24b011111000000000001111111) // mret with rd=1
        $check(32h00200073, 24b000000000000000000000001, 24b011111000000000001111111) // SYSTEM funct3=0 imm=2 (uret, not RV32I)
        $check(32h0000100F, 24b000000000000000000000001, 24b011111000000000001111111) // fence.i (Zifencei not supported)
        $check(32h00208833, 24b000000000000000000000001, 24b011111000000000001111111) // RV32E: rd=x16
        $check(32h002800B3, 24b000000000000000000000001, 24b011111000000000001111111) // RV32E: rs1=x16
        $check(32h01F100B3, 24b000000000000000000000001, 24b011111000000000001111111) // RV32E: rs2=x31
        $check(32h00001A37, 24b000000000000000000000001, 24b011111000000000001111111) // RV32E: lui rd=x20
        $check(32h00088463, 24b000000000000000000000001, 24b011111000000000001111111) // RV32E: beq rs2=x17
        $check(32h00192023, 24b000000000000000000000001, 24b011111000000000001111111) // RV32E: sw rs1=x18
        $check(32h000F80E7, 24b000000000000000000000001, 24b011111000000000001111111) // RV32E: jalr rs1=x31
    }
}
