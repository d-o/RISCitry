// GENERATED by tools/gen_machine_tb.py, checked against tools/rv32sim.py. Do not edit; rerun the script.
// The run/step clock sequencer: steps the MEMORY program by clock and by instruction,
// then run/stop and reset.
testbench machine_tb {
    sig clk
    sig rst
    sig run
    sig fast
    sig clock_step
    sig step
    sig sel[4]
    sig switches[8]
    sig buttons[4]

    machine dut(#PROGRAM_ID(Programs.Id.MEMORY), #SIM_RAM(1), #SLOW_BITS(3), #FAST_BITS(1),
                .clk(clk), .rst(rst), .run(run), .fast(fast), .clock_step(clock_step), .step(step),
                .switches(switches), .buttons(buttons), .debug_sel(sel))

    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $tick()
    }

    fun settle() {
        repeat(i, 64) { $tick_clock(); }
    }

    // a step pulse, then wait (busy while the step is under way)
    fun press_step() {
        step = 1
        $tick_clock()
        step = 0
        $tick_clock()
        $assert(dut.busy)
        $settle()
    }

    fun expect_stopped_at(pc[32], state[Cpu.STATE_BITS]) {
        if (dut.debug_pc != pc || dut.cpu_state != state || !dut.halted)
            $print("pc: got %h want %h, state %d want %d, halted %b", dut.debug_pc, pc, dut.cpu_state, state, dut.halted)
        $assert(dut.debug_pc == pc)
        $assert(dut.cpu_state == state)
        $assert(dut.halted)
        $assert(!dut.busy)
        $assert(!dut.cpu_clock)
        $assert(dut.uart_tx)       // MEMORY doesn't print: serial line idle high
        $assert(!dut.display_owned && dut.display_chars == 0)   // nor use the display
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    test step_run_reset {
        clk = 0
        rst = 1
        run = 0
        fast = 0
        clock_step = 0
        step = 0
        sel = 0
        switches = 0
        buttons = 0
        $tick_clock()
        $tick_clock()
        $assert(dut.in_reset)
        rst = 0
        $settle()
        $assert(!dut.in_reset)
        $expect_stopped_at(32h00000000, Cpu.State.FETCH)
        $settle()
        $expect_stopped_at(32h00000000, Cpu.State.FETCH)   // stays stopped
        clock_step = 1
        // clock steps: 0x0000: addi x2, x0, 0x400
        $press_step()
        $expect_stopped_at(32h00000000, Cpu.State.EXECUTE)
        $press_step()
        $expect_stopped_at(32h00000004, Cpu.State.FETCH)
        $expect_reg(4d2, 32h00000400)
        // one clock step into 0x0004: lui x3, 0xdeadc, then instruction mode
        clock_step = 1
        $press_step()
        $expect_stopped_at(32h00000004, Cpu.State.EXECUTE)
        clock_step = 0
        $settle()
        $expect_stopped_at(32h00000004, Cpu.State.EXECUTE)
        $press_step()
        $expect_stopped_at(32h00000008, Cpu.State.FETCH)
        $expect_reg(4d3, 32hDEADC000)
        clock_step = 0
        // step: 0x0008: addi x3, x3, -0x111
        $press_step()
        $expect_stopped_at(32h0000000C, Cpu.State.FETCH)
        $expect_reg(4d3, 32hDEADBEEF)
        // step: 0x000c: sw x3, 0(x2)
        $press_step()
        $expect_stopped_at(32h00000010, Cpu.State.FETCH)
        // step: 0x0010: sw x2, 4(x2)
        $press_step()
        $expect_stopped_at(32h00000014, Cpu.State.FETCH)
        // step: 0x0014: lw x4, 0(x2)
        $press_step()
        $expect_stopped_at(32h00000018, Cpu.State.FETCH)
        $expect_reg(4d4, 32hDEADBEEF)
        // step: 0x0018: lw x5, 4(x2)
        $press_step()
        $expect_stopped_at(32h0000001C, Cpu.State.FETCH)
        $expect_reg(4d5, 32h00000400)
        clock_step = 1
        // clock steps: 0x001c: add x6, x4, x5
        $press_step()
        $expect_stopped_at(32h0000001C, Cpu.State.EXECUTE)
        $press_step()
        $expect_stopped_at(32h00000020, Cpu.State.FETCH)
        $expect_reg(4d6, 32hDEADC2EF)
        // clock steps: 0x0020: sw x0, 0(x2)
        $press_step()
        $expect_stopped_at(32h00000020, Cpu.State.EXECUTE)
        $press_step()
        $expect_stopped_at(32h00000020, Cpu.State.MEM_ACCESS)
        $press_step()
        $expect_stopped_at(32h00000024, Cpu.State.FETCH)
        // clock steps: 0x0024: lw x7, 0(x2)
        $press_step()
        $expect_stopped_at(32h00000024, Cpu.State.EXECUTE)
        $press_step()
        $expect_stopped_at(32h00000024, Cpu.State.MEM_ACCESS)
        $press_step()
        $expect_stopped_at(32h00000024, Cpu.State.WRITEBACK)
        $press_step()
        $expect_stopped_at(32h00000028, Cpu.State.FETCH)
        $expect_reg(4d7, 32h00000000)
        // run, with a step pulse that must be ignored, then stop: ends in the halt loop
        clock_step = 0
        run = 1
        $tick_clock()
        step = 1
        $tick_clock()
        step = 0
        repeat(i, 64) {
            $tick_clock()
            $assert(!dut.halted)    // the stopped light stays off while running
        }
        repeat(i, 40) { $settle(); }
        run = 0
        $settle()
        $expect_stopped_at(32h00000040, Cpu.State.FETCH)
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h00000000)
        $expect_reg(4d2, 32h00000400)
        $expect_reg(4d3, 32hDEADBEEF)
        $expect_reg(4d4, 32hDEADBEEF)
        $expect_reg(4d5, 32h00000400)
        $expect_reg(4d6, 32hDEADC2EF)
        $expect_reg(4d7, 32h00000000)
        $expect_reg(4d8, 32h00000408)
        $expect_reg(4d9, 32hDEADBEEF)
        $expect_reg(4d10, 32hDEADC2EF)
        $expect_reg(4d11, 32h00002000)
        $expect_reg(4d12, 32h00000000)
        $expect_reg(4d13, 32h00000000)
        $expect_reg(4d14, 32h00000000)
        $expect_reg(4d15, 32h00000000)
        // reset while stopped
        rst = 1
        $tick_clock()
        rst = 0
        $settle()
        $expect_stopped_at(32h00000000, Cpu.State.FETCH)
        $expect_reg(4d2, 32h00000000)
        // fast run reaches the halt loop too
        fast = 1
        run = 1
        repeat(i, 10) { $settle(); }
        run = 0
        $settle()
        $expect_stopped_at(32h00000040, Cpu.State.FETCH)
        $expect_reg(4d10, 32hDEADC2EF)
    }
}
