// The memory-mapped UART on its own, with the cpu clock and io_clk at different rates (cpu_tb
// runs them from one clock). uart_rx decodes the serial line on io_clk.
// Checks: busy straight after a write, a write while busy is dropped, the next byte can be
// written while the previous one is still being sent, and bytes arrive in order.
// The receiver (tests rx_*, 8 clocks per bit): a byte arrives (valid, irq, data) and reading pops
// it; an empty receiver reads 0; a byte that arrives while one is unread is dropped and sets
// overrun until a store clears it; it runs whether or not ce is high (the pop and the clear
// wait for ce); a low stop bit (framing error) drops the byte; a glitch shorter than half a bit
// is no start bit.
testbench uart_tb {
    sig clk
    sig io_clk
    sig rst
    sig write
    sig wdata[8]
    sig got[4]               // bytes received so far
    sig bytes[4][8]          // ...and their values, in order
    sig phase                // cpu_clock_fast: io_clk ticks on every other cpu clock
    sig rxin                 // the serial line into the receiver
    sig rx_rd                // a load of RXDATA
    sig clr                  // a store of a 1 to STATUS bit 2
    sig ce

    uart dut(#CLK_FREQ(8), #BAUD(1), .clk(clk), .rst(rst), .io_clk(io_clk), .io_rst(rst),
             .write(write), .write_data(wdata), .ce(ce), .rx(rxin), .rx_read(rx_rd),
             .clear_overrun(clr))
    uart_rx rx(#CLK_FREQ(8), #BAUD(1), .clk(io_clk), .rst(rst), .rx(dut.tx))

    fun io_tick() {
        io_clk = 1
        $silent_tick()
        io_clk = 0
        $tick()
        if (rx.new_data) {
            bytes[got] = rx.data
            got = got + 1
        }
    }

    fun clk_tick() {         // one clock for the receiver, which runs on clk
        clk = 1
        $silent_tick()
        clk = 0
        $silent_tick()
    }

    fun send_bit(level) {    // 8 clocks per bit
        rxin = level
        repeat(i, 8) {
            $clk_tick()
        }
    }

    fun send_byte(b[8]) {
        $send_bit(0)
        repeat(j, 8) {
            $send_bit(b[j])
        }
        $send_bit(1)
        repeat(i, 4) {           // delivered at the middle of the stop bit plus the synchroniser: just after it
            $clk_tick()
        }
    }

    fun rx_start() {         // reset, line idle, nothing pending
        clk = 0
        io_clk = 0
        phase = 0
        write = 0
        wdata = 0
        rxin = 1
        rx_rd = 0
        clr = 0
        ce = 1
        got = 0
        bytes = {8h00, 8h00, 8h00, 8h00}
        rst = 1
        repeat(i, 8) {
            $clk_tick()
        }
        rst = 0
        repeat(i, 8) {
            $clk_tick()
        }
        $assert(!dut.rx_valid && !dut.rx_overrun && !dut.rx_irq && dut.rx_data == 8h00)
    }

    fun rx_pop() {           // a load of RXDATA on one clock
        rx_rd = 1
        $clk_tick()
        rx_rd = 0
    }

    // one cpu clock = 6 io clocks (the board's io clock is 32+ times faster than the cpu clock)
    fun cpu_clock_slow() {
        clk = 1
        repeat(i, 3) {
            $io_tick()
        }
        clk = 0
        repeat(i, 3) {
            $io_tick()
        }
    }

    // two cpu clocks per io clock (stress: the cpu outruns the handshake)
    fun cpu_clock_fast() {
        clk = 1
        $silent_tick()
        clk = 0
        if (phase)
            $io_tick()
        else
            $tick()
        phase = !phase
    }

    test io_faster {
        rxin = 1
        rx_rd = 0
        clr = 0
        ce = 1
        clk = 0
        phase = 0
        io_clk = 0
        write = 0
        wdata = 0
        got = 0
        bytes = {8h00, 8h00, 8h00, 8h00}
        rst = 1
        repeat(i, 4) {
            $cpu_clock_slow()
        }
        rst = 0
        $assert(!dut.busy)
        $assert(dut.tx)

        wdata = 8h48
        write = 1
        $cpu_clock_slow()
        $assert(dut.busy)            // waiting to be taken

        wdata = 8h55                 // dropped: still busy
        $cpu_clock_slow()
        write = 0

        repeat(i, 20) {
            if (dut.busy)
                $cpu_clock_slow()
        }
        $assert(!dut.busy)           // taken...
        $assert(got == 0)            // ...but still being sent

        wdata = 8h69                 // buffered behind the first byte
        write = 1
        $cpu_clock_slow()
        write = 0
        $assert(dut.busy)

        repeat(i, 100) {
            if (got != 2 || dut.busy)
                $cpu_clock_slow()
        }
        repeat(i, 20) {              // long enough for a dropped byte to show up if it was sent
            $cpu_clock_slow()
        }
        if (got != 2)
            $print("got %d bytes: %h %h %h", got, bytes[0], bytes[1], bytes[2])
        $assert(got == 2)
        $assert(bytes[0] == 8h48)
        $assert(bytes[1] == 8h69)
        $assert(!dut.busy)
        $assert(dut.tx)
    }

    test io_slower {
        rxin = 1
        rx_rd = 0
        clr = 0
        ce = 1
        clk = 0
        phase = 0
        io_clk = 0
        write = 0
        wdata = 0
        got = 0
        bytes = {8h00, 8h00, 8h00, 8h00}
        rst = 1
        repeat(i, 16) {
            $cpu_clock_fast()
        }
        rst = 0

        wdata = 8hA5
        write = 1
        $cpu_clock_fast()
        write = 0
        $assert(dut.busy)
        repeat(i, 40) {
            if (dut.busy)
                $cpu_clock_fast()
        }
        $assert(!dut.busy)
        wdata = 8h3C
        write = 1
        $cpu_clock_fast()
        write = 0
        repeat(i, 800) {
            if (got != 2 || dut.busy)
                $cpu_clock_fast()
        }
        if (got != 2)
            $print("got %d bytes: %h %h %h", got, bytes[0], bytes[1], bytes[2])
        $assert(got == 2)
        $assert(bytes[0] == 8hA5)
        $assert(bytes[1] == 8h3C)
    }

    test rx_basic {
        $rx_start()
        $send_byte(8hA5)
        if (!dut.rx_valid)
            $print("no byte")
        $assert(dut.rx_valid && dut.rx_irq && !dut.rx_overrun)
        $assert(dut.rx_data == 8hA5)
        $rx_pop()
        $assert(!dut.rx_valid && !dut.rx_irq && dut.rx_data == 8h00)
        // all-zero and all-one frames
        $send_byte(8h00)
        $assert(dut.rx_valid && dut.rx_data == 8h00)
        $rx_pop()
        $send_byte(8hFF)
        $assert(dut.rx_valid && dut.rx_data == 8hFF)
        $rx_pop()
        $assert(!dut.rx_valid && !dut.rx_overrun)
    }

    test rx_overrun {
        $rx_start()
        $send_byte(8h11)
        $send_byte(8h22)               // unread: dropped, the first is kept
        $assert(dut.rx_valid && dut.rx_overrun && dut.rx_data == 8h11)
        $rx_pop()
        $assert(!dut.rx_valid && dut.rx_overrun)    // the flag stays until cleared
        clr = 1
        $clk_tick()
        clr = 0
        $assert(!dut.rx_overrun)
        $send_byte(8h33)               // receiving works again
        $assert(dut.rx_valid && dut.rx_data == 8h33 && !dut.rx_overrun)
    }

    test rx_ce {
        $rx_start()
        ce = 0                         // the receiver doesn't need the cpu clock
        $send_byte(8h5A)
        $assert(dut.rx_valid && dut.rx_data == 8h5A)
        $rx_pop()                      // ... but a read waits for ce
        $assert(dut.rx_valid && dut.rx_data == 8h5A)
        $send_byte(8h77)               // arrives with the first still unread
        $assert(dut.rx_overrun)
        clr = 1
        $clk_tick()
        clr = 0
        $assert(dut.rx_overrun)        // the clear waits for ce as well
        ce = 1
        $rx_pop()
        $assert(!dut.rx_valid)
        clr = 1
        $clk_tick()
        clr = 0
        $assert(!dut.rx_overrun)
    }

    test rx_frame {
        $rx_start()
        // a glitch (3 clocks low, under half a bit) is not a start bit
        rxin = 0
        repeat(i, 3) {
            $clk_tick()
        }
        rxin = 1
        repeat(i, 40) {
            $clk_tick()
        }
        $assert(!dut.rx_valid)
        // framing error: the stop bit is low, so the byte is dropped (and not reported as overrun)
        $send_bit(0)
        repeat(j, 8) {
            $send_bit(1)
        }
        $send_bit(0)                   // stop bit low
        $send_bit(1)
        repeat(i, 8) {
            $clk_tick()
        }
        $assert(!dut.rx_valid && !dut.rx_overrun)
        $send_byte(8h3C)               // and the receiver recovers
        $assert(dut.rx_valid && dut.rx_data == 8h3C)
    }
}
