        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000058)
        $expect_reg(4d1, 32h00000008)
        // 0x0058: srli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000005C)
        $expect_reg(4d1, 32h00000004)
        // 0x005c: srli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000060)
        $expect_reg(4d1, 32h00000002)
        // 0x0060: srli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000064)
        $expect_reg(4d1, 32h00000001)
        // 0x0064: slli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000068)
        $expect_reg(4d1, 32h00000002)
        // 0x0068: slli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000006C)
        $expect_reg(4d1, 32h00000004)
        // 0x006c: slli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000070)
        $expect_reg(4d1, 32h00000008)
        // 0x0070: slli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000074)
        $expect_reg(4d1, 32h00000010)
        // 0x0074: slli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000078)
        $expect_reg(4d1, 32h00000020)
        // 0x0078: slli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000007C)
        $expect_reg(4d1, 32h00000040)
        // 0x007c: jal x1, right
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000048)
        $expect_reg(4d1, 32h00000080)
        // 0x0048: srli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000004C)
        $expect_reg(4d1, 32h00000040)
        // 0x004c: srli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000050)
        $expect_reg(4d1, 32h00000020)
        // 0x0050: srli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000054)
        $expect_reg(4d1, 32h00000010)
        // 0x0054: srli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000058)
        $expect_reg(4d1, 32h00000008)
        // final register file
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h00000008)
        $expect_reg(4d2, 32h00000000)
        $expect_reg(4d3, 32h00000000)
        $expect_reg(4d4, 32h00000000)
        $expect_reg(4d5, 32h00000000)
        $expect_reg(4d6, 32h00000000)
        $expect_reg(4d7, 32h00000000)
        $expect_reg(4d8, 32h00000000)
        $expect_reg(4d9, 32h00000000)
        $expect_reg(4d10, 32h00000000)
        $expect_reg(4d11, 32h00000000)
        $expect_reg(4d12, 32h00000000)
        $expect_reg(4d13, 32h00000000)
        $expect_reg(4d14, 32h00000000)
        $expect_reg(4d15, 32h00000000)
    }
}

testbench cpu_alu_tb {
    sig clk
    sig rst
    sig sel[4]
    sig switches[8]

    computer dut(#PROGRAM_ID(Programs.Id.ALU), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(clk), .io_rst(rst), .switches(switches),
                 .debug_sel(sel))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory
    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    test run {
        clk = 0
        sel = 0
        switches = 8h00
        rst = 1
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // 0x0000: lui x2, 0x12345
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000004)
        $expect_reg(4d2, 32h12345000)
        // 0x0004: addi x2, x2, 0x678
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000008)
        $expect_reg(4d2, 32h12345678)
        // 0x0008: addi x3, x0, -1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000000C)
        $expect_reg(4d3, 32hFFFFFFFF)
        // 0x000c: addi x4, x0, 5
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000010)
        $expect_reg(4d4, 32h00000005)
        // 0x0010: addi x5, x0, 7
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000014)
        $expect_reg(4d5, 32h00000007)
        // 0x0014: add x6, x4, x5
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000018)
        $expect_reg(4d6, 32h0000000C)
        // 0x0018: sub x7, x4, x5
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000001C)
        $expect_reg(4d7, 32hFFFFFFFE)
        // 0x001c: sub x7, x5, x4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000020)
        $expect_reg(4d7, 32h00000002)
        // 0x0020: sll x8, x4, x5
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000024)
        $expect_reg(4d8, 32h00000280)
        // 0x0024: slt x9, x3, x4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000028)
        $expect_reg(4d9, 32h00000001)
        // 0x0028: sltu x10, x3, x4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000002C)
        $expect_reg(4d10, 32h00000000)
        // 0x002c: xor x11, x2, x3
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000030)
        $expect_reg(4d11, 32hEDCBA987)
        // 0x0030: srl x12, x3, x4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000034)
        $expect_reg(4d12, 32h07FFFFFF)
        // 0x0034: sra x13, x3, x4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000038)
        $expect_reg(4d13, 32hFFFFFFFF)
        // 0x0038: sra x13, x2, x4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000003C)
        $expect_reg(4d13, 32h0091A2B3)
        // 0x003c: or x14, x4, x5
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000040)
        $expect_reg(4d14, 32h00000007)
        // 0x0040: and x15, x4, x5
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000044)
        $expect_reg(4d15, 32h00000005)
        // 0x0044: slti x6, x3, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000048)
        $expect_reg(4d6, 32h00000001)
        // 0x0048: sltiu x7, x4, -1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000004C)
        $expect_reg(4d7, 32h00000001)
        // 0x004c: xori x8, x2, -1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000050)
        $expect_reg(4d8, 32hEDCBA987)
        // 0x0050: ori x9, x0, 0x7ff
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000054)
        $expect_reg(4d9, 32h000007FF)
        // 0x0054: andi x10, x3, 240
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000058)
        $expect_reg(4d10, 32h000000F0)
        // 0x0058: slli x11, x4, 31
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000005C)
        $expect_reg(4d11, 32h80000000)
        // 0x005c: srli x12, x3, 28
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000060)
        $expect_reg(4d12, 32h0000000F)
        // 0x0060: srai x13, x3, 4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000064)
        $expect_reg(4d13, 32hFFFFFFFF)
        // 0x0064: srai x14, x2, 4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000068)
        $expect_reg(4d14, 32h01234567)
        // 0x0068: addi x15, x2, -0x800
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000006C)
        $expect_reg(4d15, 32h12344E78)
        // 0x006c: addi x0, x0, 5
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000070)
        $expect_reg(4d0, 32h00000000)
        // 0x0070: add x1, x0, x0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000074)
        $expect_reg(4d1, 32h00000000)
        // 0x0074: halt
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000074)
        $expect_reg(4d0, 32h00000000)
        // 0x0074: halt
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000074)
        $expect_reg(4d0, 32h00000000)
        // final register file
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h00000000)
        $expect_reg(4d2, 32h12345678)
        $expect_reg(4d3, 32hFFFFFFFF)
        $expect_reg(4d4, 32h00000005)
        $expect_reg(4d5, 32h00000007)
        $expect_reg(4d6, 32h00000001)
        $expect_reg(4d7, 32h00000001)
        $expect_reg(4d8, 32hEDCBA987)
        $expect_reg(4d9, 32h000007FF)
        $expect_reg(4d10, 32h000000F0)
        $expect_reg(4d11, 32h80000000)
        $expect_reg(4d12, 32h0000000F)
        $expect_reg(4d13, 32hFFFFFFFF)
        $expect_reg(4d14, 32h01234567)
        $expect_reg(4d15, 32h12344E78)
    }
}

testbench cpu_branches_tb {
    sig clk
    sig rst
    sig sel[4]
    sig switches[8]

    computer dut(#PROGRAM_ID(Programs.Id.BRANCHES), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(clk), .io_rst(rst), .switches(switches),
                 .debug_sel(sel))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory
    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    test run {
        clk = 0
        sel = 0
        switches = 8h00
        rst = 1
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // 0x0000: addi x2, x0, -1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000004)
        $expect_reg(4d2, 32hFFFFFFFF)
        // 0x0004: addi x3, x0, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000008)
        $expect_reg(4d3, 32h00000001)
        // 0x0008: beq x3, x3, b1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000010)
        // 0x0010: bne x3, x3, b2
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000014)
        // 0x0014: ori x1, x1, 2
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000018)
        $expect_reg(4d1, 32h00000002)
        // 0x0018: blt x2, x3, b3
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000020)
        // 0x0020: bltu x2, x3, b4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000024)
        // 0x0024: ori x1, x1, 8
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000028)
        $expect_reg(4d1, 32h0000000A)
        // 0x0028: bge x3, x2, b5
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000030)
        // 0x0030: bgeu x3, x2, b6
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000034)
        // 0x0034: ori x1, x1, 32
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000038)
        $expect_reg(4d1, 32h0000002A)
        // 0x0038: beq x2, x3, b7
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000003C)
        // 0x003c: ori x1, x1, 64
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000040)
        $expect_reg(4d1, 32h0000006A)
        // 0x0040: addi x4, x0, 3
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000044)
        $expect_reg(4d4, 32h00000003)
        // 0x0044: addi x5, x5, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000048)
        $expect_reg(4d5, 32h00000001)
        // 0x0048: addi x4, x4, -1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000004C)
        $expect_reg(4d4, 32h00000002)
        // 0x004c: bne x4, x0, loop
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000044)
        // 0x0044: addi x5, x5, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000048)
        $expect_reg(4d5, 32h00000002)
        // 0x0048: addi x4, x4, -1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000004C)
        $expect_reg(4d4, 32h00000001)
        // 0x004c: bne x4, x0, loop
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000044)
        // 0x0044: addi x5, x5, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000048)
        $expect_reg(4d5, 32h00000003)
        // 0x0048: addi x4, x4, -1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000004C)
        $expect_reg(4d4, 32h00000000)
        // 0x004c: bne x4, x0, loop
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000050)
        // 0x0050: halt
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000050)
        $expect_reg(4d0, 32h00000000)
        // 0x0050: halt
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000050)
        $expect_reg(4d0, 32h00000000)
        // final register file
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h0000006A)
        $expect_reg(4d2, 32hFFFFFFFF)
        $expect_reg(4d3, 32h00000001)
        $expect_reg(4d4, 32h00000000)
        $expect_reg(4d5, 32h00000003)
        $expect_reg(4d6, 32h00000000)
        $expect_reg(4d7, 32h00000000)
        $expect_reg(4d8, 32h00000000)
        $expect_reg(4d9, 32h00000000)
        $expect_reg(4d10, 32h00000000)
        $expect_reg(4d11, 32h00000000)
        $expect_reg(4d12, 32h00000000)
        $expect_reg(4d13, 32h00000000)
        $expect_reg(4d14, 32h00000000)
        $expect_reg(4d15, 32h00000000)
    }
}

testbench cpu_jumps_tb {
    sig clk
    sig rst
    sig sel[4]
    sig switches[8]

    computer dut(#PROGRAM_ID(Programs.Id.JUMPS), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(clk), .io_rst(rst), .switches(switches),
                 .debug_sel(sel))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory
    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    test run {
        clk = 0
        sel = 0
        switches = 8h00
        rst = 1
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // 0x0000: auipc x2, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000004)
        $expect_reg(4d2, 32h00000000)
        // 0x0004: auipc x3, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000008)
        $expect_reg(4d3, 32h00001004)
        // 0x0008: jal x1, func
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000034)
        $expect_reg(4d1, 32h0000000C)
        // 0x0034: addi x5, x0, 5
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000038)
        $expect_reg(4d5, 32h00000005)
        // 0x0038: jalr x0, x1, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000000C)
        $expect_reg(4d0, 32h00000000)
        // 0x000c: addi x6, x0, 6
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000010)
        $expect_reg(4d6, 32h00000006)
        // 0x0010: lui x7, 0xabcde
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000014)
        $expect_reg(4d7, 32hABCDE000)
        // 0x0014: addi x8, x0, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000018)
        $expect_reg(4d8, 32h00000000)
        // 0x0018: jal x0, skip
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000020)
        $expect_reg(4d0, 32h00000000)
        // 0x0020: auipc x9, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000024)
        $expect_reg(4d9, 32h00000020)
        // 0x0024: jalr x10, x9, 13
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000002C)
        $expect_reg(4d10, 32h00000028)
        // 0x002c: addi x12, x0, 12
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000030)
        $expect_reg(4d12, 32h0000000C)
        // 0x0030: halt
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000030)
        $expect_reg(4d0, 32h00000000)
        // 0x0030: halt
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000030)
        $expect_reg(4d0, 32h00000000)
        // final register file
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h0000000C)
        $expect_reg(4d2, 32h00000000)
        $expect_reg(4d3, 32h00001004)
        $expect_reg(4d4, 32h00000000)
        $expect_reg(4d5, 32h00000005)
        $expect_reg(4d6, 32h00000006)
        $expect_reg(4d7, 32hABCDE000)
        $expect_reg(4d8, 32h00000000)
        $expect_reg(4d9, 32h00000020)
        $expect_reg(4d10, 32h00000028)
        $expect_reg(4d11, 32h00000000)
        $expect_reg(4d12, 32h0000000C)
        $expect_reg(4d13, 32h00000000)
        $expect_reg(4d14, 32h00000000)
        $expect_reg(4d15, 32h00000000)
    }
}

testbench cpu_memory_tb {
    sig clk
    sig rst
    sig sel[4]
    sig switches[8]

    computer dut(#PROGRAM_ID(Programs.Id.MEMORY), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(clk), .io_rst(rst), .switches(switches),
                 .debug_sel(sel))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory
    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    test run {
        clk = 0
        sel = 0
        switches = 8h00
        rst = 1
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // 0x0000: addi x2, x0, 0x400
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000004)
        $expect_reg(4d2, 32h00000400)
        // 0x0004: lui x3, 0xdeadc
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000008)
        $expect_reg(4d3, 32hDEADC000)
        // 0x0008: addi x3, x3, -0x111
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000000C)
        $expect_reg(4d3, 32hDEADBEEF)
        // 0x000c: sw x3, 0(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000010)
        // 0x0010: sw x2, 4(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000014)
        // 0x0014: lw x4, 0(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000018)
        $expect_reg(4d4, 32hDEADBEEF)
        // 0x0018: lw x5, 4(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000001C)
        $expect_reg(4d5, 32h00000400)
        // 0x001c: add x6, x4, x5
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000020)
        $expect_reg(4d6, 32hDEADC2EF)
        // 0x0020: sw x0, 0(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000024)
        // 0x0024: lw x7, 0(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000028)
        $expect_reg(4d7, 32h00000000)
        // 0x0028: addi x8, x2, 8
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000002C)
        $expect_reg(4d8, 32h00000408)
        // 0x002c: sw x3, -4(x8)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000030)
        // 0x0030: lw x9, 4(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000034)
        $expect_reg(4d9, 32hDEADBEEF)
        // 0x0034: lui x11, 2
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000038)
        $expect_reg(4d11, 32h00002000)
        // 0x0038: sw x6, -4(x11)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000003C)
        // 0x003c: lw x10, -4(x11)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000040)
        $expect_reg(4d10, 32hDEADC2EF)
        // 0x0040: halt
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000040)
        $expect_reg(4d0, 32h00000000)
        // 0x0040: halt
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000040)
        $expect_reg(4d0, 32h00000000)
        // final register file
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h00000000)
        $expect_reg(4d2, 32h00000400)
        $expect_reg(4d3, 32hDEADBEEF)
        $expect_reg(4d4, 32hDEADBEEF)
        $expect_reg(4d5, 32h00000400)
        $expect_reg(4d6, 32hDEADC2EF)
        $expect_reg(4d7, 32h00000000)
        $expect_reg(4d8, 32h00000408)
        $expect_reg(4d9, 32hDEADBEEF)
        $expect_reg(4d10, 32hDEADC2EF)
        $expect_reg(4d11, 32h00002000)
        $expect_reg(4d12, 32h00000000)
        $expect_reg(4d13, 32h00000000)
        $expect_reg(4d14, 32h00000000)
        $expect_reg(4d15, 32h00000000)
    }
}

