            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
        $assert(!dut.sleeping || dut.debug_state == Cpu.State.EXECUTE)   // only a waiting WFI sleeps
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    fun expect_display(value[33]) {   // owned, the four characters
        if (c{dut.display_owned, dut.display_chars} != value)
            $print("display: got %h want %h", c{dut.display_owned, dut.display_chars}, value)
        $assert(c{dut.display_owned, dut.display_chars} == value)
    }

    fun expect_leds_dark() {          // the LED dimmer bank is dark unless a program enabled it (print tests stop at a byte count)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    fun expect_leds(enabled) {        // the LED dimmer bank: enabled as rv32sim has it, dark when it is not
        if (dut.leds_enabled != enabled || (!dut.leds_enabled && dut.leds != 0))
            $print("leds: enabled %d want %d, leds %h", dut.leds_enabled, enabled, dut.leds)
        $assert(dut.leds_enabled == enabled)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    test run {
        clk = 0
        io_clk = 0
        sel = 0
        switches = 8h02
        buttons = 0
        plat_irq = 0
        rx_line = 1
        ce = 1
        rst = 1
        received = 0
        clock_count = 0
        expected = {8h21, 8h6F, 8h67, 8h0A, 8h0D, 8h39, 8h20, 8h73, 8h6E, 8h6F, 8h74, 8h74, 8h75, 8h62, 8h0A, 8h0D, 8h34, 8h20, 8h74, 8h73, 8h6F, 8h6C, 8h20, 8h34, 8h20, 8h73, 8h6E, 8h6F, 8h74, 8h74, 8h75, 8h62, 8h0A, 8h0D, 8h65, 8h70, 8h79, 8h74, 8h20, 8h72, 8h6F, 8h20, 8h2C, 8h6E, 8h6F, 8h74, 8h74, 8h75, 8h62, 8h20, 8h6E, 8h6F, 8h69, 8h74, 8h63, 8h65, 8h72, 8h69, 8h64, 8h20, 8h61, 8h20, 8h73, 8h73, 8h65, 8h72, 8h50, 8h0A, 8h0D}   // "\x0d\x0aPress a direction button, or type\x0d\x0abuttons 4 lost 4\x0d\x0abuttons 9\x0d\x0ago!"
        // hold reset for an extra bit time: uart_tx's output register has no reset and starts
        // low for two clocks, and uart_rx's 3-deep input buffer (not reset either) would
        // take that for a start bit unless the idle-high line has filled it first
        repeat(i, 8) {
            $tick_clock()
        }
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // run until the first 69 bytes have been received (at most 30861 clocks)
        repeat(i, 30861) {
            if (received != 69) {
                if (clock_count == 100) buttons = 4h4;   // button event
                if (clock_count == 110) buttons = 4h0;   // button event
                if (clock_count == 140) buttons = 4h4;   // button event
                if (clock_count == 150) buttons = 4h0;   // button event
                if (clock_count == 3000) buttons = 4h9;   // button event
                if (clock_count == 3100) buttons = 4h0;   // button event
                if (clock_count == 8000) rx_line = 0;   // serial input
                if (clock_count == 8008) rx_line = 1;   // serial input
                if (clock_count == 8032) rx_line = 0;   // serial input
                if (clock_count == 8048) rx_line = 1;   // serial input
                if (clock_count == 8064) rx_line = 0;   // serial input
                if (clock_count == 8072) rx_line = 1;   // serial input
                if (clock_count == 8400) rx_line = 0;   // serial input
                if (clock_count == 8408) rx_line = 1;   // serial input
                if (clock_count == 8440) rx_line = 0;   // serial input
                if (clock_count == 8448) rx_line = 1;   // serial input
                if (clock_count == 8464) rx_line = 0;   // serial input
                if (clock_count == 8472) rx_line = 1;   // serial input
                if (clock_count == 8800) rx_line = 0;   // serial input
                if (clock_count == 8808) rx_line = 1;   // serial input
                if (clock_count == 8816) rx_line = 0;   // serial input
                if (clock_count == 8848) rx_line = 1;   // serial input
                if (clock_count == 8856) rx_line = 0;   // serial input
                if (clock_count == 8872) rx_line = 1;   // serial input
                $tick_clock()
                clock_count = clock_count + 1
                if (rx.new_data) {
                    $assert(received < 69)
                    if (rx.data != expected[received])
                        $print("byte %d: got %h want %h", received, rx.data, expected[received])
                    $assert(rx.data == expected[received])
                    received = received + 1
                }
            }
        }
        if (received != 69)
            $print("received %d of 69 bytes", received)
        $assert(received == 69)
        $expect_leds_dark()
    }
}

testbench cpu_board_sw3_tb {
    sig clk
    sig io_clk             // the UART's clock: same rate as clk, opposite phase (see tick_clock)
    sig rst
    sig sel[4]
    sig switches[8]
    sig buttons[4]
    sig plat_irq[2]        // platform interrupt lines (the UART's receiver is ORed into line 0)
    sig rx_line            // the serial line into the UART's receiver
    sig ce                 // the computer's clock enable

    computer dut(#PROGRAM_ID(Programs.Id.BOARD), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(io_clk), .io_rst(rst), .switches(switches),
                 .buttons(buttons), .plat_irq(plat_irq), .uart_rx(rx_line), .ce(ce),
                 .debug_sel(sel))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory.
    // io_clk rises when clk falls: on the board the two clocks are unrelated, and edges at the
    // same instant in two domains are where this simulator's update order bites (one byte in
    // most runs of the long printing tests was sent twice with io_clk = clk)
    fun tick_clock() {
        clk = 1
        io_clk = 0
        $silent_tick()
        clk = 0
        io_clk = 1
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
        $assert(!dut.sleeping || dut.debug_state == Cpu.State.EXECUTE)   // only a waiting WFI sleeps
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    fun expect_display(value[33]) {   // owned, the four characters
        if (c{dut.display_owned, dut.display_chars} != value)
            $print("display: got %h want %h", c{dut.display_owned, dut.display_chars}, value)
        $assert(c{dut.display_owned, dut.display_chars} == value)
    }

    fun expect_leds_dark() {          // the LED dimmer bank is dark unless a program enabled it (print tests stop at a byte count)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    fun expect_leds(enabled) {        // the LED dimmer bank: enabled as rv32sim has it, dark when it is not
        if (dut.leds_enabled != enabled || (!dut.leds_enabled && dut.leds != 0))
            $print("leds: enabled %d want %d, leds %h", dut.leds_enabled, enabled, dut.leds)
        $assert(dut.leds_enabled == enabled)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    test run {
        clk = 0
        io_clk = 0
        sel = 0
        switches = 8h03
        buttons = 0
        plat_irq = 0
        rx_line = 1
        ce = 1
        rst = 1
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // 0x0000: lui x2, 0x80001
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000004)
        $expect_reg(4d2, 32h80001000)
        // 0x0004: lw x3, 0(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000008)
        $expect_reg(4d3, 32h00000003)
        // 0x0008: andi x3, x3, 7
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000000C)
        $expect_reg(4d3, 32h00000003)
        // 0x000c: slli x3, x3, 2
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000010)
        $expect_reg(4d3, 32h0000000C)
        // 0x0010: lw x4, menu(x3)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000014)
        $expect_reg(4d4, 32h000001BC)
        // 0x0014: jalr x0, x4, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000001BC)
        $expect_reg(4d0, 32h00000000)
        // 0x01bc: jal x6, period
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000388)
        $expect_reg(4d6, 32h000001C0)
        // 0x0388: lui x2, 0x80001
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000038C)
        $expect_reg(4d2, 32h80001000)
        // 0x038c: lw x9, 0(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000390)
        $expect_reg(4d9, 32h00000003)
        // 0x0390: srli x9, x9, 3
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000394)
        $expect_reg(4d9, 32h00000000)
        // 0x0394: slli x9, x9, 13
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000398)
        $expect_reg(4d9, 32h00000000)
        // 0x0398: addi x9, x9, 64
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000039C)
        $expect_reg(4d9, 32h00000040)
        // 0x039c: jalr x0, x6, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000001C0)
        $expect_reg(4d0, 32h00000000)
        // 0x01c0: srli x9, x9, 2
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000001C4)
        $expect_reg(4d9, 32h00000010)
        // 0x01c4: lui x2, 0x80002
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000001C8)
        $expect_reg(4d2, 32h80002000)
        // 0x01c8: lw x5, 16(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000001CC)
        $expect_reg(4d5, 32h00000001)
        // 0x01cc: addi x4, x0, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000001D0)
        $expect_reg(4d4, 32h00000000)
        // 0x01d0: add x4, x4, x9
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000001D4)
        $expect_reg(4d4, 32h00000010)
        // 0x01d4: addi x5, x5, -1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000001D8)
        $expect_reg(4d5, 32h00000000)
        // 0x01d8: bne x5, x0, calibrate
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000001DC)
        // 0x01dc: addi x9, x4, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000001E0)
        $expect_reg(4d9, 32h00000010)
        // 0x01e0: addi x1, x0, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000001E4)
        $expect_reg(4d1, 32h00000001)
        // 0x01e4: slli x1, x1, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000001E8)
        $expect_reg(4d1, 32h00000002)
        // 0x01e8: jal x5, delay
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000258)
        $expect_reg(4d5, 32h000001EC)
        // 0x0258: addi x4, x9, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000025C)
        $expect_reg(4d4, 32h00000010)
        // 0x025c: addi x4, x4, -1
