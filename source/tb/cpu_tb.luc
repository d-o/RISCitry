testbench cpu_uart_tb {
    sig clk
    sig io_clk             // the UART's clock: same rate as clk, opposite phase (see tick_clock)
    sig rst
    sig sel[4]
    sig switches[8]
    sig buttons[4]
    sig plat_irq[2]        // platform interrupt lines (the UART's receiver is ORed into line 0)
    sig rx_line            // the serial line into the UART's receiver
    sig ce                 // the computer's clock enable
    sig received[8]
    sig expected[4][8]
    sig clock_count[32]

    computer dut(#PROGRAM_ID(Programs.Id.UART), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(io_clk), .io_rst(rst), .switches(switches),
                 .buttons(buttons), .plat_irq(plat_irq), .uart_rx(rx_line), .ce(ce),
                 .debug_sel(sel))
    uart_rx rx(#CLK_FREQ(8), #BAUD(1), .clk(clk), .rst(rst), .rx(dut.uart_tx))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory.
    // io_clk rises when clk falls: on the board the two clocks are unrelated, and edges at the
    // same instant in two domains are where this simulator's update order bites (one byte in
    // most runs of the long printing tests was sent twice with io_clk = clk)
    fun tick_clock() {
        clk = 1
        io_clk = 0
        $silent_tick()
        clk = 0
        io_clk = 1
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
        $assert(!dut.sleeping || dut.debug_state == Cpu.State.EXECUTE)   // only a waiting WFI sleeps
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    fun expect_display(value[33]) {   // owned, the four characters
        if (c{dut.display_owned, dut.display_chars} != value)
            $print("display: got %h want %h", c{dut.display_owned, dut.display_chars}, value)
        $assert(c{dut.display_owned, dut.display_chars} == value)
    }

    fun expect_leds_dark() {          // the LED dimmer bank is dark unless a program enabled it (print tests stop at a byte count)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    fun expect_leds(enabled) {        // the LED dimmer bank: enabled as rv32sim has it, dark when it is not
        if (dut.leds_enabled != enabled || (!dut.leds_enabled && dut.leds != 0))
            $print("leds: enabled %d want %d, leds %h", dut.leds_enabled, enabled, dut.leds)
        $assert(dut.leds_enabled == enabled)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    test run {
        clk = 0
        io_clk = 0
        sel = 0
        switches = 8h00
        buttons = 0
        plat_irq = 0
        rx_line = 1
        ce = 1
        rst = 1
        received = 0
        clock_count = 0
        expected = {8h0A, 8h21, 8h69, 8h48}   // "Hi!\x0a"
        // hold reset for an extra bit time: uart_tx's output register has no reset and starts
        // low for two clocks, and uart_rx's 3-deep input buffer (not reset either) would
        // take that for a start bit unless the idle-high line has filled it first
        repeat(i, 8) {
            $tick_clock()
        }
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // run until halted at 0x0038 with all 4 bytes received (at most 2047 clocks)
        repeat(i, 2047) {
            if (received != 4 || dut.debug_pc != 32h00000038 || dut.debug_state != Cpu.State.FETCH) {
                $tick_clock()
                clock_count = clock_count + 1
                if (rx.new_data) {
                    $assert(received < 4)
                    if (rx.data != expected[received])
                        $print("byte %d: got %h want %h", received, rx.data, expected[received])
                    $assert(rx.data == expected[received])
                    received = received + 1
                }
            }
        }
        if (received != 4)
            $print("received %d of 4 bytes", received)
        $assert(received == 4)
        $expect_pc(32h00000038)
        $expect_state(Cpu.State.FETCH)
        // final register file
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h00000034)
        $expect_reg(4d2, 32h80000000)
        $expect_reg(4d3, 32h00000000)
        $expect_reg(4d4, 32h00000000)
        $expect_reg(4d5, 32h00000000)
        $expect_reg(4d6, 32h00000000)
        $expect_reg(4d7, 32h00000000)
        $expect_reg(4d8, 32h00000000)
        $expect_reg(4d9, 32h00000000)
        $expect_reg(4d10, 32h0000000A)
        $expect_reg(4d11, 32h00000058)
        $expect_reg(4d12, 32h0000005A)
        $expect_reg(4d13, 32h05A00613)
        $expect_reg(4d14, 32h00000000)
        $expect_reg(4d15, 32h00000000)
        $expect_leds_dark()
    }
}

testbench cpu_rxecho_tb {
    sig clk
    sig io_clk             // the UART's clock: same rate as clk, opposite phase (see tick_clock)
    sig rst
    sig sel[4]
    sig switches[8]
    sig buttons[4]
    sig plat_irq[2]        // platform interrupt lines (the UART's receiver is ORed into line 0)
    sig rx_line            // the serial line into the UART's receiver
    sig ce                 // the computer's clock enable
    sig received[8]
    sig expected[5][8]
    sig clock_count[32]

    computer dut(#PROGRAM_ID(Programs.Id.RXECHO), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(io_clk), .io_rst(rst), .switches(switches),
                 .buttons(buttons), .plat_irq(plat_irq), .uart_rx(rx_line), .ce(ce),
                 .debug_sel(sel))
    uart_rx rx(#CLK_FREQ(8), #BAUD(1), .clk(clk), .rst(rst), .rx(dut.uart_tx))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory.
    // io_clk rises when clk falls: on the board the two clocks are unrelated, and edges at the
    // same instant in two domains are where this simulator's update order bites (one byte in
    // most runs of the long printing tests was sent twice with io_clk = clk)
    fun tick_clock() {
        clk = 1
        io_clk = 0
        $silent_tick()
        clk = 0
        io_clk = 1
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
        $assert(!dut.sleeping || dut.debug_state == Cpu.State.EXECUTE)   // only a waiting WFI sleeps
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    fun expect_display(value[33]) {   // owned, the four characters
        if (c{dut.display_owned, dut.display_chars} != value)
            $print("display: got %h want %h", c{dut.display_owned, dut.display_chars}, value)
        $assert(c{dut.display_owned, dut.display_chars} == value)
    }

    fun expect_leds_dark() {          // the LED dimmer bank is dark unless a program enabled it (print tests stop at a byte count)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    fun expect_leds(enabled) {        // the LED dimmer bank: enabled as rv32sim has it, dark when it is not
        if (dut.leds_enabled != enabled || (!dut.leds_enabled && dut.leds != 0))
            $print("leds: enabled %d want %d, leds %h", dut.leds_enabled, enabled, dut.leds)
        $assert(dut.leds_enabled == enabled)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    test run {
        clk = 0
        io_clk = 0
        sel = 0
        switches = 8h00
        buttons = 0
        plat_irq = 0
        rx_line = 1
        ce = 1
        rst = 1
        received = 0
        clock_count = 0
        expected = {8h0B, 8h00, 8h01, 8h81, 8h42}   // "B\x81\x01\x00\x0b"
        // hold reset for an extra bit time: uart_tx's output register has no reset and starts
        // low for two clocks, and uart_rx's 3-deep input buffer (not reset either) would
        // take that for a start bit unless the idle-high line has filled it first
        repeat(i, 8) {
            $tick_clock()
        }
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // run until halted at 0x004c with all 5 bytes received (at most 3643 clocks)
        repeat(i, 3643) {
            if (received != 5 || dut.debug_pc != 32h0000004C || dut.debug_state != Cpu.State.FETCH) {
                if (clock_count == 200) rx_line = 0;   // serial input
                if (clock_count == 208) rx_line = 1;   // serial input
                if (clock_count == 216) rx_line = 0;   // serial input
                if (clock_count == 256) rx_line = 1;   // serial input
                if (clock_count == 264) rx_line = 0;   // serial input
                if (clock_count == 272) rx_line = 1;   // serial input
                if (clock_count == 400) rx_line = 0;   // serial input
                if (clock_count == 464) rx_line = 1;   // serial input
                if (clock_count == 600) rx_line = 0;   // serial input
                if (clock_count == 672) rx_line = 1;   // serial input
                if (clock_count == 800) rx_line = 0;   // serial input
                if (clock_count == 808) rx_line = 1;   // serial input
                if (clock_count == 1000) rx_line = 0;   // serial input
                if (clock_count == 1016) rx_line = 1;   // serial input
                if (clock_count == 1024) rx_line = 0;   // serial input
                if (clock_count == 1032) rx_line = 1;   // serial input
                if (clock_count == 1040) rx_line = 0;   // serial input
                if (clock_count == 1072) rx_line = 1;   // serial input
                $tick_clock()
                clock_count = clock_count + 1
                if (rx.new_data) {
                    $assert(received < 5)
                    if (rx.data != expected[received])
                        $print("byte %d: got %h want %h", received, rx.data, expected[received])
                    $assert(rx.data == expected[received])
                    received = received + 1
                }
            }
        }
        if (received != 5)
            $print("received %d of 5 bytes", received)
        $assert(received == 5)
        $expect_pc(32h0000004C)
        $expect_state(Cpu.State.FETCH)
        // final register file
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h00000038)
        $expect_reg(4d2, 32h80000000)
        $expect_reg(4d3, 32h00000000)
        $expect_reg(4d4, 32h00000000)
        $expect_reg(4d5, 32h00000000)
        $expect_reg(4d6, 32h00000000)
        $expect_reg(4d7, 32h0000000A)
        $expect_reg(4d8, 32h00000005)
        $expect_reg(4d9, 32h00000001)
        $expect_reg(4d10, 32h0000000B)
        $expect_reg(4d11, 32h000001CA)
        $expect_reg(4d12, 32h00000000)
        $expect_reg(4d13, 32h00000000)
        $expect_reg(4d14, 32h00000000)
        $expect_reg(4d15, 32h00000000)
        $expect_leds_dark()
    }
}

testbench cpu_rxirq_tb {
    sig clk
