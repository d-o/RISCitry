testbench cpu_board_sw1_tb {
    sig clk
    sig rst
    sig sel[4]
    sig switches[8]
    sig received[8]
    sig expected[100][8]

    computer dut(#PROGRAM_ID(Programs.Id.BOARD), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(clk), .io_rst(rst), .switches(switches),
                 .debug_sel(sel))
    uart_rx rx(#CLK_FREQ(8), #BAUD(1), .clk(clk), .rst(rst), .rx(dut.uart_tx))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory
    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    test run {
        clk = 0
        sel = 0
        switches = 8h01
        rst = 1
        received = 0
        expected = {8h0A, 8h0D, 8h33, 8h30, 8h30, 8h30, 8h30, 8h30, 8h30, 8h30, 8h20, 8h70, 8h65, 8h65, 8h77, 8h73, 8h0A, 8h0D, 8h32, 8h30, 8h30, 8h30, 8h30, 8h30, 8h30, 8h30, 8h20, 8h70, 8h65, 8h65, 8h77, 8h73, 8h0A, 8h0D, 8h31, 8h30, 8h30, 8h30, 8h30, 8h30, 8h30, 8h30, 8h20, 8h70, 8h65, 8h65, 8h77, 8h73, 8h0A, 8h0D, 8h75, 8h43, 8h20, 8h79, 8h72, 8h74, 8h69, 8h68, 8h63, 8h6C, 8h41, 8h20, 8h65, 8h68, 8h74, 8h20, 8h6E, 8h6F, 8h20, 8h65, 8h72, 8h6F, 8h63, 8h20, 8h74, 8h66, 8h6F, 8h73, 8h20, 8h45, 8h32, 8h33, 8h56, 8h52, 8h20, 8h6E, 8h61, 8h20, 8h6D, 8h6F, 8h72, 8h66, 8h20, 8h6F, 8h6C, 8h6C, 8h65, 8h48, 8h0A, 8h0D}   // "\x0d\x0aHello from an RV32E soft core on the Alchitry Cu\x0d\x0asweep 00000001\x0d\x0asweep 00000002\x0d\x0asweep 00000003\x0d\x0a"
        // hold reset for an extra bit time: uart_tx's output register has no reset and starts
        // low for two clocks, and uart_rx's 3-deep input buffer (not reset either) would
        // take that for a start bit unless the idle-high line has filled it first
        repeat(i, 8) {
            $tick_clock()
        }
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // run until the first 100 bytes have been received (at most 25000 clocks)
        repeat(i, 25000) {
            if (received != 100) {
                $tick_clock()
                if (rx.new_data) {
                    $assert(received < 100)
                    if (rx.data != expected[received])
                        $print("byte %d: got %h want %h", received, rx.data, expected[received])
                    $assert(rx.data == expected[received])
                    received = received + 1
                }
            }
        }
        if (received != 100)
            $print("received %d of 100 bytes", received)
        $assert(received == 100)
    }
}

testbench cpu_larson_tb {
    sig clk
    sig rst
    sig sel[4]
    sig switches[8]

    computer dut(#PROGRAM_ID(Programs.Id.LARSON), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(clk), .io_rst(rst), .switches(switches),
                 .debug_sel(sel))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory
    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
