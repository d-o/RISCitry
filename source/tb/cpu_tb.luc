        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000040)
        // 0x0040: sb x14, 4(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000044)
        // 0x0044: sb x3, 6(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000048)
        // 0x0048: lw x15, 4(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000004C)
        $expect_reg(4d15, 32h000100FF)
        // 0x004c: sh x14, 6(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000050)
        // 0x0050: lw x15, 4(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000054)
        $expect_reg(4d15, 32hFFFF00FF)
        // 0x0054: sh x3, 4(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000058)
        // 0x0058: lw x1, 4(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000005C)
        $expect_reg(4d1, 32hFFFF7F01)
        // 0x005c: lb x1, 5(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000060)
        $expect_reg(4d1, 32h0000007F)
        // 0x0060: addi x5, x2, 8
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000064)
        $expect_reg(4d5, 32h00000488)
        // 0x0064: sb x0, -1(x5)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000068)
        // 0x0068: lw x6, 4(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000006C)
        $expect_reg(4d6, 32h00FF7F01)
        // 0x006c: sb x14, 9(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000070)
        // 0x0070: lw x7, 8(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000074)
        $expect_reg(4d7, 32h0000FF00)
        // 0x0074: lbu x8, 9(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000078)
        $expect_reg(4d8, 32h000000FF)
        // 0x0078: halt
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000078)
        $expect_reg(4d0, 32h00000000)
        // 0x0078: halt
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000078)
        $expect_reg(4d0, 32h00000000)
        // final register file
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h0000007F)
        $expect_reg(4d2, 32h00000480)
        $expect_reg(4d3, 32h80817F01)
        $expect_reg(4d4, 32h00000001)
        $expect_reg(4d5, 32h00000488)
        $expect_reg(4d6, 32h00FF7F01)
        $expect_reg(4d7, 32h0000FF00)
        $expect_reg(4d8, 32h000000FF)
        $expect_reg(4d9, 32h00000080)
        $expect_reg(4d10, 32h00007F01)
        $expect_reg(4d11, 32hFFFF8081)
        $expect_reg(4d12, 32h00008081)
        $expect_reg(4d13, 32h00007F01)
        $expect_reg(4d14, 32hFFFFFFFF)
        $expect_reg(4d15, 32hFFFF00FF)
    }
}

testbench cpu_uart_tb {
    sig clk
    sig rst
    sig sel[4]
    sig switches[8]
    sig received[8]
    sig expected[4][8]

    computer dut(#PROGRAM_ID(Programs.Id.UART), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(clk), .io_rst(rst), .switches(switches),
                 .debug_sel(sel))
    uart_rx rx(#CLK_FREQ(8), #BAUD(1), .clk(clk), .rst(rst), .rx(dut.uart_tx))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory
    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    test run {
        clk = 0
        sel = 0
        switches = 8h00
        rst = 1
        received = 0
        expected = {8h0A, 8h21, 8h69, 8h48}   // "Hi!\x0a"
        // hold reset for an extra bit time: uart_tx's output register has no reset and starts
        // low for two clocks, and uart_rx's 3-deep input buffer (not reset either) would
        // take that for a start bit unless the idle-high line has filled it first
        repeat(i, 8) {
            $tick_clock()
        }
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // run until halted at 0x0038 with all 4 bytes received (at most 1960 clocks)
        repeat(i, 1960) {
            if (received != 4 || dut.debug_pc != 32h00000038 || dut.debug_state != Cpu.State.FETCH) {
                $tick_clock()
                if (rx.new_data) {
                    $assert(received < 4)
                    if (rx.data != expected[received])
                        $print("byte %d: got %h want %h", received, rx.data, expected[received])
                    $assert(rx.data == expected[received])
                    received = received + 1
                }
            }
        }
        if (received != 4)
            $print("received %d of 4 bytes", received)
        $assert(received == 4)
        $expect_pc(32h00000038)
        $expect_state(Cpu.State.FETCH)
        // final register file
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h00000034)
        $expect_reg(4d2, 32h80000000)
        $expect_reg(4d3, 32h00000000)
        $expect_reg(4d4, 32h00000000)
        $expect_reg(4d5, 32h00000000)
        $expect_reg(4d6, 32h00000000)
        $expect_reg(4d7, 32h00000000)
        $expect_reg(4d8, 32h00000000)
        $expect_reg(4d9, 32h00000000)
        $expect_reg(4d10, 32h0000000A)
        $expect_reg(4d11, 32h00000058)
        $expect_reg(4d12, 32h0000005A)
        $expect_reg(4d13, 32h05A00613)
        $expect_reg(4d14, 32h00000000)
        $expect_reg(4d15, 32h00000000)
    }
}

testbench cpu_string_tb {
    sig clk
    sig rst
    sig sel[4]
    sig switches[8]
    sig received[8]
    sig expected[16][8]

    computer dut(#PROGRAM_ID(Programs.Id.STRING), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(clk), .io_rst(rst), .switches(switches),
                 .debug_sel(sel))
    uart_rx rx(#CLK_FREQ(8), #BAUD(1), .clk(clk), .rst(rst), .rx(dut.uart_tx))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory
    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    test run {
        clk = 0
        sel = 0
        switches = 8h00
        rst = 1
        received = 0
        expected = {8h0A, 8h21, 8h4D, 8h41, 8h52, 8h20, 8h6D, 8h6F, 8h72, 8h66, 8h20, 8h6F, 8h6C, 8h6C, 8h65, 8h48}   // "Hello from RAM!\x0a"
        // hold reset for an extra bit time: uart_tx's output register has no reset and starts
        // low for two clocks, and uart_rx's 3-deep input buffer (not reset either) would
        // take that for a start bit unless the idle-high line has filled it first
        repeat(i, 8) {
            $tick_clock()
        }
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // run until halted at 0x0024 with all 16 bytes received (at most 4840 clocks)
        repeat(i, 4840) {
            if (received != 16 || dut.debug_pc != 32h00000024 || dut.debug_state != Cpu.State.FETCH) {
                $tick_clock()
                if (rx.new_data) {
                    $assert(received < 16)
                    if (rx.data != expected[received])
                        $print("byte %d: got %h want %h", received, rx.data, expected[received])
                    $assert(rx.data == expected[received])
                    received = received + 1
                }
            }
        }
        if (received != 16)
            $print("received %d of 16 bytes", received)
        $assert(received == 16)
        $expect_pc(32h00000024)
        $expect_state(Cpu.State.FETCH)
        // final register file
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h00000000)
        $expect_reg(4d2, 32h80000000)
        $expect_reg(4d3, 32h00000038)
        $expect_reg(4d4, 32h00000000)
        $expect_reg(4d5, 32h00000000)
        $expect_reg(4d6, 32h00000000)
        $expect_reg(4d7, 32h00000000)
        $expect_reg(4d8, 32h00000000)
        $expect_reg(4d9, 32h00000000)
        $expect_reg(4d10, 32h00000000)
        $expect_reg(4d11, 32h00000000)
        $expect_reg(4d12, 32h00000000)
        $expect_reg(4d13, 32h00000000)
        $expect_reg(4d14, 32h00000000)
        $expect_reg(4d15, 32h00000000)
    }
}

testbench cpu_table_tb {
    sig clk
    sig rst
    sig sel[4]
    sig switches[8]

    computer dut(#PROGRAM_ID(Programs.Id.TABLE), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(clk), .io_rst(rst), .switches(switches),
                 .debug_sel(sel))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory
    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    test run {
        clk = 0
        sel = 0
        switches = 8h00
        rst = 1
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // 0x0000: addi x3, x0, words
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000004)
        $expect_reg(4d3, 32h0000004C)
        // 0x0004: addi x4, x0, 4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000008)
        $expect_reg(4d4, 32h00000004)
        // 0x0008: addi x5, x0, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000000C)
        $expect_reg(4d5, 32h00000000)
        // 0x000c: lw x6, 0(x3)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000010)
        $expect_reg(4d6, 32h00000001)
        // 0x0010: add x5, x5, x6
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000014)
        $expect_reg(4d5, 32h00000001)
        // 0x0014: addi x3, x3, 4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000018)
        $expect_reg(4d3, 32h00000050)
        // 0x0018: addi x4, x4, -1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000001C)
        $expect_reg(4d4, 32h00000003)
        // 0x001c: bne x4, x0, sum
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000000C)
        // 0x000c: lw x6, 0(x3)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000010)
        $expect_reg(4d6, 32h00000010)
        // 0x0010: add x5, x5, x6
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000014)
        $expect_reg(4d5, 32h00000011)
        // 0x0014: addi x3, x3, 4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000018)
        $expect_reg(4d3, 32h00000054)
        // 0x0018: addi x4, x4, -1
