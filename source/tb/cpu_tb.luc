        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000007C)
        $expect_reg(4d11, 32h0000000B)
        // 0x007c: beq x11, x15, irq_timer
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000080)
        // 0x0080: lw x10, 0(x2)
