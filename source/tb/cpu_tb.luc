testbench cpu_board_sw0_tb {
    sig clk
    sig rst
    sig sel[4]
    sig switches[8]

    computer dut(#PROGRAM_ID(Programs.Id.BOARD), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(clk), .io_rst(rst), .switches(switches),
                 .debug_sel(sel))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory
    fun tick_clock() {
        clk = 1
        $silent_tick()
        clk = 0
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    test run {
        clk = 0
        sel = 0
        switches = 8h00
        rst = 1
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // 0x0000: lui x2, 0x80001
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000004)
        $expect_reg(4d2, 32h80001000)
        // 0x0004: lw x3, 0(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000008)
        $expect_reg(4d3, 32h00000000)
        // 0x0008: andi x3, x3, 3
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000000C)
        $expect_reg(4d3, 32h00000000)
        // 0x000c: slli x3, x3, 2
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000010)
        $expect_reg(4d3, 32h00000000)
        // 0x0010: lw x4, menu(x3)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000014)
        $expect_reg(4d4, 32h0000007C)
        // 0x0014: jalr x0, x4, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000007C)
        $expect_reg(4d0, 32h00000000)
        // 0x007c: jal x1, right
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000048)
        $expect_reg(4d1, 32h00000080)
        // 0x0048: srli x1, x1, 1
        $tick_clock()
