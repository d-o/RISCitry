        // 0x0378: add x8, x8, x4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000037C)
        $expect_reg(4d8, 32h00000000)
        // 0x037c: sw x8, 12(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000380)
        $expect_display(33h000000000)
        // 0x0380: sw x5, 8(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000384)
        $expect_display(33h000000000)
        // 0x0384: mret
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000033C)
        // 0x033c: jal x0, idle
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        buttons = 4h4   // button event
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000338)
        $expect_reg(4d0, 32h00000000)
