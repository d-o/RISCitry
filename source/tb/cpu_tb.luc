        // 0x0064: csrrs x15, 0x300
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000068)
        $expect_reg(4d15, 32h00001880)
        // 0x0068: addi x14, x14, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000006C)
        $expect_reg(4d14, 32h00000006)
        // 0x006c: csrrs x11, 0x341
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000070)
        $expect_reg(4d11, 32h00000030)
        // 0x0070: addi x11, x11, 4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000074)
        $expect_reg(4d11, 32h00000034)
        // 0x0074: csrrw x0, 0x341
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000078)
        $expect_reg(4d0, 32h00000000)
        // 0x0078: mret
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000034)
        // 0x0034: lw x8, 0x400(x0)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000038)
        $expect_reg(4d8, 32h00000055)
        // 0x0038: addi x9, x0, land
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000003C)
        $expect_reg(4d9, 32h00000050)
        // 0x003c: addi x9, x9, 2
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000040)
        $expect_reg(4d9, 32h00000052)
        // 0x0040: jalr x1, x9, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000005C)
        // 0x005c: csrrs x13, 0x342
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000060)
        $expect_reg(4d13, 32h00000000)
        // 0x0060: csrrs x12, 0x343
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000064)
        $expect_reg(4d12, 32h00000052)
        // 0x0064: csrrs x15, 0x300
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000068)
        $expect_reg(4d15, 32h00001880)
        // 0x0068: addi x14, x14, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000006C)
        $expect_reg(4d14, 32h00000007)
        // 0x006c: csrrs x11, 0x341
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000070)
        $expect_reg(4d11, 32h00000040)
        // 0x0070: addi x11, x11, 4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000074)
        $expect_reg(4d11, 32h00000044)
        // 0x0074: csrrw x0, 0x341
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000078)
        $expect_reg(4d0, 32h00000000)
        // 0x0078: mret
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000044)
        // 0x0044: addi x9, x9, -1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000048)
        $expect_reg(4d9, 32h00000051)
        // 0x0048: jalr x1, x9, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000050)
        $expect_reg(4d1, 32h0000004C)
        // 0x0050: .word 0x00000363
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000005C)
        // 0x005c: csrrs x13, 0x342
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000060)
        $expect_reg(4d13, 32h00000000)
        // 0x0060: csrrs x12, 0x343
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000064)
        $expect_reg(4d12, 32h00000056)
        // 0x0064: csrrs x15, 0x300
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000068)
        $expect_reg(4d15, 32h00001880)
        // 0x0068: addi x14, x14, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000006C)
        $expect_reg(4d14, 32h00000008)
        // 0x006c: csrrs x11, 0x341
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000070)
        $expect_reg(4d11, 32h00000050)
        // 0x0070: addi x11, x11, 4
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000074)
        $expect_reg(4d11, 32h00000054)
        // 0x0074: csrrw x0, 0x341
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000078)
        $expect_reg(4d0, 32h00000000)
        // 0x0078: mret
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000054)
        // 0x0054: .word 0x00001363
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000058)
        // 0x0058: halt
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000058)
        $expect_reg(4d0, 32h00000000)
        // 0x0058: halt
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000058)
        $expect_reg(4d0, 32h00000000)
        // final register file and display
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h0000004C)
        $expect_reg(4d2, 32h00001888)
        $expect_reg(4d3, 32h0000005C)
        $expect_reg(4d4, 32h00000000)
        $expect_reg(4d5, 32h00000055)
        $expect_reg(4d6, 32h00000000)
        $expect_reg(4d7, 32h00000000)
        $expect_reg(4d8, 32h00000055)
        $expect_reg(4d9, 32h00000051)
        $expect_reg(4d10, 32h00000000)
        $expect_reg(4d11, 32h00000054)
        $expect_reg(4d12, 32h00000056)
        $expect_reg(4d13, 32h00000000)
        $expect_reg(4d14, 32h00000008)
        $expect_reg(4d15, 32h00001880)
        $expect_display(33h000000000)
        $expect_leds(0)
    }
}

testbench cpu_timer_tb {
    sig clk
    sig io_clk             // the UART's clock: same rate as clk, opposite phase (see tick_clock)
    sig rst
    sig sel[4]
    sig switches[8]
    sig buttons[4]
    sig plat_irq[2]        // platform interrupt lines (the UART's receiver is ORed into line 0)
    sig rx_line            // the serial line into the UART's receiver
    sig ce                 // the computer's clock enable

    computer dut(#PROGRAM_ID(Programs.Id.TIMER), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(io_clk), .io_rst(rst), .switches(switches),
                 .buttons(buttons), .plat_irq(plat_irq), .uart_rx(rx_line), .ce(ce),
                 .debug_sel(sel))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory.
    // io_clk rises when clk falls: on the board the two clocks are unrelated, and edges at the
    // same instant in two domains are where this simulator's update order bites (one byte in
    // most runs of the long printing tests was sent twice with io_clk = clk)
    fun tick_clock() {
        clk = 1
        io_clk = 0
        $silent_tick()
        clk = 0
        io_clk = 1
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
        $assert(!dut.sleeping || dut.debug_state == Cpu.State.EXECUTE)   // only a waiting WFI sleeps
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    fun expect_display(value[33]) {   // owned, the four characters
        if (c{dut.display_owned, dut.display_chars} != value)
            $print("display: got %h want %h", c{dut.display_owned, dut.display_chars}, value)
        $assert(c{dut.display_owned, dut.display_chars} == value)
    }

    fun expect_leds_dark() {          // the LED dimmer bank is dark unless a program enabled it (print tests stop at a byte count)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    fun expect_leds(enabled) {        // the LED dimmer bank: enabled as rv32sim has it, dark when it is not
        if (dut.leds_enabled != enabled || (!dut.leds_enabled && dut.leds != 0))
            $print("leds: enabled %d want %d, leds %h", dut.leds_enabled, enabled, dut.leds)
        $assert(dut.leds_enabled == enabled)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    test run {
        clk = 0
        io_clk = 0
        sel = 0
        switches = 8h00
        buttons = 0
        plat_irq = 0
        rx_line = 1
        ce = 1
        rst = 1
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // 0x0000: addi x3, x0, timer_handler
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000004)
        $expect_reg(4d3, 32h00000090)
        // 0x0004: csrrw x0, 0x305
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000008)
        $expect_reg(4d0, 32h00000000)
        // 0x0008: lui x2, 0x80002
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000000C)
        $expect_reg(4d2, 32h80002000)
        // 0x000c: lw x3, 16(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000010)
        $expect_reg(4d3, 32h00000001)
        // 0x0010: lw x4, 0(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000014)
        $expect_reg(4d4, 32h0000000C)
        // 0x0014: lw x5, 4(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000018)
        $expect_reg(4d5, 32h00000000)
        // 0x0018: lw x6, 8(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000001C)
        $expect_reg(4d6, 32hFFFFFFFF)
        // 0x001c: csrrs x7, 0x344
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000020)
        $expect_reg(4d7, 32h00000000)
        // 0x0020: addi x8, x0, -16
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000024)
        $expect_reg(4d8, 32hFFFFFFF0)
        // 0x0024: sw x8, 0(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000028)
        $expect_display(33h000000000)
        // 0x0028: lw x9, 4(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000002C)
        $expect_reg(4d9, 32h00000000)
        // 0x002c: addi x0, x0, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000030)
        $expect_reg(4d0, 32h00000000)
        // 0x0030: addi x0, x0, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000034)
        $expect_reg(4d0, 32h00000000)
        // 0x0034: addi x0, x0, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000038)
        $expect_reg(4d0, 32h00000000)
        // 0x0038: addi x0, x0, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000003C)
        $expect_reg(4d0, 32h00000000)
        // 0x003c: addi x0, x0, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000040)
        $expect_reg(4d0, 32h00000000)
        // 0x0040: addi x0, x0, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000044)
        $expect_reg(4d0, 32h00000000)
        // 0x0044: lw x9, 4(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
