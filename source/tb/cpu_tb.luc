        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000003EC)
        // 0x03ec: addi x12, x12, 1
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000003F0)
        $expect_reg(4d12, 32h0000050E)
        // 0x03f0: lbu x4, 3(x12)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000003F4)
        $expect_reg(4d4, 32h00000056)
        // 0x03f4: bne x4, x0, scroll_show
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h000003FC)
        // 0x03fc: jal x6, show
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000404)
        $expect_reg(4d6, 32h00000400)
        // 0x0404: lbu x4, 0(x12)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000408)
        $expect_reg(4d4, 32h0000004E)
        // final register file and display
        $expect_reg(4d0, 32h00000000)
        $expect_reg(4d1, 32h00000000)
        $expect_reg(4d2, 32h80002000)
        $expect_reg(4d3, 32h80004000)
        $expect_reg(4d4, 32h0000004E)
        $expect_reg(4d5, 32h0000084B)
        $expect_reg(4d6, 32h00000400)
        $expect_reg(4d7, 32h000000CB)
        $expect_reg(4d8, 32h00000000)
        $expect_reg(4d9, 32h00000080)
        $expect_reg(4d10, 32h00000000)
        $expect_reg(4d11, 32h00000000)
        $expect_reg(4d12, 32h0000050E)
        $expect_reg(4d13, 32h00000000)
        $expect_reg(4d14, 32h00000000)
        $expect_reg(4d15, 32h00000000)
        $expect_display(33h152204E41)
        $expect_leds(0)
    }
}

testbench cpu_board_sw7_tb {
    sig clk
    sig io_clk             // the UART's clock: same rate as clk, opposite phase (see tick_clock)
    sig rst
    sig sel[4]
    sig switches[8]
    sig buttons[4]
    sig plat_irq[2]        // platform interrupt lines (the UART's receiver is ORed into line 0)
    sig rx_line            // the serial line into the UART's receiver
    sig ce                 // the computer's clock enable
    sig received[8]
    sig expected[25][8]
    sig clock_count[32]

    computer dut(#PROGRAM_ID(Programs.Id.BOARD), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(io_clk), .io_rst(rst), .switches(switches),
                 .buttons(buttons), .plat_irq(plat_irq), .uart_rx(rx_line), .ce(ce),
                 .debug_sel(sel))
    uart_rx rx(#CLK_FREQ(8), #BAUD(1), .clk(clk), .rst(rst), .rx(dut.uart_tx))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory.
    // io_clk rises when clk falls: on the board the two clocks are unrelated, and edges at the
    // same instant in two domains are where this simulator's update order bites (one byte in
    // most runs of the long printing tests was sent twice with io_clk = clk)
    fun tick_clock() {
        clk = 1
        io_clk = 0
        $silent_tick()
        clk = 0
        io_clk = 1
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
        $assert(!dut.sleeping || dut.debug_state == Cpu.State.EXECUTE)   // only a waiting WFI sleeps
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    fun expect_display(value[33]) {   // owned, the four characters
        if (c{dut.display_owned, dut.display_chars} != value)
            $print("display: got %h want %h", c{dut.display_owned, dut.display_chars}, value)
        $assert(c{dut.display_owned, dut.display_chars} == value)
    }

    fun expect_leds_dark() {          // the LED dimmer bank is dark unless a program enabled it (print tests stop at a byte count)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    fun expect_leds(enabled) {        // the LED dimmer bank: enabled as rv32sim has it, dark when it is not
        if (dut.leds_enabled != enabled || (!dut.leds_enabled && dut.leds != 0))
            $print("leds: enabled %d want %d, leds %h", dut.leds_enabled, enabled, dut.leds)
        $assert(dut.leds_enabled == enabled)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    test run {
        clk = 0
        io_clk = 0
        sel = 0
        switches = 8h07
        buttons = 0
        plat_irq = 0
        rx_line = 1
        ce = 1
        rst = 1
        received = 0
        clock_count = 0
        expected = {8h0A, 8h0D, 8h32, 8h72, 8h20, 8h34, 8h31, 8h20, 8h32, 8h34, 8h0A, 8h0D, 8h21, 8h43, 8h20, 8h6D, 8h6F, 8h72, 8h66, 8h20, 8h6F, 8h6C, 8h6C, 8h65, 8h48}   // "Hello from C!\x0d\x0a42 14 r2\x0d\x0a"
        // hold reset for an extra bit time: uart_tx's output register has no reset and starts
        // low for two clocks, and uart_rx's 3-deep input buffer (not reset either) would
        // take that for a start bit unless the idle-high line has filled it first
        repeat(i, 8) {
            $tick_clock()
        }
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // run until the first 25 bytes have been received (at most 8988 clocks)
        repeat(i, 8988) {
            if (received != 25) {
                if (clock_count == 100) buttons = 4h4;   // button event
                if (clock_count == 110) buttons = 4h0;   // button event
                if (clock_count == 140) buttons = 4h4;   // button event
                if (clock_count == 150) buttons = 4h0;   // button event
                if (clock_count == 3000) buttons = 4h9;   // button event
                if (clock_count == 3100) buttons = 4h0;   // button event
                $tick_clock()
                clock_count = clock_count + 1
                if (rx.new_data) {
                    $assert(received < 25)
                    if (rx.data != expected[received])
                        $print("byte %d: got %h want %h", received, rx.data, expected[received])
                    $assert(rx.data == expected[received])
                    received = received + 1
                }
            }
        }
        if (received != 25)
            $print("received %d of 25 bytes", received)
        $assert(received == 25)
        $expect_leds_dark()
    }
}

testbench cpu_board_sw15_tb {
    sig clk
    sig io_clk             // the UART's clock: same rate as clk, opposite phase (see tick_clock)
    sig rst
    sig sel[4]
    sig switches[8]
    sig buttons[4]
    sig plat_irq[2]        // platform interrupt lines (the UART's receiver is ORed into line 0)
    sig rx_line            // the serial line into the UART's receiver
    sig ce                 // the computer's clock enable

    computer dut(#PROGRAM_ID(Programs.Id.BOARD), #SIM_RAM(1), #UART_CLK_FREQ(8), #UART_BAUD(1),
                 .clk(clk), .rst(rst), .io_clk(io_clk), .io_rst(rst), .switches(switches),
                 .buttons(buttons), .plat_irq(plat_irq), .uart_rx(rx_line), .ce(ce),
                 .debug_sel(sel))

    // silent: the simulator keeps every $tick()'s whole-design state (the RAM model included)
    // for its waveform view, and across the suite that exhausts its memory.
    // io_clk rises when clk falls: on the board the two clocks are unrelated, and edges at the
    // same instant in two domains are where this simulator's update order bites (one byte in
    // most runs of the long printing tests was sent twice with io_clk = clk)
    fun tick_clock() {
        clk = 1
        io_clk = 0
        $silent_tick()
        clk = 0
        io_clk = 1
        $silent_tick()
    }

    fun expect_pc(pc[32]) {
        if (dut.debug_pc != pc)
            $print("pc: got %h want %h", dut.debug_pc, pc)
        $assert(dut.debug_pc == pc)
        $assert(dut.uart_tx)       // idle high unless the program prints
    }

    fun expect_state(state[Cpu.STATE_BITS]) {
        if (dut.debug_state != state)
            $print("state: got %d want %d", dut.debug_state, state)
        $assert(dut.debug_state == state)
        $assert(!dut.sleeping || dut.debug_state == Cpu.State.EXECUTE)   // only a waiting WFI sleeps
    }

    fun expect_reg(r[4], value[32]) {
        sel = r
        $silent_tick()
        if (dut.debug_reg != value)
            $print("x%d: got %h want %h", r, dut.debug_reg, value)
        $assert(dut.debug_reg == value)
    }

    fun expect_display(value[33]) {   // owned, the four characters
        if (c{dut.display_owned, dut.display_chars} != value)
            $print("display: got %h want %h", c{dut.display_owned, dut.display_chars}, value)
        $assert(c{dut.display_owned, dut.display_chars} == value)
    }

    fun expect_leds_dark() {          // the LED dimmer bank is dark unless a program enabled it (print tests stop at a byte count)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    fun expect_leds(enabled) {        // the LED dimmer bank: enabled as rv32sim has it, dark when it is not
        if (dut.leds_enabled != enabled || (!dut.leds_enabled && dut.leds != 0))
            $print("leds: enabled %d want %d, leds %h", dut.leds_enabled, enabled, dut.leds)
        $assert(dut.leds_enabled == enabled)
        $assert(dut.leds_enabled || dut.leds == 0)
    }

    test run {
        clk = 0
        io_clk = 0
        sel = 0
        switches = 8h0F
        buttons = 0
        plat_irq = 0
        rx_line = 1
        ce = 1
        rst = 1
        $tick_clock()
        $tick_clock()
        rst = 0
        $expect_pc(32h00000000)
        // 0x0000: lui x2, 0x80001
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000004)
        $expect_reg(4d2, 32h80001000)
        // 0x0004: lw x3, 0(x2)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000008)
        $expect_reg(4d3, 32h0000000F)
        // 0x0008: andi x3, x3, 7
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h0000000C)
        $expect_reg(4d3, 32h00000007)
        // 0x000c: slli x3, x3, 2
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000010)
        $expect_reg(4d3, 32h0000001C)
        // 0x0010: lw x4, menu(x3)
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.MEM_ACCESS)
        $tick_clock()
        $expect_state(Cpu.State.WRITEBACK)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000014)
        $expect_reg(4d4, 32h00000800)
        // 0x0014: jalr x0, x4, 0
        $tick_clock()
        $expect_state(Cpu.State.EXECUTE)
        $tick_clock()
        $expect_state(Cpu.State.FETCH)
        $expect_pc(32h00000800)
        $expect_reg(4d0, 32h00000000)
