// GENERATED by tools/gen_main_ram_tb.py from tools/programs.py. Do not edit; rerun the script.

testbench main_ram_tb {
    sig clk
    sig raddr[6]
    sig waddr[6]
    sig wdata[32]
    sig be[4]

    main_ram dut(#WORDS(64), #PROGRAM_ID(Programs.Id.LARSON), #SIM_MODEL(1),
                 .clk(clk), .raddr(raddr), .waddr(waddr), .wdata(wdata), .be(be))

    // settle first: inputs changed in the same step as the rising edge would be missed
    fun tick_clock() {
        $silent_tick()
        clk = 1
        $silent_tick()
        clk = 0
        $tick()
    }

    // present addr on the read port for one clock, then check what comes back
    fun expect_word(addr[6], value[32]) {
        raddr = addr
        $tick_clock()
        if (dut.rdata != value)
            $print("word %d: got %h want %h", addr, dut.rdata, value)
        $assert(dut.rdata == value)
    }

    test run {
        clk = 0
        raddr = 0
        waddr = 0
        wdata = 0
        be = 0
        // the LARSON image, then 0 past its end
        $expect_word(0, 32h07C0006F)
        $expect_word(1, 32h00000013)
        $expect_word(2, 32h00000013)
        $expect_word(3, 32h00000013)
        $expect_word(4, 32h00000013)
        $expect_word(5, 32h00000013)
        $expect_word(6, 32h00000013)
        $expect_word(7, 32h00000013)
        $expect_word(8, 32h00000013)
        $expect_word(9, 32h00000013)
        $expect_word(10, 32h00000013)
        $expect_word(11, 32h00000013)
        $expect_word(12, 32h00000013)
        $expect_word(13, 32h00000013)
        $expect_word(14, 32h00000013)
        $expect_word(15, 32h00000013)
        $expect_word(16, 32h00000013)
        $expect_word(17, 32h00000013)
        $expect_word(18, 32h0010D093)
        $expect_word(19, 32h0010D093)
        $expect_word(20, 32h0010D093)
        $expect_word(21, 32h0010D093)
        $expect_word(22, 32h0010D093)
        $expect_word(23, 32h0010D093)
        $expect_word(24, 32h0010D093)
        $expect_word(25, 32h00109093)
        $expect_word(26, 32h00109093)
        $expect_word(27, 32h00109093)
        $expect_word(28, 32h00109093)
        $expect_word(29, 32h00109093)
        $expect_word(30, 32h00109093)
        $expect_word(31, 32hFCDFF0EF)
        $expect_word(32, 32h00000000)
        $expect_word(33, 32h00000000)
        $expect_word(34, 32h00000000)
        // a whole word past the program
        waddr = 37
        wdata = 32hCAFEF00D
        be = 4b1111
        $tick_clock()
        be = 0
        $expect_word(37, 32hCAFEF00D)
        // lane 1 only, inside the program: the other lanes keep the image
        waddr = 1
        wdata = 32hAABBCCDD
        be = 4b0010
        $tick_clock()
        be = 0
        $expect_word(1, 32h0000CC13)
        $expect_word(2, 32h00000013)
        waddr = 1
        wdata = 32h11223344
        be = 4b1000
        $tick_clock()
        be = 0
        $expect_word(1, 32h1100CC13)
        // read and write word 5 in the same edge: the old word comes back, then the new
        raddr = 5
        waddr = 5
        wdata = 32h12345678
        be = 4b1111
        $tick_clock()
        be = 0
        if (dut.rdata != 32h00000013)
            $print("read during write: got %h want old %h", dut.rdata, 32h00000013)
        $assert(dut.rdata == 32h00000013)
        $expect_word(5, 32h12345678)
        // independent ports: write one word while reading another
        raddr = 3
        waddr = 63
        wdata = 32h0BADF00D
        be = 4b1111
        $tick_clock()
        be = 0
        $assert(dut.rdata == 32h00000013)
        $expect_word(63, 32h0BADF00D)
        $expect_word(3, 32h00000013)
    }
}

testbench main_ram_full_tb {
    sig clk
    sig raddr[11]
    sig waddr[11]
    sig wdata[32]
    sig be[4]

    main_ram dut(#WORDS(2048), #PROGRAM_ID(Programs.Id.LARSON), #SIM_MODEL(1),
                 .clk(clk), .raddr(raddr), .waddr(waddr), .wdata(wdata), .be(be))

    // settle first: inputs changed in the same step as the rising edge would be missed
    fun tick_clock() {
        $silent_tick()
        clk = 1
        $silent_tick()
        clk = 0
        $tick()
    }

    // present addr on the read port for one clock, then check what comes back
    fun expect_word(addr[11], value[32]) {
        raddr = addr
        $tick_clock()
        if (dut.rdata != value)
            $print("word %d: got %h want %h", addr, dut.rdata, value)
        $assert(dut.rdata == value)
    }

    test run {
        clk = 0
        raddr = 0
        waddr = 0
        wdata = 0
        be = 0
        // full size: the image's first and last words, then the top word
        $expect_word(0, 32h07C0006F)
        $expect_word(31, 32hFCDFF0EF)
        $expect_word(2047, 32h00000000)
        waddr = 2047
        wdata = 32h600DCAFE
        be = 4b1111
        $tick_clock()
        be = 0
        $expect_word(2047, 32h600DCAFE)
        $expect_word(0, 32h07C0006F)
    }
}
